{
  "_readme": "将此文件复制为 appsettings.json 后填入真实配置。ApiKey 也可通过环境变量 OptiRouter__Models__0__ApiKey=sk-xxx 覆盖。",
  "OptiRouter": {
    "_comment_proxy_security": "入站 /v1/* Bearer 密钥与按来源 IP 的每分钟请求上限。ProxyApiKey 为空时拒绝所有 /v1/* 请求。",
    "ProxyApiKey": "",
    "RequestsPerMinute": 60,
    "MaxConcurrentRequestsPerPartition": 100,
    "_comment_models": "模型端点列表，至少需要一个 Enabled=true 的模型。",
    "Models": [
      {
        "_comment_model_0": "Strong tier：适合复杂代码/长上下文任务。",
        "Name": "gpt-4o",
        "BaseUrl": "https://api.openai.com/v1",
        "ApiKey": "${OPENAI_API_KEY}",
        "Tier": "Strong",
        "MaxContextTokens": 128000,
        "InputPricePerMillion": 2.5,
        "OutputPricePerMillion": 10.0,
        "TimeoutSeconds": 120,
        "MaxRetries": 0,
        "Enabled": true,
        "Tags": [ "vision", "tool-use" ]
      },
      {
        "_comment_model_1": "Medium tier：通用默认档。",
        "Name": "deepseek-chat",
        "BaseUrl": "https://api.deepseek.com/v1",
        "ApiKey": "${DEEPSEEK_API_KEY}",
        "Tier": "Medium",
        "MaxContextTokens": 64000,
        "InputPricePerMillion": 0.14,
        "OutputPricePerMillion": 0.28,
        "TimeoutSeconds": 120,
        "MaxRetries": 0,
        "Enabled": true,
        "Tags": [ "tool-use" ]
      },
      {
        "_comment_model_2": "Cheap tier：简单问答/低成本兜底。",
        "Name": "qwen-turbo",
        "BaseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "ApiKey": "${DASHSCOPE_API_KEY}",
        "Tier": "Cheap",
        "MaxContextTokens": 8000,
        "InputPricePerMillion": 0.05,
        "OutputPricePerMillion": 0.2,
        "TimeoutSeconds": 120,
        "MaxRetries": 0,
        "Enabled": true,
        "Tags": []
      }
    ],
    "_comment_budget": "日预算与预算耗尽行为。UsePersistentStore=true 时成本账本落 SQLite，跨重启保留；false 用内存（重启归零）。",
    "Budget": {
      "DailyBudgetUsd": 10.0,
      "SessionBudgetUsd": null,
      "EnforceOnExhausted": "Degrade",
      "UsePersistentStore": true,
      "StorePath": "data/optirouter-budget.db",
      "SessionEvictionHours": 24
    },
    "_comment_routing": "路由策略四开关及通用参数。TokenEstimation=Tiktoken 时用真实 BPE 精确计数（SharpToken 内置词表、离线可用，异常自动回退分桶粗估）；=Bucket 时用分桶粗估。",
    "Routing": {
      "EnableRuleClassifier": true,
      "EnableTokenEstimator": true,
      "EnableBudgetGuard": true,
      "EnableFailover": true,
      "LongInputThresholdTokens": 32000,
      "DefaultTier": "Medium",
      "TokenEstimation": "Tiktoken",
      "TiktokenEncoding": "o200k_base",
      "FailoverFailureThreshold": 3,
      "FailoverCooldownSeconds": 60,
      "_comment_failover_halfopen": "熔断冷却到期后进入半开态，最多放行这么多并发探测请求；探测成功闭合熔断，失败重新冷却。",
      "FailoverHalfOpenMaxProbes": 1,
      "_comment_failover_required_successes": "半开态连续探测成功多少次后才闭合熔断。默认 1；调高（如 3）防单次偶然成功导致抖动。",
      "FailoverHalfOpenRequiredSuccesses": 1,
      "_comment_health_probe": "后台主动探活。启动预热一轮后按间隔周期探测所有启用模型，结果上报断路器。",
      "EnableHealthProbe": true,
      "HealthProbeIntervalSeconds": 60,
      "_comment_semantic": "向量空间语义路由（离线词袋模型）。对最近 user 消息算余弦相似度，命中阈值则覆盖候选为目标 TargetTier。配置变更热生效。",
      "EnableSemanticRouter": true,
      "SemanticSimilarityThreshold": 0.25,
      "SemanticRoutes": [
        {
          "Name": "code-assistance",
          "TargetTier": "Strong",
          "Phrases": [
            "write a python function to compute fibonacci",
            "implement binary search in rust",
            "compile build fix runtime exception stacktrace"
          ]
        },
        {
          "Name": "casual-chit-chat",
          "TargetTier": "Cheap",
          "Phrases": [
            "how is the weather today",
            "tell me a funny story",
            "hello who are you"
          ]
        }
      ],
      "_comment_max_stream_bytes": "流式响应累计字节硬上限，防 OOM/恶意无限流输出。默认 20MB。",
      "MaxResponseStreamBytes": 20971520
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
