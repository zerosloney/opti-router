@page "/models"
@inject ApiService Api
@implements IDisposable

<PageTitle>OptiRouter - 模型配置</PageTitle>

<div class="models-page">
    <!-- Banner -->
    <div class="alert-banner alert-info">
        <span class="indicator pulse"></span>
        <span>模型配置页。增删改与连通性探活即时写入 models-config.json 并热生效。</span>
    </div>

    <div class="glass-card">
        <div class="card-header-row">
            <div class="card-label">模型配置</div>
            <button class="btn-primary" @onclick="ToggleAddForm">
                @(ShowAddForm ? "- 取消添加" : "+ 添加模型")
            </button>
        </div>

        <!-- 添加表单 -->
        @if (ShowAddForm)
        {
            <div class="add-form">
                <div style="margin-bottom: 1rem; font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                    <span class="text-secondary" style="font-size: 0.82rem;">⚡ 预设模板：</span>
                    <button class="btn-ghost btn-sm" @onclick='() => ApplyPreset("openai")'>GPT-4o (OpenAI)</button>
                    <button class="btn-ghost btn-sm" @onclick='() => ApplyPreset("deepseek")'>DeepSeek-V3</button>
                    <button class="btn-ghost btn-sm" @onclick='() => ApplyPreset("claude")'>Claude 3.5 Sonnet</button>
                    <button class="btn-ghost btn-sm" @onclick='() => ApplyPreset("qwen")'>Qwen-Max (通义)</button>
                    <button class="btn-ghost btn-sm" @onclick='() => ApplyPreset("ollama")'>Ollama (本地端侧)</button>
                </div>
                <div class="form-grid">
                    <div class="form-field full">
                        <label for="nm-name">名称 *</label>
                        <input type="text" id="nm-name" @bind="NewModel.Name" placeholder="如 gpt-4o / deepseek-chat" />
                    </div>
                    <div class="form-field full">
                        <label for="nm-baseurl">BaseUrl *</label>
                        <input type="text" id="nm-baseurl" @bind="NewModel.BaseUrl" placeholder="https://api.openai.com/v1" />
                    </div>
                    <div class="form-field full">
                        <label for="nm-apikey">ApiKey</label>
                        <input type="password" id="nm-apikey" @bind="NewModel.ApiKey" placeholder="sk-..." />
                    </div>
                    <div class="form-field">
                        <label for="nm-tier">Tier</label>
                        <select id="nm-tier" @bind="NewModel.Tier">
                            <option value="Strong">Strong</option>
                            <option value="Medium">Medium</option>
                            <option value="Cheap">Cheap</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label for="nm-provider">Provider</label>
                        <input type="text" id="nm-provider" @bind="NewModel.Provider" placeholder="如 openai / deepseek" />
                    </div>
                    <div class="form-field">
                        <label for="nm-family">Family</label>
                        <input type="text" id="nm-family" @bind="NewModel.Family" placeholder="如 gpt-4o / deepseek-v3" />
                    </div>
                    <div class="form-field">
                        <label for="nm-ctx">最大上下文 Token</label>
                        <input type="number" id="nm-ctx" @bind="NewModel.MaxContextTokens" min="1" />
                    </div>
                    <div class="form-field">
                        <label for="nm-timeout">超时（秒）</label>
                        <input type="number" id="nm-timeout" @bind="NewModel.TimeoutSeconds" min="1" />
                    </div>
                    <div class="form-field">
                        <label for="nm-retries">最大重试次数</label>
                        <input type="number" id="nm-retries" @bind="NewModel.MaxRetries" min="0" />
                    </div>
                    <div class="form-field">
                        <label for="nm-inprice">输入价格 $/M</label>
                        <input type="number" id="nm-inprice" @bind="NewModel.InputPricePerMillion" min="0" step="0.001" />
                    </div>
                    <div class="form-field">
                        <label for="nm-outprice">输出价格 $/M</label>
                        <input type="number" id="nm-outprice" @bind="NewModel.OutputPricePerMillion" min="0" step="0.001" />
                    </div>
                    <div class="form-field">
                        <label for="nm-enabled">启用</label>
                        <select id="nm-enabled" @bind="NewModel.EnabledStr">
                            <option value="true">是</option>
                            <option value="false">否</option>
                        </select>
                    </div>
                    <div class="form-field" style="display: flex; align-items: center; gap: 8px; margin-top: 24px;">
                        <input type="checkbox" id="cbLocal" @bind="NewModel.IsLocalOrPrivate" />
                        <label for="cbLocal" style="cursor: pointer; margin: 0; color: var(--info-text); font-weight: bold;">🏠 私有/本地部署节点 (数据不出域)</label>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(ErrorMsg))
                {
                    <div class="form-error">@ErrorMsg</div>
                }
                <div class="form-actions" style="margin-top: 14px;">
                    <button class="btn-ghost" @onclick="ToggleAddForm">取消</button>
                    <button class="btn-primary" @onclick="SubmitAdd">确认添加</button>
                </div>
            </div>
        }

        <!-- 模型列表 -->
        <div class="table-wrap">
            <table class="config-table">
                <thead>
                    <tr>
                        <th scope="col">名称</th><th scope="col">BaseUrl</th><th scope="col">ApiKey</th><th scope="col">Tier</th><th scope="col">Provider</th><th scope="col">Family</th><th scope="col">上下文</th>
                        <th scope="col">超时</th><th scope="col">重试</th><th scope="col">属性</th><th scope="col">启用</th><th scope="col">输入$/M</th><th scope="col">输出$/M</th><th scope="col">连通状态</th><th scope="col">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!ModelList.Any())
                    {
                        <tr><td colspan="15" class="text-center text-secondary">暂无模型配置，点击上方"+ 添加模型"开始添加。</td></tr>
                    }
                    else
                    {
                        @foreach (var m in ModelList)
                        {
                            @if (EditingName == m.Name)
                            {
                                <!-- 内联编辑行 -->
                                <tr class="editing-row">
                                    <td><strong>@m.Name</strong></td>
                                    <td><input type="text" @bind="EditModel.BaseUrl" /></td>
                                    <td><input type="password" @bind="EditModel.ApiKey" placeholder="(不变更则留空)" /></td>
                                    <td>
                                        <select @bind="EditModel.Tier">
                                            <option value="Strong">Strong</option>
                                            <option value="Medium">Medium</option>
                                            <option value="Cheap">Cheap</option>
                                        </select>
                                    </td>
                                    <td><input type="text" @bind="EditModel.Provider" /></td>
                                    <td><input type="text" @bind="EditModel.Family" /></td>
                                    <td><input type="number" @bind="EditModel.MaxContextTokens" min="1" /></td>
                                    <td><input type="number" @bind="EditModel.TimeoutSeconds" min="1" /></td>
                                    <td><input type="number" @bind="EditModel.MaxRetries" min="0" /></td>
                                    <td>
                                        <label style="font-size: 0.75rem;"><input type="checkbox" @bind="EditModel.IsLocalOrPrivate" /> 本地</label>
                                    </td>
                                    <td>
                                        <select @bind="EditModel.EnabledStr">
                                            <option value="true">是</option>
                                            <option value="false">否</option>
                                        </select>
                                    </td>
                                    <td><input type="number" @bind="EditModel.InputPricePerMillion" step="0.001" /></td>
                                    <td><input type="number" @bind="EditModel.OutputPricePerMillion" step="0.001" /></td>
                                    <td>-</td>
                                    <td>
                                        <button class="btn-primary btn-sm" @onclick="() => SubmitEdit(m.Name)">保存</button>
                                        <button class="btn-ghost btn-sm" @onclick="CancelEdit">取消</button>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td><strong>@m.Name</strong></td>
                                    <td title="@m.BaseUrl">@Truncate(m.BaseUrl, 22)</td>
                                    <td>@(m.HasApiKey ? (MarkupString)"••••••" : (MarkupString)"<span class='text-danger'>未配置</span>")</td>
                                    <td><span class="badge badge-info">@m.Tier</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(m.Provider) ? "-" : m.Provider)</td>
                                    <td>@(string.IsNullOrWhiteSpace(m.Family) ? "-" : m.Family)</td>
                                    <td>@(m.MaxContextTokens / 1000)K</td>
                                    <td>@m.TimeoutSeconds s</td>
                                    <td>@m.MaxRetries</td>
                                    <td>
                                        @if (m.IsLocalOrPrivate)
                                        {
                                            <span class="tag tag-success" style="font-size: 0.75rem;">🏠 本地/私有</span>
                                        }
                                        else
                                        {
                                            <span class="tag tag-secondary" style="font-size: 0.75rem;">☁️ 公有云</span>
                                        }
                                    </td>
                                    <td class="@(m.Enabled ? "text-success" : "text-secondary")">@(m.Enabled ? "是" : "否")</td>
                                    <td>$@m.InputPricePerMillion.ToString("F3")</td>
                                    <td>$@m.OutputPricePerMillion.ToString("F3")</td>
                                    <td>
                                        @if (ProbeResults.TryGetValue(m.Name, out var probe))
                                        {
                                            @if (probe.Success)
                                            {
                                                <span class="text-success" style="font-size: 0.8rem; font-weight: bold;">✓ @probe.LatencyMs ms</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger" style="font-size: 0.8rem; font-weight: bold;" title="@probe.Error">✗ 失败</span>
                                            }
                                        }
                                        else if (ProbingModels.Contains(m.Name))
                                        {
                                            <span style="color: var(--info-text); font-size: 0.8rem;">探测中...</span>
                                        }
                                        else
                                        {
                                            <span style="color: #64748b; font-size: 0.8rem;">未测试</span>
                                        }
                                    </td>
                                    <td style="display: flex; gap: 4px;">
                                        <button class="btn-ghost btn-sm" @onclick="() => ProbeConnection(m.Name)" title="测试端点 API 连通性与延迟">⚡ 探活</button>
                                        <button class="btn-primary btn-sm" @onclick="() => StartEdit(m)">编辑</button>
                                        <button class="btn-danger btn-sm" @onclick="() => Delete(m.Name)">删除</button>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 模型健康状态（熔断与运维控制） -->
    <div class="glass-card">
        <div class="card-header-row">
            <div class="card-label" style="margin: 0;">模型健康状态</div>
            <span class="tag tag-info" style="font-size: 0.75rem;">● 每 5 秒自动刷新</span>
        </div>
        @if (!string.IsNullOrEmpty(HealthError))
        {
            <div class="alert-banner alert-error" style="margin: 8px 0; padding: 6px 12px; font-size: 0.82rem;">⚠️ @HealthError（显示的是上一次成功数据）</div>
        }
        <div class="models-grid">
            @if (ModelHealth.Any())
            {
                @foreach (var m in ModelHealth)
                {
                    <div class="model-card state-@m.CircuitState.ToLower()">
                        <div class="card-header-row">
                            <div>
                                <div class="model-name">@m.Name</div>
                                <div class="model-tier">@m.Tier Tier</div>
                            </div>
                            <span class="badge badge-@CircuitBadge(m.CircuitState)">@CircuitText(m.CircuitState)</span>
                        </div>

                        <div class="metrics-row">
                            <div class="metric-item">
                                <span class="metric-label">失败次数</span>
                                <span class="metric-val @(m.FailureCount > 0 ? "text-danger" : "")">@m.FailureCount</span>
                            </div>
                            <div class="metric-item" style="text-align:center;">
                                <span class="metric-label">平均延迟</span>
                                <span class="metric-val @(m.LatencySamples > 0 ? "text-primary" : "")">@(m.LatencySamples > 0 ? $"{m.AvgLatencyMs:F0} ms" : "--")</span>
                            </div>
                            <div class="metric-item" style="text-align:center;">
                                <span class="metric-label">延迟样本</span>
                                <span class="metric-val">@m.LatencySamples</span>
                            </div>
                            <div class="metric-item" style="text-align:right;">
                                <span class="metric-label">活跃探测</span>
                                <span class="metric-val @(m.ActiveProbes > 0 ? "text-warning" : "")">@m.ActiveProbes</span>
                            </div>
                        </div>

                        <div style="display: flex; gap: 8px; justify-content: flex-end; margin-top: 10px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.06);">
                            <button class="btn-ghost btn-sm" @onclick='() => OverrideCircuit(m.Name, "Closed")' style="color: var(--ok-text); font-size: 0.75rem;" title="重置断路器为闭合正常状态">⚡ 恢复正常</button>
                            <button class="btn-ghost btn-sm" @onclick='() => OverrideCircuit(m.Name, "Open")' style="color: var(--danger-text); font-size: 0.75rem;" title="强制下线该端点进行运维隔离">🚫 强行隔离</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-secondary" style="padding: 20px;">加载中...</div>
            }
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(ToastMsg))
{
    <div class="toast-overlay">
        <div class="toast-content @(ToastIsError ? "toast-error" : "toast-success")">
            <span>@ToastMsg</span>
            <button @onclick="() => ToastMsg = null">&times;</button>
        </div>
    </div>
}

@code {
    private List<ApiService.ModelDto> ModelList = new();
    private bool ShowAddForm = false;
    private string? EditingName;
    private string? ErrorMsg;
    private string? ToastMsg;
    private bool ToastIsError = false;
    private Timer? _toastTimer;
    private HashSet<string> ProbingModels = new();
    private Dictionary<string, ApiService.ModelTestResultDto> ProbeResults = new();

    private NewModelForm NewModel = new();
    private EditModelForm EditModel = new();
    private List<ApiService.ModelInfo> ModelHealth = new();
    private PeriodicTimer? _healthTimer;
    private CancellationTokenSource _healthCts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadModels();
        await LoadModelHealth();

        _healthTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = PollHealthLoopAsync();
    }

    private async Task PollHealthLoopAsync()
    {
        try
        {
            while (await _healthTimer!.WaitForNextTickAsync(_healthCts.Token))
            {
                await LoadModelHealth();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { } // circuit 拆除后 dispatcher 失效，轮询自行退出
    }

    private async Task LoadModelHealth()
    {
        try
        {
            var metrics = await Api.GetMetricsAsync();
            if (metrics?.Models != null)
            {
                ModelHealth = metrics.Models.ToList();
                HealthError = null;
            }
        }
        catch (Exception ex)
        {
            // 轮询失败保留上一次数据，但持续显示错误提示（而非静默停留）
            HealthError = "健康状态刷新失败：" + ex.Message;
        }
    }

    private string? HealthError;

    private async Task OverrideCircuit(string modelName, string targetState)
    {
        var (ok, error) = await Api.OverrideCircuitStateAsync(modelName, targetState);
        if (ok)
        {
            Toast(targetState == "Open" ? $"模型 \"{modelName}\" 已强制隔离" : $"模型 \"{modelName}\" 已恢复正常");
            await LoadModelHealth();
        }
        else
        {
            Toast("熔断状态更新失败：" + (error ?? "未知错误"), true);
        }
    }

    private string CircuitBadge(string state) => state.ToLower() switch
    {
        "closed" => "success",
        "open" => "danger",
        "halfopen" => "warning",
        _ => "secondary"
    };

    private string CircuitText(string state) => state.ToLower() switch
    {
        "closed" => "正常 (Closed)",
        "open" => "熔断 (Open)",
        "halfopen" => "探测 (HalfOpen)",
        _ => state
    };

    private async Task LoadModels()
    {
        ModelList = await Api.GetModelsAsync() ?? new();
    }

    private void ApplyPreset(string presetKey)
    {
        switch (presetKey.ToLower())
        {
            case "openai":
                NewModel.Name = "gpt-4o";
                NewModel.BaseUrl = "https://api.openai.com/v1";
                NewModel.Tier = "Strong";
                NewModel.Provider = "openai";
                NewModel.Family = "gpt-4o";
                NewModel.MaxContextTokens = 128000;
                NewModel.InputPricePerMillion = 2.50m;
                NewModel.OutputPricePerMillion = 10.00m;
                NewModel.IsLocalOrPrivate = false;
                break;
            case "deepseek":
                NewModel.Name = "deepseek-chat";
                NewModel.BaseUrl = "https://api.deepseek.com/v1";
                NewModel.Tier = "Cheap";
                NewModel.Provider = "deepseek";
                NewModel.Family = "deepseek-v3";
                NewModel.MaxContextTokens = 64000;
                NewModel.InputPricePerMillion = 0.14m;
                NewModel.OutputPricePerMillion = 0.28m;
                NewModel.IsLocalOrPrivate = false;
                break;
            case "claude":
                NewModel.Name = "claude-3-5-sonnet-20241022";
                NewModel.BaseUrl = "https://api.anthropic.com/v1";
                NewModel.Tier = "Strong";
                NewModel.Provider = "anthropic";
                NewModel.Family = "claude";
                NewModel.MaxContextTokens = 200000;
                NewModel.InputPricePerMillion = 3.00m;
                NewModel.OutputPricePerMillion = 15.00m;
                NewModel.IsLocalOrPrivate = false;
                break;
            case "qwen":
                NewModel.Name = "qwen-max";
                NewModel.BaseUrl = "https://dashscope.aliyuncs.com/compatible-mode/v1";
                NewModel.Tier = "Medium";
                NewModel.Provider = "aliyun";
                NewModel.Family = "qwen";
                NewModel.MaxContextTokens = 32000;
                NewModel.InputPricePerMillion = 0.30m;
                NewModel.OutputPricePerMillion = 0.60m;
                NewModel.IsLocalOrPrivate = false;
                break;
            case "ollama":
                NewModel.Name = "llama3.2";
                NewModel.BaseUrl = "http://localhost:11434/v1";
                NewModel.Tier = "Cheap";
                NewModel.Provider = "ollama";
                NewModel.Family = "local";
                NewModel.MaxContextTokens = 16384;
                NewModel.InputPricePerMillion = 0.00m;
                NewModel.OutputPricePerMillion = 0.00m;
                NewModel.IsLocalOrPrivate = true;
                break;
        }
    }

    private async Task ProbeConnection(string name)
    {
        ProbingModels.Add(name);
        StateHasChanged();
        try
        {
            var res = await Api.TestModelConnectionAsync(name);
            if (res != null)
            {
                ProbeResults[name] = res;
            }
        }
        catch (Exception ex)
        {
            // 探测请求本身失败（网络/序列化）：以失败结果展示，而不是无任何反馈
            ProbeResults[name] = new ApiService.ModelTestResultDto(false, 0, "探测请求失败", ex.Message);
        }
        finally
        {
            ProbingModels.Remove(name);
            try { StateHasChanged(); } catch (ObjectDisposedException) { } // circuit 已拆除时静默退出
        }
    }

    private void ToggleAddForm()
    {
        ShowAddForm = !ShowAddForm;
        if (ShowAddForm)
        {
            NewModel = new();
            ErrorMsg = null;
        }
    }

    private async Task SubmitAdd()
    {
        ErrorMsg = null;
        if (string.IsNullOrWhiteSpace(NewModel.Name))
        { ErrorMsg = "名称不能为空"; return; }
        if (string.IsNullOrWhiteSpace(NewModel.BaseUrl))
        { ErrorMsg = "BaseUrl 不能为空"; return; }

        var req = new ApiService.CreateModelRequest(
            NewModel.Name.Trim(), NewModel.BaseUrl.Trim().TrimEnd('/'),
            string.IsNullOrWhiteSpace(NewModel.ApiKey) ? null : NewModel.ApiKey,
            NewModel.Tier,
            NewModel.MaxContextTokens > 0 ? NewModel.MaxContextTokens : 8192,
            NewModel.TimeoutSeconds > 0 ? NewModel.TimeoutSeconds : 120,
            Math.Max(0, NewModel.MaxRetries),
            bool.Parse(NewModel.EnabledStr),
            Math.Max(0, NewModel.InputPricePerMillion),
            Math.Max(0, NewModel.OutputPricePerMillion),
            null,
            string.IsNullOrWhiteSpace(NewModel.Provider) ? null : NewModel.Provider.Trim(),
            string.IsNullOrWhiteSpace(NewModel.Family) ? null : NewModel.Family.Trim(),
            NewModel.CachedInputPricePerMillion,
            NewModel.CacheWriteInputPricePerMillion,
            NewModel.IsLocalOrPrivate);

        var (ok, error) = await Api.CreateModelAsync(req);
        if (ok)
        {
            Toast($"模型 \"{NewModel.Name}\" 添加成功");
            ShowAddForm = false;
            await LoadModels();
        }
        else
        {
            ErrorMsg = "创建失败：" + (error ?? "未知错误");
        }
    }

    private void StartEdit(ApiService.ModelDto m)
    {
        EditingName = m.Name;
        EditModel = new EditModelForm
        {
            BaseUrl = m.BaseUrl,
            ApiKey = "",
            Tier = m.Tier,
            MaxContextTokens = m.MaxContextTokens,
            TimeoutSeconds = m.TimeoutSeconds,
            MaxRetries = m.MaxRetries,
            EnabledStr = m.Enabled.ToString().ToLower(),
            Provider = m.Provider,
            Family = m.Family,
            InputPricePerMillion = m.InputPricePerMillion,
            OutputPricePerMillion = m.OutputPricePerMillion,
            CachedInputPricePerMillion = m.CachedInputPricePerMillion,
            CacheWriteInputPricePerMillion = m.CacheWriteInputPricePerMillion,
            IsLocalOrPrivate = m.IsLocalOrPrivate
        };
    }

    private void CancelEdit()
    {
        EditingName = null;
    }

    private async Task SubmitEdit(string name)
    {
        var req = new ApiService.UpdateModelRequest(
            string.IsNullOrWhiteSpace(EditModel.BaseUrl) ? null : EditModel.BaseUrl.TrimEnd('/'),
            string.IsNullOrWhiteSpace(EditModel.ApiKey) ? null : EditModel.ApiKey,
            EditModel.Tier,
            EditModel.MaxContextTokens > 0 ? EditModel.MaxContextTokens : null,
            EditModel.TimeoutSeconds > 0 ? EditModel.TimeoutSeconds : null,
            EditModel.MaxRetries >= 0 ? EditModel.MaxRetries : null,
            bool.TryParse(EditModel.EnabledStr, out var en) ? en : null,
            EditModel.InputPricePerMillion >= 0 ? EditModel.InputPricePerMillion : null,
            EditModel.OutputPricePerMillion >= 0 ? EditModel.OutputPricePerMillion : null,
            string.IsNullOrWhiteSpace(EditModel.Provider) ? "" : EditModel.Provider.Trim(),
            string.IsNullOrWhiteSpace(EditModel.Family) ? "" : EditModel.Family.Trim(),
            EditModel.CachedInputPricePerMillion,
            EditModel.CacheWriteInputPricePerMillion,
            EditModel.IsLocalOrPrivate);

        var (ok, error) = await Api.UpdateModelAsync(name, req);
        if (ok)
        {
            Toast($"模型 \"{name}\" 更新成功");
            EditingName = null;
            await LoadModels();
        }
        else
        {
            Toast("更新失败：" + (error ?? "未知错误"), true);
        }
    }

    private async Task Delete(string name)
    {
        var (ok, error) = await Api.DeleteModelAsync(name);
        if (!ok)
        {
            Toast("删除失败：" + (error ?? "未知错误"), true);
            return;
        }
        Toast($"模型 \"{name}\" 已删除");
        await LoadModels();
    }

    private void Toast(string msg, bool isError = false)
    {
        ToastMsg = msg;
        ToastIsError = isError;
        _toastTimer?.Dispose();
        _toastTimer = new Timer(_ => _ = OnToastTimeout(), null, 3000, Timeout.Infinite);
    }

    private async Task OnToastTimeout()
    {
        try
        {
            await InvokeAsync(() => { ToastMsg = null; StateHasChanged(); });
        }
        catch { }
    }

    public void Dispose()
    {
        _toastTimer?.Dispose();
        _healthCts.Cancel();
        _healthCts.Dispose();
        _healthTimer?.Dispose();
    }

    private static string Truncate(string? s, int len) => s != null && s.Length > len ? s[..len] + "..." : s ?? "-";

