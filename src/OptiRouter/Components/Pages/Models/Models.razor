@page "/models"
@using OptiRouter.Components.Services
@inject ApiService Api
@inject ToastService ToastService
@inject Microsoft.Extensions.Logging.ILogger<Models> Logger

<PageTitle>OptiRouter - 模型配置</PageTitle>

<div class="models-page">
    <!-- Banner -->
    <div class="alert-banner alert-info">
        <span class="user-status-dot"></span>
        <span>模型配置页。增删改与连通性探活即时写入配置库并热生效。</span>
    </div>

    <div class="glass-card">
        <div class="card-header-row">
            <div class="card-label" style="display: flex; align-items: center; gap: 8px;">
                <AppIcon Name="models" Size="18" Class="text-primary" />
                <span>模型配置</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                <label for="model-sort" class="text-secondary" style="font-size: 0.8rem; margin: 0;">排序</label>
                <select id="model-sort" class="form-control" @bind="ModelSortOrder" aria-label="模型排序方式" style="width: auto; min-width: 138px;">
                    <option value="default">配置顺序</option>
                    <option value="tier">按档位（Strong → Medium → Cheap）</option>
                    <option value="name">按名称（A → Z）</option>
                    <option value="provider">按供应商（A → Z）</option>
                </select>
                <button class="btn-ghost" @onclick="OpenDiscoverModal" title="拉取上游 provider 可订阅模型">
                    <AppIcon Name="download" Size="14" />
                    <span>从上游拉取模型</span>
                </button>
                <button class="btn-primary" @onclick="OpenAddModal">
                    <AppIcon Name="plus" Size="14" />
                    <span>添加模型</span>
                </button>
            </div>
        </div>

        @if (IsLoadingModels)
        {
            <div style="margin-top: 12px;">
                <SkeletonLoader Type="table" Rows="4" Cols="7" />
            </div>
        }
        else if (ModelList.Any())
        {
            <!-- 模型列表：仅保留高频查看列，低频字段（Provider/Family/价格等）进编辑弹窗 -->
            <div class="table-wrap">
                <table class="config-table">
                    <thead>
                        <tr>
                            <th scope="col">名称</th><th scope="col">BaseUrl</th><th scope="col">ApiKey</th><th scope="col">Tier</th><th scope="col">启用</th><th scope="col">连通状态</th><th scope="col">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in SortedModelList)
                        {
                            <tr>
                                <td>
                                    <strong>@m.Name</strong>
                                    @if (!string.IsNullOrEmpty(m.Id) && !string.Equals(m.Id, m.Name, StringComparison.Ordinal))
                                    {
                                        <div class="text-secondary table-mono" style="font-size: 0.68rem; margin-top: 2px;" title="实际发往上游的模型 id（路由名与上游 id 不同）">id: @m.Id</div>
                                    }
                                    @if (m.IsLocalOrPrivate)
                                    {
                                        <span class="tag tag-success" style="font-size: 0.7rem; margin-left: 4px;" title="本地/私有部署节点">私有部署</span>
                                    }
                                    @if (m.Tags is { Count: > 0 })
                                    {
                                        <div style="margin-top: 3px; display: flex; gap: 4px; flex-wrap: wrap;">
                                            @foreach (var tag in m.Tags)
                                            {
                                                <span class="tag tag-info" style="font-size: 0.68rem;" title="能力标签（供路由能力过滤匹配）">@tag</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td title="@m.BaseUrl" class="table-mono">@Truncate(m.BaseUrl, 28)</td>
                                <td>
                                    @if (m.HasApiKey)
                                    {
                                        var revealed = RevealedKeys.ContainsKey(m.Name);
                                        <span class="apikey-cell">
                                            <code class="@(revealed ? "apikey-full" : "apikey-hint")"
                                                  title="@(revealed ? "完整密钥（点击右侧图标收起）" : "前 3 + 后 4 遮蔽预览，点击右侧图标显示完整密钥")">@(revealed ? RevealedKeys[m.Name] : m.ApiKeyHint)</code>
                                            <button type="button" class="key-reveal-btn" @onclick="() => ToggleRevealKey(m.Name)"
                                                    aria-label="@(revealed ? "隐藏" : "显示")完整 ApiKey" aria-pressed="@(revealed ? "true" : "false")"
                                                    title="@(revealed ? "隐藏完整 ApiKey" : "显示完整 ApiKey")">
                                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                                    @if (revealed)
                                                    {
                                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                                                        <line x1="1" y1="1" x2="23" y2="23" />
                                                    }
                                                    else
                                                    {
                                                        <path d="M17 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                                        <circle cx="12" cy="12" r="3" />
                                                    }
                                                </svg>
                                            </button>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">未配置</span>
                                    }
                                </td>
                                <td><span class="badge badge-info">@m.Tier</span></td>
                                <td>
                                    <button class="btn-ghost btn-sm @(m.Enabled ? "text-success" : "text-secondary")"
                                            @onclick="() => ToggleEnabled(m)" title="点击切换启用状态" disabled="@TogglingModels.Contains(m.Name)">
                                        @(m.Enabled ? "启用" : "停用")
                                    </button>
                                </td>
                                <td>
                                    @if (ProbeResults.TryGetValue(m.Name, out var probe))
                                    {
                                        <div>
                                            @if (probe.Success)
                                            {
                                                <span class="tag tag-success" style="font-size: 0.75rem;" title="@probe.Message">
                                                    <AppIcon Name="check" Size="12" />
                                                    <span>@probe.LatencyMs ms</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="tag tag-danger" style="font-size: 0.75rem;" title="@probe.Error">
                                                    <AppIcon Name="alert" Size="12" />
                                                    <span>失败</span>
                                                </span>
                                            }
                                            <span class="text-secondary" style="font-size: 0.68rem; display: block; margin-top: 2px;">@FormatProbeAgo(probe.TimestampUtc)</span>
                                        </div>
                                    }
                                    else if (ProbingModels.Contains(m.Name))
                                    {
                                        <span class="tag tag-info" style="font-size: 0.75rem;">
                                            <AppIcon Name="refresh" Size="12" />
                                            <span>探测中...</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary" style="font-size: 0.8rem;">未测试</span>
                                    }
                                </td>
                                <td>
                                    <div style="display: flex; gap: 4px;">
                                        <button class="btn-ghost btn-sm" @onclick="() => ProbeConnection(m.Name)" title="测试端点 API 连通性与延迟">
                                            <AppIcon Name="benchmarks" Size="13" />
                                            <span>探活</span>
                                        </button>
                                        <button class="btn-ghost btn-sm" @onclick="() => OpenCopyModal(m)" title="复制此模型配置——同供应商多模型只需改名称与模型 ID，key/BaseUrl/计价等全部带入">
                                            <AppIcon Name="copy" Size="13" />
                                            <span>复制</span>
                                        </button>
                                        <button class="btn-primary btn-sm" @onclick="() => OpenEditModal(m)">
                                            <AppIcon Name="edit" Size="13" />
                                            <span>编辑</span>
                                        </button>
                                        <button class="btn-danger btn-sm" @onclick="() => Delete(m.Name)">
                                            <AppIcon Name="trash" Size="13" />
                                            <span>删除</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <EmptyState Icon="models" Title="暂无模型配置" Description="配置上游大语言模型端点与 API 凭据，开启智能分档与动态路由。" ActionText="+ 添加模型" OnAction="OpenAddModal" />
        }
    </div>

    <!-- 模型健康状态（熔断与运维控制） -->
    <div class="glass-card">
        <div class="card-header-row">
            <div class="card-label" style="margin: 0; display: flex; align-items: center; gap: 8px;">
                <AppIcon Name="shield" Size="18" Class="text-warning" />
                <span>模型健康状态</span>
            </div>
            <button class="btn-refresh" @onclick="RefreshModelHealth" disabled="@HealthLoading" title="重新拉取模型健康与熔断状态">
                <AppIcon Name="refresh" Size="13" Class="@(HealthLoading ? "icon-spin text-primary" : "")" />
                <span>@(HealthLoading ? "刷新中..." : "刷新状态")</span>
            </button>
        </div>
        @if (!string.IsNullOrEmpty(HealthError))
        {
            <div class="alert-banner alert-error" style="margin: 8px 0; padding: 6px 12px; font-size: 0.82rem;">
                <AppIcon Name="alert" Size="14" />
                <span>@HealthError（显示的是上一次成功数据）</span>
            </div>
        }
        <div class="models-grid">
            @if (ModelHealth.Any())
            {
                @foreach (var m in ModelHealth)
                {
                    <div class="model-card state-@m.CircuitState.ToLower()">
                        <div class="card-header-row">
                            <div>
                                <div class="model-name">@m.Name</div>
                                <div class="model-tier">@m.Tier Tier</div>
                            </div>
                            <span class="badge badge-@CircuitBadge(m.CircuitState)">@CircuitText(m.CircuitState)</span>
                        </div>

                        <div class="metrics-row">
                            <div class="metric-item">
                                <span class="metric-label">失败次数</span>
                                <span class="metric-val @(m.FailureCount > 0 ? "text-danger" : "")">@m.FailureCount</span>
                            </div>
                            <div class="metric-item" style="text-align:center;">
                                <span class="metric-label">平均延迟</span>
                                <span class="metric-val @(m.LatencySamples > 0 ? "text-primary" : "")">@(m.LatencySamples > 0 ? $"{m.AvgLatencyMs:F0} ms" : "--")</span>
                            </div>
                            <div class="metric-item" style="text-align:center;">
                                <span class="metric-label">延迟样本</span>
                                <span class="metric-val">@m.LatencySamples</span>
                            </div>
                            <div class="metric-item" style="text-align:right;">
                                <span class="metric-label">活跃探测</span>
                                <span class="metric-val @(m.ActiveProbes > 0 ? "text-warning" : "")">@m.ActiveProbes</span>
                            </div>
                        </div>

                        <div style="display: flex; gap: 8px; justify-content: flex-end; margin-top: 10px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.06);">
                            <button class="btn-ghost btn-sm" @onclick='() => OverrideCircuit(m.Name, "Closed")' style="color: var(--ok-text); font-size: 0.75rem;" title="重置断路器为闭合正常状态">恢复正常</button>
                            <button class="btn-ghost btn-sm" @onclick='() => OverrideCircuit(m.Name, "Open")' style="color: var(--danger-text); font-size: 0.75rem;" title="强制下线该端点进行运维隔离">强行隔离</button>
                        </div>
                    </div>
                }
            }
            else if (HealthLoading)
            {
                <SkeletonLoader Type="card" Count="3" />
            }
            else
            {
                <EmptyState Icon="shield" Title="暂无模型健康观测数据" Description="上游模型熔断器状态、延迟样本与探活信息将在模型注册后自动同步展示。" />
            }
        </div>
    </div>
</div>

<!-- 添加/编辑模型弹窗：全字段分组表单，字段拿到全宽（替代内联编辑行） -->
@if (ShowModal)
{
    <div class="drawer-backdrop" @onclick="CloseModal">
        <div class="model-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true"
             aria-label="@(IsEditing ? $"编辑模型 {EditingName}" : CopySourceName is null ? "添加模型" : $"复制模型，源自 {CopySourceName}")">
            <div class="key-modal-title" style="display: flex; align-items: center; gap: 8px;">
                <AppIcon Name="models" Size="18" Class="text-primary" />
                <span>@(IsEditing ? $"编辑模型 — {EditingName}" : CopySourceName is null ? "添加模型" : $"复制模型 — 源自 {CopySourceName}")</span>
            </div>

            @if (!IsEditing)
            {
                <div style="margin-bottom: 0.8rem; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                    <span class="text-secondary" style="font-size: 0.82rem;">预设模板：</span>
                    <button class="btn-ghost btn-sm" @onclick='() => ApplyPreset("openai")'>GPT-4o (OpenAI)</button>
                    <button class="btn-ghost btn-sm" @onclick='() => ApplyPreset("deepseek")'>DeepSeek-V3</button>
                    <button class="btn-ghost btn-sm" @onclick='() => ApplyPreset("claude")'>Claude 3.5 Sonnet</button>
                    <button class="btn-ghost btn-sm" @onclick='() => ApplyPreset("qwen")'>Qwen-Max (通义)</button>
                    <button class="btn-ghost btn-sm" @onclick='() => ApplyPreset("ollama")'>Ollama (本地端侧)</button>
                </div>
            }

            <div class="form-grid">
                <div class="form-field full">
                    <label for="nm-baseurl">BaseUrl *</label>
                    <input type="text" id="nm-baseurl" @bind="Form.BaseUrl" placeholder="https://api.openai.com/v1" />
                </div>
                <div class="form-field full">
                    <label for="nm-apikey">ApiKey @(IsEditing ? "（不变更则留空）" : "")</label>
                    <div class="secret-input">
                        <input type="@(ShowModalApiKey ? "text" : "password")" id="nm-apikey" @bind="Form.ApiKey" placeholder="sk-..." />
                        <button type="button" class="secret-toggle" @onclick="() => ShowModalApiKey = !ShowModalApiKey"
                                aria-label="切换 ApiKey 明文显示" aria-pressed="@(ShowModalApiKey ? "true" : "false")"
                                title="@(ShowModalApiKey ? "隐藏" : "显示") ApiKey">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                @if (ShowModalApiKey)
                                {
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                                    <line x1="1" y1="1" x2="23" y2="23" />
                                }
                                else
                                {
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                }
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="form-field full">
                    <label for="nm-name">名称 *</label>
                    <input type="text" id="nm-name" @bind="Form.Name" placeholder="@(CopySourceName is null ? "路由名，需唯一，如 gpt-4o / deepseek-chat" : "必填：新模型的路由名（其余字段已自源模型复制）")" disabled="@IsEditing" />
                </div>
                <div class="form-field full">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                        <label for="nm-id" style="margin-bottom: 0;">上游模型 Id（可选）</label>
                        <button type="button" class="btn-ghost btn-sm" @onclick="FetchUpstreamModelsForForm" disabled="@IsFormDiscovering"
                                style="font-size: 0.76rem; padding: 2px 8px; display: inline-flex; align-items: center; gap: 4px;"
                                title="根据下方 BaseUrl 与 ApiKey（或当前模型配置）从上游拉取模型列表并快捷选择">
                            <AppIcon Name="@(IsFormDiscovering ? "refresh" : "download")" Size="13" Class="@(IsFormDiscovering ? "icon-spin" : "")" />
                            <span>@(IsFormDiscovering ? "拉取中..." : "拉取上游模型")</span>
                        </button>
                    </div>
                    <input type="text" id="nm-id" @bind="Form.Id" placeholder="留空 = 与名称相同；同一模型多账号 Key：名称用不同路由名，此处填上游真实模型 id" />
                    @if (!string.IsNullOrEmpty(FormDiscoverError))
                    {
                        <div class="alert-banner alert-danger" style="margin-top: 6px; padding: 6px 10px; font-size: 0.78rem;">
                            <span>@FormDiscoverError</span>
                        </div>
                    }
                    @if (FormDiscoveredModels.Count > 0)
                    {
                        <div class="form-model-picker">
                            <div class="form-model-picker-header">
                                <div class="form-model-picker-title">
                                    <AppIcon Name="models" Size="14" Class="text-primary" />
                                    <span>上游模型列表 (@FilteredFormDiscoveredModels.Count()/@FormDiscoveredModels.Count)</span>
                                </div>
                                <div style="display: flex; gap: 6px; align-items: center;">
                                    <input type="text" @bind="FormModelSearch" @bind:event="oninput" placeholder="搜索模型..."
                                           style="height: 24px; font-size: 0.75rem; padding: 2px 6px; width: 140px; border-radius: 4px;" />
                                    <button type="button" class="btn-ghost btn-sm" @onclick="ClearFormDiscovered"
                                            style="padding: 2px 6px; font-size: 0.72rem; height: 24px;">收起</button>
                                </div>
                            </div>
                            <div class="form-model-picker-chips">
                                @foreach (var item in FilteredFormDiscoveredModels)
                                {
                                    var isSelected = string.Equals(Form.Id, item.Id, StringComparison.Ordinal) ||
                                                     (string.IsNullOrEmpty(Form.Id) && string.Equals(Form.Name, item.Id, StringComparison.Ordinal));
                                    <button type="button" class="model-chip @(isSelected ? "selected" : "")"
                                            @onclick="() => SelectFormDiscoveredModel(item)"
                                            title="点击填入上游模型 ID">
                                        <span>@item.Id</span>
                                        @if (!string.IsNullOrWhiteSpace(item.OwnedBy))
                                        {
                                            <span class="chip-owner">@item.OwnedBy</span>
                                        }
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="form-field">
                    <label for="nm-tier">Tier</label>
                    <select id="nm-tier" @bind="Form.Tier">
                        <option value="Strong">Strong</option>
                        <option value="Medium">Medium</option>
                        <option value="Cheap">Cheap</option>
                    </select>
                </div>
                <div class="form-field">
                    <label for="nm-enabled">启用</label>
                    <select id="nm-enabled" @bind="Form.EnabledStr">
                        <option value="true">是</option>
                        <option value="false">否</option>
                    </select>
                </div>
                <div class="form-field">
                    <label for="nm-provider">Provider</label>
                    <input type="text" id="nm-provider" @bind="Form.Provider" placeholder="如 openai / deepseek" />
                </div>
                <div class="form-field">
                    <label for="nm-family">Family</label>
                    <input type="text" id="nm-family" @bind="Form.Family" placeholder="如 gpt-4o / deepseek-v3" />
                </div>
                <div class="form-field">
                    <label for="nm-ctx">最大上下文 Token</label>
                    <input type="number" id="nm-ctx" @bind="Form.MaxContextTokens" min="1" />
                </div>
                <div class="form-field">
                    <label for="nm-weight">负载权重（默认 1.0，0=退出负载均衡）</label>
                    <input type="number" id="nm-weight" @bind="Form.Weight" min="0" step="0.1" placeholder="默认 1.0" />
                </div>
                <div class="form-field">
                    <label for="nm-timeout">超时（秒）</label>
                    <input type="number" id="nm-timeout" @bind="Form.TimeoutSeconds" min="1" />
                </div>
                <div class="form-field">
                    <label for="nm-retries">最大重试次数</label>
                    <input type="number" id="nm-retries" @bind="Form.MaxRetries" min="0" />
                </div>
                <div class="form-field">
                    <label for="nm-inprice">输入价格 $/M</label>
                    <input type="number" id="nm-inprice" @bind="Form.InputPricePerMillion" min="0" step="0.001" />
                </div>
                <div class="form-field">
                    <label for="nm-outprice">输出价格 $/M</label>
                    <input type="number" id="nm-outprice" @bind="Form.OutputPricePerMillion" min="0" step="0.001" />
                </div>
                <div class="form-field">
                    <label for="nm-cachedprice">缓存命中价格 $/M</label>
                    <input type="number" id="nm-cachedprice" @bind="Form.CachedInputPricePerMillion" min="0" step="0.001" placeholder="可选" />
                </div>
                <div class="form-field">
                    <label for="nm-cachewriteprice">缓存写入价格 $/M</label>
                    <input type="number" id="nm-cachewriteprice" @bind="Form.CacheWritePricePerMillion" min="0" step="0.001" placeholder="可选" />
                </div>
                <div class="form-field">
                    <label for="nm-deploytype">部署类型</label>
                    <select id="nm-deploytype" @bind="Form.DeployTypeStr">
                        <option value="public">公有云</option>
                        <option value="local">本地/私有（数据不出域）</option>
                    </select>
                </div>
                <div class="form-field full">
                    <label for="nm-tags">能力标签 Tags（逗号分隔）</label>
                    <input type="text" id="nm-tags" @bind="Form.Tags" placeholder="如 vision, tool-use, json-mode" />
                    <span class="text-secondary" style="font-size: 0.72rem; margin-top: 2px;">路由「能力过滤」按这些标签匹配请求所需能力；白名单：vision / tool-use / json-mode。</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMsg))
            {
                <div class="form-error">@ErrorMsg</div>
            }
            <div class="key-modal-actions" style="margin-top: 14px;">
                <button class="btn-ghost" @onclick="CloseModal" disabled="@IsSaving">取消</button>
                <button class="btn-primary" @onclick="SubmitModal" disabled="@IsSaving">@(IsEditing ? "保存修改" : "确认添加")</button>
            </div>
        </div>
    </div>
}

@* 从上游拉取模型 — 两步式模态：Step 1 选凭证 → 拉取 → Step 2 勾选批量添加 *@
@if (ShowDiscoverModal)
{
    <div class="modal-backdrop" @onclick="CloseDiscoverModal">
        <div class="discover-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true"
             aria-label="@(DiscoverStep == 1 ? "从上游拉取模型" : "选择要添加的模型")">
            
            <!-- Modal Header -->
            <div class="modal-header">
                <div class="modal-header-left">
                    <div class="modal-icon-glow">
                        <AppIcon Name="download" Size="20" />
                    </div>
                    <div class="modal-title-wrap">
                        <span class="modal-title-text">@(DiscoverStep == 1 ? "从上游拉取模型" : "批量导入上游模型")</span>
                        <span class="modal-subtitle">@(DiscoverStep == 1 ? "连接上游 API 端点，快速扫描并发现可用模型列表" : $"从上游端点发现 {DiscoveredModels.Count} 个模型，可自定义配置并一键导入")</span>
                    </div>
                </div>

                <div style="display: flex; align-items: center; gap: 12px;">
                    <div class="stepper-nav">
                        <div class="step-item @(DiscoverStep == 1 ? "active" : "done")" role="button"
                             tabindex="@(DiscoverStep == 2 ? 0 : -1)" title="@(DiscoverStep == 2 ? "返回上一步" : null)"
                             @onclick="StepOneClick" @onkeydown="StepOneKey">
                            <span class="step-num-circle" aria-hidden="true">@(DiscoverStep > 1 ? "✓" : "1")</span>
                            <span>配置上游源</span>
                        </div>
                        <span class="step-divider" aria-hidden="true">›</span>
                        <div class="step-item @(DiscoverStep == 2 ? "active" : "")">
                            <span class="step-num-circle" aria-hidden="true">2</span>
                            <span>筛选与导入</span>
                        </div>
                    </div>
                    <button class="modal-x" @onclick="CloseDiscoverModal" aria-label="关闭" type="button">×</button>
                </div>
            </div>

            <!-- Step 1 Body -->
            @if (DiscoverStep == 1)
            {
                <div class="modal-body">
                    <!-- Source Mode Tabs -->
                    <div class="source-segmented-tabs">
                        <button type="button" class="source-tab-btn @(DiscoverSourceTab == "existing" ? "active" : "")"
                                @onclick="@(() => DiscoverSourceTab = "existing")"
                                disabled="@(!ModelList.Any(m => m.Enabled))">
                            <AppIcon Name="refresh" Size="14" />
                            <span>复用已有模型凭证 (@(ModelList.Count(m => m.Enabled)))</span>
                        </button>
                        <button type="button" class="source-tab-btn @(DiscoverSourceTab == "manual" ? "active" : "")"
                                @onclick="@(() => DiscoverSourceTab = "manual")">
                            <AppIcon Name="plus" Size="14" />
                            <span>新建/自定义端点</span>
                        </button>
                    </div>

                    @if (DiscoverSourceTab == "existing")
                    {
                        @if (ModelList.Any(m => m.Enabled))
                        {
                            <div class="form-group" style="margin-bottom: 0;">
                                <label for="discover-existing-select">
                                    <AppIcon Name="models" Size="14" Class="text-primary" />
                                    <span>选择已配置模型凭证</span>
                                </label>
                                <select id="discover-existing-select" @bind="DiscoverSelectedModelName">
                                    @foreach (var m in ModelList.Where(m => m.Enabled))
                                    {
                                        <option value="@m.Name">@m.Name (@(string.IsNullOrEmpty(m.Provider) ? "OpenAI" : m.Provider)) — @Truncate(m.BaseUrl, 42)</option>
                                    }
                                </select>
                            </div>

                            var selectedM = ModelList.FirstOrDefault(m => m.Name == DiscoverSelectedModelName) ?? ModelList.FirstOrDefault(m => m.Enabled);
                            if (selectedM != null)
                            {
                                <div class="source-preview-card">
                                    <div class="preview-url-row">
                                        <div class="preview-label">
                                            <AppIcon Name="router" Size="12" Class="text-primary" />
                                            <span>Base URL (上游端点地址)</span>
                                        </div>
                                        <div class="preview-url-box" title="@selectedM.BaseUrl">
                                            <span class="preview-url-text">@selectedM.BaseUrl</span>
                                        </div>
                                    </div>
                                    <div class="preview-meta-grid">
                                        <div class="preview-meta-item">
                                            <span class="preview-label">Provider 供应商</span>
                                            <div class="preview-value">
                                                <span class="tag tag-info" style="font-size: 0.74rem; font-weight: 600;">@(string.IsNullOrEmpty(selectedM.Provider) ? "OpenAI" : selectedM.Provider)</span>
                                            </div>
                                        </div>
                                        <div class="preview-meta-item">
                                            <span class="preview-label">API 凭证状态</span>
                                            <div class="preview-value">
                                                @if (selectedM.HasApiKey)
                                                {
                                                    <span class="tag tag-success" style="font-size: 0.74rem;">已保存（安全复用）</span>
                                                }
                                                else
                                                {
                                                    <span class="tag tag-secondary" style="font-size: 0.74rem;">免鉴权</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="preview-meta-item">
                                            <span class="preview-label">部署类型</span>
                                            <div class="preview-value">
                                                <span class="tag @(selectedM.IsLocalOrPrivate ? "tag-purple" : "tag-info")" style="font-size: 0.74rem;">@(selectedM.IsLocalOrPrivate ? "本地/私有" : "公有云")</span>
                                            </div>
                                        </div>
                                        <div class="preview-meta-item">
                                            <span class="preview-label">路由 Tier</span>
                                            <div class="preview-value">
                                                <span class="tag tag-secondary" style="font-size: 0.74rem;">@selectedM.Tier</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert-banner alert-warning">
                                <span>暂无已启用的模型配置，请切换到「新建/自定义端点」进行拉取。</span>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Preset Grid -->
                        <div class="preset-section">
                            <div class="preset-title">
                                <AppIcon Name="benchmarks" Size="13" Class="text-primary" />
                                <span>常用 Provider 快速预填</span>
                            </div>
                            <div class="preset-pill-grid">
                                @foreach (var p in Presets)
                                {
                                    var isMatch = string.Equals(DiscoverManualBaseUrl, p.BaseUrl, StringComparison.OrdinalIgnoreCase);
                                    <button type="button" class="preset-pill @(isMatch ? "active" : "")" @onclick="() => ApplyPreset(p)" title="@p.Hint">
                                        <span>@p.Icon</span>
                                        <span>@p.Name</span>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="discover-baseurl">Base URL *</label>
                            <input id="discover-baseurl" @bind="DiscoverManualBaseUrl" placeholder="https://api.openai.com/v1" />
                        </div>

                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="discover-apikey">API Key <span class="text-secondary" style="font-size: 0.72rem; font-weight: normal;">(本地开源或免鉴权上游可留空)</span></label>
                            <div class="secret-input">
                                <input id="discover-apikey" type="@(ShowModalApiKey ? "text" : "password")" @bind="DiscoverManualApiKey" placeholder="sk-..." autocomplete="off" />
                                <button type="button" class="secret-toggle" @onclick="() => ShowModalApiKey = !ShowModalApiKey"
                                        aria-label="切换明文显示" title="@(ShowModalApiKey ? "隐藏" : "显示") Key">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        @if (ShowModalApiKey)
                                        {
                                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                                            <line x1="1" y1="1" x2="23" y2="23" />
                                        }
                                        else
                                        {
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                            <circle cx="12" cy="12" r="3" />
                                        }
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <div class="form-group" style="margin-bottom: 0;">
                            <label for="discover-protocol">上游协议</label>
                            <select id="discover-protocol" @bind="DiscoverManualProtocol">
                                <option value="OpenAI">OpenAI 兼容协议 (/v1/models)</option>
                                <option value="Gemini">Google Gemini 协议 (/v1beta/models)</option>
                            </select>
                        </div>
                    }

                    @if (IsDiscovering)
                    {
                        <div class="discovering-banner">
                            <div class="discovering-pulse-ring"></div>
                            <span>正在向上游端点发送探测请求并解析模型清单，请稍候…</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(DiscoverError))
                    {
                        <div class="alert-banner alert-danger" style="margin-top: 4px;">
                            <AppIcon Name="alert" Size="16" />
                            <span>@DiscoverError</span>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button class="btn-ghost" @onclick="CloseDiscoverModal" type="button">取消</button>
                    <div class="modal-footer-right">
                        <button class="btn-primary" @onclick="RunDiscoverAsync" disabled="@IsDiscovering" type="button" style="min-width: 140px;">
                            <AppIcon Name="@(IsDiscovering ? "refresh" : "download")" Size="14" Class="@(IsDiscovering ? "icon-spin" : "")" />
                            <span>@(IsDiscovering ? "正在拉取…" : "扫描并拉取模型")</span>
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- Step 2 Body -->
                <div class="modal-body">
                    <!-- Upstream Source Info Bar -->
                    <div class="discover-source-bar">
                        <div class="discover-source-info">
                            <span class="tag tag-primary" style="font-size: 0.72rem;">@DiscoverSourceProtocol</span>
                            <span class="discover-source-url">@Truncate(DiscoverSourceBaseUrl, 48)</span>
                            <span class="text-muted">· 共扫描到 <strong>@DiscoveredModels.Count</strong> 个模型</span>
                        </div>
                        <button type="button" class="discover-switch-link" @onclick="BackToSourceStep">
                            <AppIcon Name="refresh" Size="12" />
                            <span>切换/重新配置上游</span>
                        </button>
                    </div>

                    <!-- Bulk Defaults Config Card -->
                    <div class="bulk-config-card">
                        <div class="bulk-config-header">
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <AppIcon Name="benchmarks" Size="13" Class="text-primary" />
                                <span>批量导入预设参数 (将应用至本次勾选或单项导入的模型)</span>
                            </div>
                        </div>
                        <div class="bulk-config-grid">
                            <div class="form-group">
                                <label>路由 Tier</label>
                                <select @bind="BulkAddTier">
                                    <option value="Strong">Strong (强力模型)</option>
                                    <option value="Medium">Medium (均衡模型)</option>
                                    <option value="Cheap">Cheap (经济模型)</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>MaxContextTokens</label>
                                <input type="number" min="1" @bind="BulkAddMaxContextTokens" />
                            </div>
                            <div class="form-group">
                                <label>部署属性</label>
                                <select @bind="BulkAddDeployType">
                                    <option value="public">公有云服务</option>
                                    <option value="local">本地/私有化部署</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>初始状态</label>
                                <select @bind="BulkAddEnabled">
                                    <option value="true">立即启用</option>
                                    <option value="false">暂不启用</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Toolbar: Filters, Search, Batch Actions -->
                    <div class="discover-toolbar">
                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                            <div class="discover-search-wrap">
                                <span class="search-icon"><AppIcon Name="search" Size="13" /></span>
                                <input type="text" @bind="DiscoverSearchText" @bind:event="oninput" placeholder="搜索模型 ID 或名称..." />
                                @if (!string.IsNullOrEmpty(DiscoverSearchText))
                                {
                                    <button type="button" class="discover-search-clear" @onclick="() => DiscoverSearchText = string.Empty">×</button>
                                }
                            </div>

                            <div class="filter-pills-group">
                                <button type="button" class="filter-pill-btn @(DiscoverFilterTab == "all" ? "active" : "")"
                                        @onclick="@(() => DiscoverFilterTab = "all")">
                                    全部 (@DiscoveredModels.Count)
                                </button>
                                <button type="button" class="filter-pill-btn @(DiscoverFilterTab == "available" ? "active" : "")"
                                        @onclick="@(() => DiscoverFilterTab = "available")">
                                    可添加 (@DiscoverSelected.Count(r => !r.AlreadyExists && !r.Added))
                                </button>
                                <button type="button" class="filter-pill-btn @(DiscoverFilterTab == "existing" ? "active" : "")"
                                        @onclick="@(() => DiscoverFilterTab = "existing")">
                                    已存在/已添加 (@DiscoverSelected.Count(r => r.AlreadyExists || r.Added))
                                </button>
                            </div>
                        </div>

                        <div class="batch-actions-group">
                            <span class="text-secondary" style="font-size: 0.76rem; margin-right: 4px;">
                                已勾选 <strong>@DiscoverSelected.Count(r => r.Selected && !r.AlreadyExists && !r.Added)</strong> 项
                            </span>
                            <button type="button" class="btn-ghost btn-sm" @onclick="SelectAllAvailable">全选未添加</button>
                            <button type="button" class="btn-ghost btn-sm" @onclick="InvertSelection">反选</button>
                            <button type="button" class="btn-ghost btn-sm" @onclick="DeselectAll">清空</button>
                        </div>
                    </div>

                    <!-- Discovered Models Table -->
                    <div class="discover-table-wrap">
                        @if (!FilteredDiscoverSelected.Any())
                        {
                            <div class="discover-empty-state">
                                <AppIcon Name="search" Size="28" Class="text-muted" />
                                <span>没有找到符合条件的上游模型</span>
                                @if (!string.IsNullOrEmpty(DiscoverSearchText) || DiscoverFilterTab != "all")
                                {
                                    <button type="button" class="btn-ghost btn-sm" style="margin-top: 4px;"
                                            @onclick="@(() => { DiscoverSearchText = string.Empty; DiscoverFilterTab = "all"; })">
                                        重置筛选条件
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <table class="discover-table">
                                <thead>
                                    <tr>
                                        <th scope="col" style="width: 38px; text-align: center;">
                                            <input type="checkbox" checked="@AllAvailableSelected" @onchange="ToggleSelectAll" aria-label="全选可添加模型" />
                                        </th>
                                        <th scope="col">模型 ID</th>
                                        <th scope="col">显示名称 / 供应商</th>
                                        <th scope="col" style="width: 100px; text-align: center;">导入状态</th>
                                        <th scope="col" style="width: 80px; text-align: right; padding-right: 14px;">快捷操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in FilteredDiscoverSelected)
                                    {
                                        var isChecked = item.Selected;
                                        <tr class="@(isChecked ? "row-selected" : "")">
                                            <td style="text-align: center;">
                                                <input type="checkbox" @bind="item.Selected" disabled="@(item.AlreadyExists || item.Added)" aria-label="@($"选择 {item.Model.Id}")" />
                                            </td>
                                            <td>
                                                <div class="model-id-cell">
                                                    <span>@item.Model.Id</span>
                                                </div>
                                            </td>
                                            <td>
                                                <div style="display: flex; align-items: center; gap: 6px;">
                                                    @if (!string.IsNullOrEmpty(item.Model.Name) && !string.Equals(item.Model.Name, item.Model.Id, StringComparison.Ordinal))
                                                    {
                                                        <span style="color: var(--text-secondary); font-size: 0.8rem;">@item.Model.Name</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(item.Model.OwnedBy))
                                                    {
                                                        <span class="tag tag-info" style="font-size: 0.68rem;">@item.Model.OwnedBy</span>
                                                    }
                                                </div>
                                            </td>
                                            <td style="text-align: center;">
                                                @if (item.Added)
                                                {
                                                    <span class="tag tag-success">已添加</span>
                                                }
                                                else if (item.AlreadyExists)
                                                {
                                                    <span class="tag tag-secondary">已存在</span>
                                                }
                                                else if (!string.IsNullOrEmpty(item.AddError))
                                                {
                                                    <span class="tag tag-danger" title="@item.AddError">失败</span>
                                                }
                                                else
                                                {
                                                    <span class="tag tag-info">可添加</span>
                                                }
                                            </td>
                                            <td style="text-align: right; padding-right: 14px;">
                                                <button type="button" class="btn-row-add"
                                                        disabled="@(item.AlreadyExists || item.Added || IsBulkAdding)"
                                                        @onclick="() => AddSingleDiscoveredModelAsync(item)"
                                                        title="@(item.AlreadyExists || item.Added ? "该模型已存在或已添加" : "立即导入此模型")">
                                                    <AppIcon Name="plus" Size="11" />
                                                    <span>导入</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn-ghost" @onclick="BackToSourceStep" type="button">
                        <AppIcon Name="arrow-right" Size="13" Style="transform: rotate(180deg);" />
                        <span>上一步</span>
                    </button>
                    <div class="modal-footer-right">
                        <button class="btn-ghost" @onclick="CloseDiscoverModal" type="button">关闭</button>
                        <button class="btn-primary" @onclick="BulkAddSelectedAsync"
                                disabled="@(!DiscoverSelected.Any(x => x.Selected && !x.AlreadyExists && !x.Added) || IsBulkAdding)"
                                type="button" style="min-width: 160px;">
                            <AppIcon Name="@(IsBulkAdding ? "refresh" : "plus")" Size="14" Class="@(IsBulkAdding ? "icon-spin" : "")" />
                            <span>@(IsBulkAdding ? "正在导入…" : $"批量导入选中 ({DiscoverSelected.Count(x => x.Selected && !x.AlreadyExists && !x.Added)})")</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}
