@page "/benchmarks"
@using System.Diagnostics
@using OptiRouter.Benchmarks
@using OptiRouter.Mcp
@using OptiRouter.Mesh
@using OptiRouter.Compression
@using OptiRouter.Routing
@using OptiRouter.Configuration
@using Microsoft.Extensions.Options
@using OptiRouter.Components.Services
@inject StressBenchmarkEngine BenchmarkEngine
@inject RouterEngine Engine
@inject IOptionsMonitor<RouterOptions> OptionsMonitor
@inject McpToolRegistry ToolRegistry
@inject McpToolComplexityAnalyzer ToolComplexityAnalyzer
@inject IPromptPruner PromptPruner
@inject DistributedMeshSynchronizer MeshSynchronizer
@inject ToastService ToastService
@implements IDisposable

<PageTitle>OptiRouter - 性能基准、MCP 生态与分布式 Mesh 拓扑</PageTitle>

<div class="studio-container">
    <header class="studio-header">
        <div>
            <h1 class="studio-title">性能基准、MCP 生态与分布式 Mesh 拓扑</h1>
            <p class="studio-subtitle">实时并发压测、Model Context Protocol 工具目录态势感知与分布式状态同步网格</p>
        </div>
        <div class="header-badges">
            <span class="tag tag-primary">
                <AppIcon Name="models" Size="14" />
                <span>Node: @MeshSynchronizer.LocalNodeId</span>
            </span>
            <span class="tag tag-success">
                <AppIcon Name="check" Size="14" />
                <span>Mesh Synchronized</span>
            </span>
        </div>
    </header>

    <div class="dashboard-grid">
        <!-- 模块 1: 在线高并发压测台 -->
        <section class="glass-card benchmark-card">
            <div class="benchmark-card-header">
                <h2>
                    <AppIcon Name="benchmarks" Size="18" Class="text-warning" />
                    <span>路由决策基准压测 (Routing Decision Benchmark)</span>
                </h2>
                <span class="tag @(isRunningBenchmark ? "tag-warning" : "tag-secondary")">
                    @(isRunningBenchmark ? "压测进行中..." : "就绪")
                </span>
            </div>

            <div class="benchmark-controls">
                <div class="control-group">
                    <label>压测场景</label>
                    <select class="form-control" @bind="selectedScenario" disabled="@isRunningBenchmark">
                        <option value="@BenchmarkScenario.FastRouteDecision">极速决策流水线 (FastRouteDecision)</option>
                        <option value="@BenchmarkScenario.McpComplexityPipeline">MCP 复杂度评估流水线</option>
                        <option value="@BenchmarkScenario.RagDensityPipeline">RAG 上下文密度分析流水线</option>
                    </select>
                </div>

                <div class="control-group">
                    <label>
                        <span>并发 Worker 数</span>
                        <strong>@concurrency</strong>
                    </label>
                    <input type="range" min="1" max="100" step="1" class="form-range" @bind="concurrency" disabled="@isRunningBenchmark" />
                </div>

                <div class="control-group">
                    <label>
                        <span>总请求量</span>
                        <strong>@UiFormatter.FormatNumber(totalRequests)</strong>
                    </label>
                    <input type="range" min="50" max="5000" step="50" class="form-range" @bind="totalRequests" disabled="@isRunningBenchmark" />
                </div>

                <button class="btn-primary" @onclick="RunBenchmarkAsync" disabled="@isRunningBenchmark" style="width: 100%; justify-content: center;">
                    <AppIcon Name="@(isRunningBenchmark ? "refresh" : "benchmarks")" Size="16" />
                    <span>@(isRunningBenchmark ? "正在执行压测..." : "启动并发压测")</span>
                </button>
            </div>

            @if (latestReport != null)
            {
                <div class="benchmark-results">
                    <div class="metrics-row">
                        <div class="metric-box">
                            <div class="metric-label">每秒吞吐 (RPS)</div>
                            <div class="metric-value highlight">@latestReport.RequestsPerSecond.ToString("F1") req/s</div>
                        </div>
                        <div class="metric-box">
                            <div class="metric-label">成功率</div>
                            <div class="metric-value text-success">@((latestReport.SuccessRequests * 100.0 / latestReport.TotalRequests).ToString("F1"))%</div>
                        </div>
                        <div class="metric-box">
                            <div class="metric-label">中位数延迟 (P50)</div>
                            <div class="metric-value">@latestReport.Latency.P50Ms.ToString("F3") ms</div>
                        </div>
                        <div class="metric-box">
                            <div class="metric-label">长尾延迟 (P99)</div>
                            <div class="metric-value text-warning">@latestReport.Latency.P99Ms.ToString("F3") ms</div>
                        </div>
                    </div>

                    <div class="percentile-table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th scope="col">P50</th>
                                    <th scope="col">P75</th>
                                    <th scope="col">P90</th>
                                    <th scope="col">P95</th>
                                    <th scope="col">P99</th>
                                    <th scope="col">P99.9</th>
                                    <th scope="col">GC (0/1/2)</th>
                                    <th scope="col">内存吞吐</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>@latestReport.Latency.P50Ms.ToString("F3") ms</td>
                                    <td>@latestReport.Latency.P75Ms.ToString("F3") ms</td>
                                    <td>@latestReport.Latency.P90Ms.ToString("F3") ms</td>
                                    <td>@latestReport.Latency.P95Ms.ToString("F3") ms</td>
                                    <td>@latestReport.Latency.P99Ms.ToString("F3") ms</td>
                                    <td>@latestReport.Latency.P999Ms.ToString("F3") ms</td>
                                    <td>@latestReport.Gen0Collections / @latestReport.Gen1Collections / @latestReport.Gen2Collections</td>
                                    <td>@((latestReport.TotalAllocatedBytes / 1024.0 / 1024.0).ToString("F2")) MB</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (!isRunningBenchmark)
            {
                <EmptyState Icon="benchmarks" Title="暂无基准压测运行记录" Description="配置压测场景、并发 Worker 数与请求量后，点击上方「启动并发压测」开始采集吞吐与长尾延迟指标。" />
            }
        </section>

        <!-- 模块 2: MCP 工具目录与复杂度感知 -->
        <section class="glass-card mcp-card">
            <div class="benchmark-card-header">
                <h2>
                    <AppIcon Name="router" Size="18" Class="text-primary" />
                    <span>MCP (Model Context Protocol) 工具生态目录</span>
                </h2>
                <span class="tag tag-info">@registeredTools.Count 个注册工具</span>
            </div>

            <div class="percentile-table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col">工具名称</th>
                            <th scope="col">复杂度评分</th>
                            <th scope="col">推荐分档</th>
                            <th scope="col">嵌套深度</th>
                            <th scope="col">属性数量</th>
                            <th scope="col">Schema 状态</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (registeredTools.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-secondary text-center" style="padding: 24px;">暂无注册的 MCP 工具（支持自动通过 ToolRegistry 注册）</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var tool in registeredTools)
                            {
                                var complexity = ToolComplexityAnalyzer.Analyze(new[] { tool });
                                <tr>
                                    <td>
                                        <strong>@tool.Name</strong>
                                        <div class="text-secondary" style="font-size: 0.75rem; margin-top: 2px;">@tool.Description</div>
                                    </td>
                                    <td><span class="tag tag-primary">@complexity.ComplexityScore.ToString("F1")</span></td>
                                    <td><span class="badge badge-info">@complexity.RecommendedMinTier</span></td>
                                    <td>@complexity.MaxNestingDepth 级</td>
                                    <td>@complexity.TotalProperties 个</td>
                                    <td><span class="tag tag-success">Valid</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <!-- 模块 3: 分布式 State Mesh 拓扑与 KV Cache 共享 -->
        <section class="glass-card mesh-card">
            <div class="benchmark-card-header">
                <h2>
                    <AppIcon Name="models" Size="18" Class="text-purple" />
                    <span>分布式状态同步网格 (Distributed State Mesh)</span>
                </h2>
                <span class="tag tag-primary">P2P Mesh Active</span>
            </div>

            <div class="mesh-summary">
                <div class="mesh-node-item">
                    <div class="node-icon">
                        <AppIcon Name="models" Size="20" />
                    </div>
                    <div class="node-info">
                        <div class="node-title">本地节点 (Local Node)</div>
                        <div class="node-meta">ID: <code style="color: var(--primary);">@MeshSynchronizer.LocalNodeId</code></div>
                    </div>
                    <span class="tag tag-success">Leader/Active</span>
                </div>
                <div class="mesh-stats-grid">
                    <div class="stat-item">
                        <div class="stat-item-value">KV-Prefix Trie</div>
                        <div class="stat-item-label">分布式上下文缓存热度</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-item-value">Kalman Filter</div>
                        <div class="stat-item-label">多节点延迟预估器</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-item-value">Cluster Ledger</div>
                        <div class="stat-item-label">跨网关配额统一结算</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 模块 4: 自适应 Prompt 压缩与瘦身 -->
        <section class="glass-card compression-card">
            <div class="benchmark-card-header">
                <h2>
                    <AppIcon Name="shield" Size="18" Class="text-success" />
                    <span>智能提示词压缩与 Token 瘦身 (Prompt Pruner)</span>
                </h2>
                <span class="tag tag-success">Enabled</span>
            </div>

            <div class="compression-info">
                <p>实时对系统指令（System Prompt）进行多轮去重，自动裁剪历史寒暄客套，并对代码块（<code>```</code>）与 JSON 数据结构进行严格 100% 语法无损保护。</p>
                <div class="pill-list">
                    <span class="pill"><AppIcon Name="check" Size="12" /> System Prompt 去重</span>
                    <span class="pill"><AppIcon Name="check" Size="12" /> 历史寒暄智能剪枝</span>
                    <span class="pill"><AppIcon Name="check" Size="12" /> 代码块严格保护</span>
                    <span class="pill"><AppIcon Name="check" Size="12" /> JSON 结构无损</span>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private bool isRunningBenchmark = false;
    private BenchmarkScenario selectedScenario = BenchmarkScenario.FastRouteDecision;
    private int concurrency = 20;
    private int totalRequests = 200;
    private BenchmarkSummaryReport? latestReport;
    private List<McpToolRegistration> registeredTools = new();

    protected override void OnInitialized()
    {
        registeredTools = ToolRegistry.GetAllTools().ToList();
        if (registeredTools.Count == 0)
        {
            // 初始化展示默认工具
            ToolRegistry.RegisterTool(new McpToolRegistration
            {
                Name = "web_search",
                Description = "Search the web for realtime information",
                ServerName = "search-service",
                InputSchema = System.Text.Json.JsonDocument.Parse("{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"}},\"required\":[\"query\"]}").RootElement
            });

            ToolRegistry.RegisterTool(new McpToolRegistration
            {
                Name = "database_sql_executor",
                Description = "Execute analytical SQL queries with join conditions",
                ServerName = "db-service",
                InputSchema = System.Text.Json.JsonDocument.Parse("{\"type\":\"object\",\"properties\":{\"sql\":{\"type\":\"string\"},\"timeout\":{\"type\":\"integer\"}},\"required\":[\"sql\"]}").RootElement
            });

            registeredTools = ToolRegistry.GetAllTools().ToList();
        }
    }

    private async Task RunBenchmarkAsync()
    {
        if (isRunningBenchmark) return;
        isRunningBenchmark = true;
        // 页面级取消源：导航离开（Dispose）即取消压测，避免后台 worker 继续占用 CPU
        _benchmarkCts?.Dispose();
        _benchmarkCts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            var options = OptionsMonitor.CurrentValue;
            var config = new BenchmarkConfig
            {
                Scenario = selectedScenario,
                Concurrency = concurrency,
                TotalRequests = totalRequests,
                WarmupRequests = 10
            };

            latestReport = await BenchmarkEngine.RunAsync(
                config,
                (req, ct) =>
                {
                    var sw = Stopwatch.StartNew();
                    var decision = Engine.Decide(req, options);
                    sw.Stop();

                    return Task.FromResult(new BenchmarkSample(
                        LatencyMs: sw.Elapsed.TotalMilliseconds,
                        TtftMs: null,
                        StatusCode: 200,
                        Success: decision.Candidates.Count > 0));
                },
                _benchmarkCts.Token);

            ToastService.ShowSuccess($"并发压测已完成！RPS: {latestReport.RequestsPerSecond:F1} req/s，P50: {latestReport.Latency.P50Ms:F3}ms", "基准压测完成");
        }
        catch (OperationCanceledException)
        {
            ToastService.ShowWarning("压测已被用户中断或页面已切换", "压测已取消");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("压测执行失败：" + ex.Message, "基准压测异常");
        }
        finally
        {
            isRunningBenchmark = false;
            StateHasChanged();
        }
    }

    private CancellationTokenSource? _benchmarkCts;

    public void Dispose()
    {
        _benchmarkCts?.Cancel();
        _benchmarkCts?.Dispose();
    }
}
