    .node-meta { font-size: 12px; color: #94a3b8; }
    .mesh-stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 14px; }
    .stat-item { background: #0f172a; padding: 10px; border-radius: 8px; border: 1px solid #334155; text-align: center; }
    .stat-value { font-weight: 600; color: #e2e8f0; font-size: 13px; }
    .stat-label { font-size: 11px; color: #94a3b8; margin-top: 2px; }
    @@media (max-width: 1024px) { .dashboard-grid { grid-template-columns: 1fr; } }

    /* 浅色主题覆盖（本页样式块为独立深色设计，需按 data-theme 重映射） */
    [data-theme="light"] .studio-container { color: #0f172a; }
    [data-theme="light"] .studio-header { border-bottom-color: #e2e8f0; }
    [data-theme="light"] .studio-title { color: #0f172a; }
    [data-theme="light"] .studio-subtitle { color: #64748b; }
    [data-theme="light"] .card { background: #ffffff; border-color: #e2e8f0; }
    [data-theme="light"] .card-header h2 { color: #1e293b; }
    [data-theme="light"] .badge-secondary { background: #e2e8f0; color: #334155; }
    [data-theme="light"] .metric-box { background: #f8fafc; border-color: #e2e8f0; }
    [data-theme="light"] .metric-value { color: #0f172a; }
    [data-theme="light"] .metric-value.highlight { color: #0284c7; }
    [data-theme="light"] .metric-label { color: #64748b; }
    [data-theme="light"] .data-table th, [data-theme="light"] .data-table td { border-bottom-color: #e2e8f0; }
    [data-theme="light"] .data-table th { color: #475569; background: #f1f5f9; }
    [data-theme="light"] .pill { background: #ffffff; border-color: #cbd5e1; color: #0369a1; }
    [data-theme="light"] .mesh-node-item { background: #f8fafc; border-color: #e2e8f0; }
    [data-theme="light"] .node-title { color: #0f172a; }
    [data-theme="light"] .node-meta { color: #64748b; }
    [data-theme="light"] .stat-item { background: #f8fafc; border-color: #e2e8f0; }
    [data-theme="light"] .stat-value { color: #1e293b; }
    [data-theme="light"] .stat-label { color: #64748b; }
    [data-theme="light"] .control-group { color: #475569; }
    [data-theme="light"] .form-control { background: #ffffff; border-color: #cbd5e1; color: #0f172a; }
</style>

@code {
    private bool isRunningBenchmark = false;
    private BenchmarkScenario selectedScenario = BenchmarkScenario.FastRouteDecision;
    private int concurrency = 20;
    private int totalRequests = 200;
    private BenchmarkSummaryReport? latestReport;
    private List<McpToolRegistration> registeredTools = new();

    protected override void OnInitialized()
    {
        registeredTools = ToolRegistry.GetAllTools().ToList();
        if (registeredTools.Count == 0)
        {
            // 初始化展示默认工具
            ToolRegistry.RegisterTool(new McpToolRegistration
            {
                Name = "web_search",
                Description = "Search the web for realtime information",
                ServerName = "search-service",
                InputSchema = System.Text.Json.JsonDocument.Parse("{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"}},\"required\":[\"query\"]}").RootElement
            });

            ToolRegistry.RegisterTool(new McpToolRegistration
            {
                Name = "database_sql_executor",
                Description = "Execute analytical SQL queries with join conditions",
                ServerName = "db-service",
                InputSchema = System.Text.Json.JsonDocument.Parse("{\"type\":\"object\",\"properties\":{\"sql\":{\"type\":\"string\"},\"timeout\":{\"type\":\"integer\"}},\"required\":[\"sql\"]}").RootElement
            });

            registeredTools = ToolRegistry.GetAllTools().ToList();
        }
    }

    private async Task RunBenchmarkAsync()
    {
        if (isRunningBenchmark) return;
        isRunningBenchmark = true;
        StateHasChanged();

        try
        {
            var options = OptionsMonitor.CurrentValue;
            var config = new BenchmarkConfig
            {
                Scenario = selectedScenario,
                Concurrency = concurrency,
                TotalRequests = totalRequests,
                WarmupRequests = 10
            };

            latestReport = await BenchmarkEngine.RunAsync(config, (req, ct) =>
            {
                var sw = Stopwatch.StartNew();
                var decision = Engine.Decide(req, options);
                sw.Stop();

                return Task.FromResult(new BenchmarkSample(
                    LatencyMs: sw.Elapsed.TotalMilliseconds,
                    TtftMs: null,
                    StatusCode: 200,
                    Success: decision.Candidates.Count > 0));
            });
        }
        finally
        {
            isRunningBenchmark = false;
            StateHasChanged();
        }
    }
}
