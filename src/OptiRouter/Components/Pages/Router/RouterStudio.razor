@page "/router"
@inject ApiService Api
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>OptiRouter - 路由实验室</PageTitle>

<div class="models-page">
    <!-- 路由引擎状态 -->
    <div class="glass-card">
        <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; font-size: 1rem;">
            <span>路由引擎状态</span>
            <span class="tag tag-info" style="font-size: 0.75rem;">● 每 15 秒自动刷新</span>
        </div>
        @if (!string.IsNullOrEmpty(MetricsError))
        {
            <div class="alert-banner alert-error" style="margin: 8px 0; padding: 6px 12px; font-size: 0.82rem;">⚠️ @MetricsError（显示的是上一次成功数据）</div>
        }
        @if (!string.IsNullOrEmpty(LearningError))
        {
            <div class="alert-banner alert-error" style="margin: 8px 0; padding: 6px 12px; font-size: 0.82rem;">⚠️ @LearningError（显示的是上一次成功数据）</div>
        }
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-card-label">故障转移</div>
                <div class="stat-card-val" style="color:@(Metrics?.System.Routing.EnableFailover == true ? "var(--ok-text)" : "#64748b");">@(Metrics?.System.Routing.EnableFailover == true ? "启用" : "禁用")</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">预算防护</div>
                <div class="stat-card-val" style="color:@(Metrics?.System.Routing.EnableBudgetGuard == true ? "var(--ok-text)" : "#64748b");">@(Metrics?.System.Routing.EnableBudgetGuard == true ? "启用" : "禁用")</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">规则分类器</div>
                <div class="stat-card-val" style="color:@(Metrics?.System.Routing.EnableRuleClassifier == true ? "var(--ok-text)" : "#64748b");">@(Metrics?.System.Routing.EnableRuleClassifier == true ? "启用" : "禁用")</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">延迟感知</div>
                <div class="stat-card-val" style="color:@(Metrics?.System.Routing.EnableLatencyAware == true ? "var(--ok-text)" : "#64748b");">@(Metrics?.System.Routing.EnableLatencyAware == true ? "启用" : "禁用")</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">语义路由</div>
                <div class="stat-card-val" style="color:@(Metrics?.System.Routing.EnableSemanticRouter == true ? "var(--ok-text)" : "#64748b");">@(Metrics?.System.Routing.EnableSemanticRouter == true ? "启用" : "禁用")</div>
            </div>
        </div>
    </div>

    <!-- 一键预设 -->
    <div class="glass-card">
        <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <span>🚀 推荐配置预设</span>
            @if (PresetSummaries.Count > 0)
            {
                @if (!string.IsNullOrEmpty(MatchedPresetName))
                {
                    <span class="tag tag-success">当前配置匹配: @(PresetSummaries.FirstOrDefault(p => p.Name == MatchedPresetName)?.Title ?? MatchedPresetName)</span>
                }
                else
                {
                    <span class="tag">自定义配置（不匹配任何预设）</span>
                }
            }
        </div>
        <div class="preset-grid">
            @foreach (var preset in PresetSummaries)
            {
                var isMatched = MatchedPresetName == preset.Name;
                <div class="preset-card @(isMatched ? "preset-card-matched" : "")">
                    <div class="preset-card-header">
                        <div>
                            <div class="preset-card-title">@preset.Name</div>
                            <div class="preset-card-subtitle">@preset.Title</div>
                        </div>
                        @if (isMatched)
                        {
                            <span class="tag tag-success" style="font-size: 0.7rem;">✓ 匹配</span>
                        }
                    </div>
                    <div class="preset-card-desc">@preset.Description</div>
                    <button class="btn-ghost btn-sm preset-card-btn" @onclick="() => ApplyPresetToForm(preset.Name)" disabled="@(SelectedPresetName == preset.Name)">
                        @(SelectedPresetName == preset.Name ? "✓ 已填充到表单" : "填充到表单")
                    </button>
                </div>
            }
        </div>
        <div class="meta-text" style="margin-top: 10px;">
            预设会把下述推荐值填入下方配置表单（可再微调），点「保存并热生效」才落盘——所见即所存。
        </div>
    </div>

    <!-- 系统策略与预算动态控制面板 -->
    <div class="glass-card">
        <div class="card-label">
            <span>⚙️ 系统路由策略与预算配置控制台</span>
            <button class="btn-primary btn-sm" @onclick="SaveSystemConfig" disabled="@(IsConfigSaving || _baseline is null || DirtyCount == 0)">
                @(IsConfigSaving ? "热更新保存中..." : (DirtyCount > 0 ? $"💾 保存并热生效（{DirtyCount} 项变更）" : "💾 保存并热生效"))
            </button>
        </div>

        @if (!string.IsNullOrEmpty(ConfigStatusMsg))
        {
            <div class="alert-banner @(ConfigStatusOk ? "alert-success" : "alert-error")" style="margin: 8px 0; padding: 6px 12px; font-size: 0.82rem;">@ConfigStatusMsg</div>
        }
        @if (DirtyCount > 0)
        {
            <div class="alert-banner alert-error" style="margin: 8px 0; padding: 6px 12px; font-size: 0.8rem;">
                ⚠️ 有 @DirtyCount 项未保存的变更。切换页面或刷新前请先保存。
                <button class="btn-ghost btn-sm" style="margin-left: 8px;" @onclick="DiscardChanges">放弃更改</button>
            </div>
        }

        <div class="config-grid">
            <!-- ① 基础路由 -->
            <div class="sub-card">
                <div class="card-label" style="margin-bottom: 8px;">🧭 基础路由</div>
                <div class="config-group-header">路由策略</div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableRuleClassifier)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">规则分类器</span>
                            <span class="item-desc">关键词规则给请求分档（代码/数学/翻译）。默认开。</span>
                        </div>
                        <label class="toggle-switch" title="关键词规则给请求分档（代码/数学/翻译）。默认开。">
                            <input type="checkbox" @bind="Cfg.EnableRuleClassifier" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableSemanticRouter)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">语义向量路由</span>
                            <span class="item-desc">按语义路由规则表（下方工作室）把相似问法路由到指定档位。默认开。</span>
                        </div>
                        <label class="toggle-switch" title="按语义路由规则表把相似问法路由到指定档位。默认开。">
                            <input type="checkbox" @bind="Cfg.EnableSemanticRouter" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableCapabilityFilter)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">能力过滤</span>
                            <span class="item-desc">按请求能力需求（vision / tool-use / json-mode）过滤模型，仅命中模型配置 Tags 的候选可用。硬约束，过滤后为空直接无候选。</span>
                        </div>
                        <label class="toggle-switch" title="按 vision/tool-use/json-mode 能力标签过滤候选模型；Tags 在模型页配置。">
                            <input type="checkbox" @bind="Cfg.EnableCapabilityFilter" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableSessionAffinity)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">会话亲和</span>
                            <span class="item-desc">同 X-Session-Id 的请求尽量固定到同一模型，保持回答风格一致。默认开。</span>
                        </div>
                        <label class="toggle-switch" title="同 X-Session-Id 的请求尽量固定到同一模型。默认开。">
                            <input type="checkbox" @bind="Cfg.EnableSessionAffinity" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                </div>

                <div class="config-group-header">候选重排</div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableLatencyAware)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">历史延迟感知重排</span>
                            <span class="item-desc">按各模型历史延迟重排候选链，慢模型沉底。承载 Thompson/Bandit 学习重排。</span>
                        </div>
                        <label class="toggle-switch" title="按各模型历史延迟重排候选链，慢模型沉底。">
                            <input type="checkbox" @bind="Cfg.EnableLatencyAware" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableLoadBalance)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">负载均衡</span>
                            <span class="item-desc">同级候选间加权随机分流。默认开。</span>
                        </div>
                        <label class="toggle-switch" title="同级候选间加权随机分流。默认开。">
                            <input type="checkbox" @bind="Cfg.EnableLoadBalance" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableKalmanLoadBalance)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">Kalman 延迟估计分流</span>
                            <span class="item-desc">用卡尔曼滤波预测各模型实时延迟做分流权重，比静态加权更敏锐。</span>
                        </div>
                        <label class="toggle-switch" title="用卡尔曼滤波预测各模型实时延迟做分流权重。">
                            <input type="checkbox" @bind="Cfg.EnableKalmanLoadBalance" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                </div>

                <div class="config-group-header">默认设置</div>
                <div class="config-item @(IsDirty(nameof(ConfigForm.DefaultTier)) ? "dirty-field" : "")">
                    <div class="item-text">
                        <span class="item-title">默认档位</span>
                        <span class="item-desc">无任何分类信号命中时的兜底档位。</span>
                    </div>
                    <select @bind="Cfg.DefaultTier" class="form-control" style="width: auto; min-width: 160px;">
                        <option value="Strong">Strong（贵而强）</option>
                        <option value="Medium">Medium（均衡）</option>
                        <option value="Cheap">Cheap（廉快）</option>
                    </select>
                </div>
            </div>

            <!-- ② 可靠性与预算 -->
            <div class="sub-card">
                <div class="card-label" style="margin-bottom: 8px;">🛡️ 可靠性与预算</div>
                <div class="config-group-header">故障转移</div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableFailover)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">故障转移</span>
                            <span class="item-desc">首选模型失败自动降级到下一候选（含凭证失效 401/403 降级）。</span>
                        </div>
                        <label class="toggle-switch" title="首选模型失败自动降级到下一候选。">
                            <input type="checkbox" @bind="Cfg.EnableFailover" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.FailoverFailureThreshold)) ? "dirty-field" : "") @(IsDirty(nameof(ConfigForm.FailoverCooldownSeconds)) ? "dirty-field" : "") @(IsDirty(nameof(ConfigForm.FailoverGlobalTimeoutSeconds)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">熔断参数</span>
                            <span class="item-desc">连续失败 N 次熔断进入隔离；冷却期后半开探测，成功才恢复全流量；全局超时兜底防无限等待。</span>
                        </div>
                        <div class="config-row">
                            <span class="config-row-label">失败阈值:</span>
                            <input type="number" step="1" min="1" @bind="Cfg.FailoverFailureThreshold" class="form-control" style="width: 70px;" />
                            <span class="config-row-label">冷却 (秒):</span>
                            <input type="number" step="10" min="1" @bind="Cfg.FailoverCooldownSeconds" class="form-control" style="width: 80px;" />
                            <span class="config-row-label">全局超时 (秒):</span>
                            <input type="number" step="10" min="0" @bind="Cfg.FailoverGlobalTimeoutSeconds" class="form-control" style="width: 80px;" />
                        </div>
                    </div>
                </div>

                <div class="config-group-header">预算防护</div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableBudgetGuard)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">预算防护</span>
                            <span class="item-desc">按日预算约束路由（耗尽时降级或拒绝）。</span>
                        </div>
                        <label class="toggle-switch" title="按日预算约束路由。">
                            <input type="checkbox" @bind="Cfg.EnableBudgetGuard" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.DailyBudgetUsd)) ? "dirty-field" : "") @(IsDirty(nameof(ConfigForm.EnforceOnExhausted)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">日预算约束</span>
                            <span class="item-desc">预算耗尽后的策略。</span>
                        </div>
                        <div class="config-row">
                            <span class="config-row-label">日预算 (USD):</span>
                            <input type="number" step="1.0" min="0" @bind="Cfg.DailyBudgetUsd" class="form-control" style="width: 100px; color: var(--success); font-weight: 600;" />
                            <select @bind="Cfg.EnforceOnExhausted" class="form-control" style="width: auto; min-width: 180px;">
                                <option value="Degrade">Degrade (降级至 Cheap)</option>
                                <option value="Reject">Reject (直接拒绝 429)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="config-group-header">健康探测</div>
                <div class="config-item @(IsDirty(nameof(ConfigForm.EnableHealthProbe)) ? "dirty-field" : "")">
                    <div class="item-text">
                        <span class="item-title">后台健康探测</span>
                        <span class="item-desc">周期探测所有模型并上报断路器，坏模型提前熔断。默认开。</span>
                    </div>
                    <label class="toggle-switch" title="周期探测所有模型并上报断路器，坏模型提前熔断。默认开。">
                        <input type="checkbox" @bind="Cfg.EnableHealthProbe" />
                        <span class="toggle-track"><span class="toggle-thumb"></span></span>
                    </label>
                </div>
            </div>

            <!-- ③ 学习与优化 -->
            <div class="sub-card">
                <div class="card-label" style="margin-bottom: 8px;">🧠 学习与优化</div>
                <div class="config-group-header">强化学习</div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableThompsonSampling)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">Thompson 采样重排</span>
                            <span class="item-desc">按历史奖励自动学习排序模型，简单稳健。</span>
                        </div>
                        <label class="toggle-switch" title="按历史奖励自动学习排序模型，简单稳健。">
                            <input type="checkbox" checked="@Cfg.EnableThompsonSampling" @onchange="@(e => OnThompsonToggled(e.Value is true))" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableContextualBandit)) ? "dirty-field" : "") @(Cfg.EnableThompsonSampling ? "is-disabled" : "")">
                        <div class="item-text">
                            <span class="item-title">Contextual Bandit (LinUCB)</span>
                            <span class="item-desc">二选一：按请求特征（档位/延迟/复杂度）精细决策，需更多流量。</span>
                        </div>
                        <label class="toggle-switch" title="按请求特征精细决策，需更多流量。与 Thompson 二选一。">
                            <input type="checkbox" checked="@Cfg.EnableContextualBandit" disabled="@Cfg.EnableThompsonSampling" @onchange="@(e => OnBanditToggled(e.Value is true))" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.ExplorationEpsilon)) ? "dirty-field" : "") @(IsDirty(nameof(ConfigForm.ExplorationStarvedN)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">探索策略</span>
                            <span class="item-desc">ε 探索保底 + 饥饿定向阈值。</span>
                        </div>
                        <div class="config-row">
                            <span class="config-row-label">ε 探索保底:</span>
                            <input type="number" step="0.01" min="0" max="1" @bind="Cfg.ExplorationEpsilon" class="form-control" style="width: 80px;" />
                            <span class="config-row-label">饥饿定向阈值 N:</span>
                            <input type="number" step="1" min="0" @bind="Cfg.ExplorationStarvedN" class="form-control" style="width: 80px;" />
                        </div>
                    </div>
                </div>

                <div class="config-group-header">响应缓存</div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableResponseCache)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">精确响应缓存</span>
                            <span class="item-desc">同请求原文直接返回缓存答案（仅非流式），零上游成本。</span>
                        </div>
                        <label class="toggle-switch" title="同请求原文直接返回缓存答案。仅非流式。">
                            <input type="checkbox" @bind="Cfg.EnableResponseCache" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.ResponseCacheTtlSeconds)) ? "dirty-field" : "") @(IsDirty(nameof(ConfigForm.ResponseCacheMaxEntries)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">缓存容量</span>
                            <span class="item-desc">TTL 与最大条目数。</span>
                        </div>
                        <div class="config-row">
                            <span class="config-row-label">TTL (秒):</span>
                            <input type="number" step="60" min="1" @bind="Cfg.ResponseCacheTtlSeconds" class="form-control" style="width: 90px;" />
                            <span class="config-row-label">最大条目:</span>
                            <input type="number" step="100" min="1" @bind="Cfg.ResponseCacheMaxEntries" class="form-control" style="width: 90px;" />
                        </div>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableSemanticCache)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">语义缓存</span>
                            <span class="item-desc">相似问法（非完全相同）命中也返回缓存答案。阈值调低命中率升但答案相关性降。</span>
                        </div>
                        <label class="toggle-switch" title="相似问法命中缓存。阈值调低命中率升但相关性降。">
                            <input type="checkbox" @bind="Cfg.EnableSemanticCache" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.SemanticCacheSimilarityThreshold)) ? "dirty-field" : "") @(IsDirty(nameof(ConfigForm.SemanticCacheTtlMinutes)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">语义缓存参数</span>
                            <span class="item-desc">相似度阈值与 TTL。</span>
                        </div>
                        <div class="config-row">
                            <span class="config-row-label">相似度阈值:</span>
                            <input type="number" step="0.01" min="0.5" max="1" @bind="Cfg.SemanticCacheSimilarityThreshold" class="form-control" style="width: 80px;" />
                            <span class="config-row-label">TTL (分):</span>
                            <input type="number" step="10" min="1" @bind="Cfg.SemanticCacheTtlMinutes" class="form-control" style="width: 80px;" />
                        </div>
                    </div>
                </div>

                <div class="config-group-header">自校验与反馈</div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableCascadeUpgrade)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">级联自校验升级</span>
                            <span class="item-desc">Cheap 首答后自校验，低置信升级 Strong 重答——省钱但多一次调用。</span>
                        </div>
                        <label class="toggle-switch" title="Cheap 首答后自校验，低置信升级 Strong 重答。">
                            <input type="checkbox" @bind="Cfg.EnableCascadeUpgrade" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.CascadeUpgradeSampleRate)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">级联采样率</span>
                            <span class="item-desc">触发级联升级的采样比例。</span>
                        </div>
                        <div class="config-row">
                            <span class="config-row-label">采样率:</span>
                            <input type="number" step="0.05" min="0.05" max="1" @bind="Cfg.CascadeUpgradeSampleRate" class="form-control" style="width: 80px;" />
                        </div>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableRegenerateFeedback)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">重发负反馈学习</span>
                            <span class="item-desc">用户重发同一问题 = 对上次答案不满，惩罚上次模型。</span>
                        </div>
                        <label class="toggle-switch" title="用户重发同一问题时惩罚上次模型。">
                            <input type="checkbox" @bind="Cfg.EnableRegenerateFeedback" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- ④ 合规与安全 -->
            <div class="sub-card">
                <div class="card-label" style="margin-bottom: 8px;">🔒 合规与安全</div>
                <div class="config-group-header">数据与隐私</div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnablePiiAnonymization)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">PII 隐私脱敏</span>
                            <span class="item-desc">发送上游前替换手机号/身份证等敏感数据，返回时还原。默认关：会改变上游看到的原文，影响缓存命中与模型理解。</span>
                        </div>
                        <label class="toggle-switch" title="发送上游前替换敏感数据，返回时还原。默认关。">
                            <input type="checkbox" @bind="Cfg.EnablePiiAnonymization" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableDataSovereignty)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">数据不出域隔离</span>
                            <span class="item-desc">带敏感标记的请求只路由到本地/私有部署模型（需模型勾选 IsLocalOrPrivate）。默认关。</span>
                        </div>
                        <label class="toggle-switch" title="带敏感标记的请求只路由到本地/私有部署模型。默认关。">
                            <input type="checkbox" @bind="Cfg.EnableDataSovereignty" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                </div>

                <div class="config-group-header">内容审核</div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableContentModeration)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">内容审核</span>
                            <span class="item-desc">输入/输出过审核 API 判违规。需先在 appsettings 配置 ModerationEndpoint 与 ApiKey，否则保存会被校验拒绝。</span>
                        </div>
                        <label class="toggle-switch" title="输入/输出过审核 API 判违规。需先配置 ModerationEndpoint 与 ApiKey。">
                            <input type="checkbox" @bind="Cfg.EnableContentModeration" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.ModerationSampleRate)) ? "dirty-field" : "") @(IsDirty(nameof(ConfigForm.ModerationThreshold)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">审核参数</span>
                            <span class="item-desc">采样率与违规阈值。</span>
                        </div>
                        <div class="config-row">
                            <span class="config-row-label">采样率:</span>
                            <input type="number" step="0.1" min="0.1" max="1" @bind="Cfg.ModerationSampleRate" class="form-control" style="width: 80px;" />
                            <span class="config-row-label">违规阈值:</span>
                            <input type="number" step="0.05" min="0.5" max="1" @bind="Cfg.ModerationThreshold" class="form-control" style="width: 80px;" />
                        </div>
                    </div>
                </div>

                <div class="config-group-header">流式与输出安全</div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableStreamingComplianceFilter)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">流式敏感词过滤</span>
                            <span class="item-desc">流式输出滑动窗口扫描敏感词，命中阻断或脱敏（不依赖外部审核 API）。</span>
                        </div>
                        <label class="toggle-switch" title="流式输出滑动窗口扫描敏感词。">
                            <input type="checkbox" @bind="Cfg.EnableStreamingComplianceFilter" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnablePersonaDriftProtection)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">Persona 漂移保护</span>
                            <span class="item-desc">多轮会话自动注入人设锚点，防止模型换档后性格/格式突变。默认关（会改变请求原文，影响上游缓存前缀）。</span>
                        </div>
                        <label class="toggle-switch" title="多轮会话自动注入人设锚点。默认关。">
                            <input type="checkbox" @bind="Cfg.EnablePersonaDriftProtection" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnablePromptCompression)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">提示词压缩</span>
                            <span class="item-desc">长上下文先裁剪再发上游，省 token 但可能丢细节。</span>
                        </div>
                        <label class="toggle-switch" title="长上下文先裁剪再发上游。">
                            <input type="checkbox" @bind="Cfg.EnablePromptCompression" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- ⑤ 高级编排 -->
            <div class="sub-card">
                <div class="card-label" style="margin-bottom: 8px;">⚡ 高级编排</div>
                <div class="config-group-header">Fusion MoA</div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableFusionRouter)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">Fusion MoA 融合路由</span>
                            <span class="item-desc">多模型并行作答 + 仲裁 + 合成，质量最高但成本 ×N。需 ≥2 个启用模型，仅非流式。</span>
                        </div>
                        <label class="toggle-switch" title="多模型并行作答 + 仲裁 + 合成。需 ≥2 个启用模型，仅非流式。">
                            <input type="checkbox" @bind="Cfg.EnableFusionRouter" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.FusionRouterMinComplexity)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">触发最低复杂度</span>
                            <span class="item-desc">Fusion 仅在复杂度达到阈值时触发。</span>
                        </div>
                        <select @bind="Cfg.FusionRouterMinComplexity" class="form-control" style="width: auto; min-width: 200px;">
                            <option value="Unknown">Unknown（全部请求）</option>
                            <option value="Simple">Simple 以上</option>
                            <option value="Standard">Standard 以上</option>
                            <option value="Complex">仅 Complex</option>
                        </select>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableByzantineConsensus)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">拜占庭共识短路</span>
                            <span class="item-desc">Fusion 面板答案一致时直接采纳，跳过仲裁与合成（N+2 → N 次调用）。仅 Fusion 开启时有效。</span>
                        </div>
                        <label class="toggle-switch" title="Fusion 面板答案一致时直接采纳，跳过仲裁与合成。">
                            <input type="checkbox" @bind="Cfg.EnableByzantineConsensus" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.FusionRouterPanelSize)) ? "dirty-field" : "") @(IsDirty(nameof(ConfigForm.FusionRouterMinPanelSize)) ? "dirty-field" : "") @(IsDirty(nameof(ConfigForm.EnableDynamicFusionPanelSize)) ? "dirty-field" : "") @(IsDirty(nameof(ConfigForm.EnableFusionDiversity)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">面板规模</span>
                            <span class="item-desc">panel 模型数 [2,5]，取候选链前 N。动态规模按请求复杂度在最小值与设定值之间伸缩；供应商多样性避免 panel 同源。</span>
                        </div>
                        <div class="config-row">
                            <span class="config-row-label">Panel 数:</span>
                            <input type="number" step="1" min="2" max="5" @bind="Cfg.FusionRouterPanelSize" class="form-control" style="width: 60px;" />
                            <label class="toggle-switch" title="按请求复杂度动态决定 panel 数量。">
                                <input type="checkbox" @bind="Cfg.EnableDynamicFusionPanelSize" />
                                <span class="toggle-track"><span class="toggle-thumb"></span></span>
                            </label>
                            <span class="config-row-label">动态最小:</span>
                            <input type="number" step="1" min="2" max="5" @bind="Cfg.FusionRouterMinPanelSize" class="form-control" style="width: 60px;" />
                            <label class="toggle-switch" title="panel 候选尽量跨供应商/模型家族。">
                                <input type="checkbox" @bind="Cfg.EnableFusionDiversity" />
                                <span class="toggle-track"><span class="toggle-thumb"></span></span>
                            </label>
                            <span class="config-row-label">多样性</span>
                        </div>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.FusionRouterAnalystModel)) ? "dirty-field" : "") @(IsDirty(nameof(ConfigForm.FusionRouterOuterModel)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">仲裁与撰写模型</span>
                            <span class="item-desc">analyst 读全部 panel 回答产出结构化分析；outer 依分析写最终答案。留空（默认）= 主候选兼任。</span>
                        </div>
                        <div class="config-row">
                            <span class="config-row-label">Analyst:</span>
                            <select @bind="Cfg.FusionRouterAnalystModel" class="form-control" style="width: auto; min-width: 170px;">
                                <option value="">默认（主候选）</option>
                                @foreach (var m in FusionModelOptions)
                                {
                                    <option value="@m">@m</option>
                                }
                            </select>
                            <span class="config-row-label">Outer:</span>
                            <select @bind="Cfg.FusionRouterOuterModel" class="form-control" style="width: auto; min-width: 170px;">
                                <option value="">默认（主候选）</option>
                                @foreach (var m in FusionModelOptions)
                                {
                                    <option value="@m">@m</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.FusionRouterMaxOutputTokens)) ? "dirty-field" : "") @(IsDirty(nameof(ConfigForm.FusionRouterTemperature)) ? "dirty-field" : "") @(IsDirty(nameof(ConfigForm.FusionRouterPanelTemperature)) ? "dirty-field" : "") @(IsDirty(nameof(ConfigForm.FusionRouterPanelTimeoutSeconds)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">采样与预算</span>
                            <span class="item-desc">outer 最大输出 token；温度 [0,2]（panel 温度留空沿用主温度）；panel 单次超时秒数（0 = 不额外限制）。</span>
                        </div>
                        <div class="config-row">
                            <span class="config-row-label">最大输出:</span>
                            <input type="number" step="1000" min="1" @bind="Cfg.FusionRouterMaxOutputTokens" class="form-control" style="width: 90px;" />
                            <span class="config-row-label">温度:</span>
                            <input type="number" step="0.1" min="0" max="2" @bind="Cfg.FusionRouterTemperature" class="form-control" style="width: 64px;" />
                            <span class="config-row-label">Panel 温度:</span>
                            <input type="number" step="0.1" min="0" max="2" @bind="Cfg.FusionRouterPanelTemperature" class="form-control" style="width: 64px;" />
                            <span class="config-row-label">Panel 超时 (秒):</span>
                            <input type="number" step="10" min="0" @bind="Cfg.FusionRouterPanelTimeoutSeconds" class="form-control" style="width: 70px;" />
                        </div>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.FusionRouterAnalystPrompt)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">Analyst 分析提示词</span>
                            <span class="item-desc">留空使用内置 JSON 契约提示词（共识/矛盾/缺口/洞察）。自定义时需保持输出为可解析 JSON。</span>
                        </div>
                        <textarea class="form-control" rows="3" @bind="Cfg.FusionRouterAnalystPrompt" placeholder="留空使用内置提示词" style="width: 100%; min-height: 60px; font-size: 0.82rem; font-family: 'JetBrains Mono', monospace;"></textarea>
                    </div>
                </div>

                <div class="config-group-header">并行竞速</div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableFusionMode)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">并行竞速 (Race)</span>
                            <span class="item-desc">前 N 候选同时发起取最快成功。延迟最低但失败候选也计费。仅非流式。</span>
                        </div>
                        <label class="toggle-switch" title="前 N 候选同时发起取最快成功。仅非流式。">
                            <input type="checkbox" @bind="Cfg.EnableFusionMode" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.FusionMaxParallel)) ? "dirty-field" : "") @(IsDirty(nameof(ConfigForm.FusionHedgeDelayMs)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">竞速参数</span>
                            <span class="item-desc">首轮并发数 [2,5]；Hedge 延迟 &gt;0 时仅在主请求慢于该阈值才启动备选（对冲请求，显著省钱）。0 = 总是并行。</span>
                        </div>
                        <div class="config-row">
                            <span class="config-row-label">并发数:</span>
                            <input type="number" step="1" min="2" max="5" @bind="Cfg.FusionMaxParallel" class="form-control" style="width: 60px;" />
                            <span class="config-row-label">Hedge 延迟 (ms):</span>
                            <input type="number" step="100" min="0" @bind="Cfg.FusionHedgeDelayMs" class="form-control" style="width: 90px;" />
                        </div>
                    </div>
                </div>

                <div class="config-group-header">输出修复</div>
                <div class="config-item @(IsDirty(nameof(ConfigForm.EnableJsonAstAutoRepair)) ? "dirty-field" : "")">
                    <div class="item-text">
                        <span class="item-title">JSON AST 自动修复</span>
                        <span class="item-desc">上游输出 JSON 损坏时自动修复再返回，减少工具调用解析失败。默认开。</span>
                    </div>
                    <label class="toggle-switch" title="上游输出 JSON 损坏时自动修复再返回。默认开。">
                        <input type="checkbox" @bind="Cfg.EnableJsonAstAutoRepair" />
                        <span class="toggle-track"><span class="toggle-thumb"></span></span>
                    </label>
                </div>
            </div>

            <!-- ⑥ 观测 -->
            <div class="sub-card">
                <div class="card-label" style="margin-bottom: 8px;">📊 观测</div>
                <div class="config-group-header">链路与审计</div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div class="config-item @(IsDirty(nameof(ConfigForm.EnableDistributedTracing)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">分布式链路追踪</span>
                            <span class="item-desc">解析 W3C traceparent 并贯穿 Fusion/Cascade 审计（DAG 甘特图数据源）。</span>
                        </div>
                        <label class="toggle-switch" title="解析 W3C traceparent 并贯穿 Fusion/Cascade 审计。">
                            <input type="checkbox" @bind="Cfg.EnableDistributedTracing" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.AuditStoreRequestContent)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">审计记录请求内容</span>
                            <span class="item-desc">审计表保存用户 prompt 摘要（500 字符），供请求页排查。默认关闭；管理员可显式开启，关闭则只记元数据。</span>
                        </div>
                        <label class="toggle-switch" title="审计表保存用户 prompt 摘要。默认关闭；管理员可显式开启，关闭则只记元数据。">
                            <input type="checkbox" @bind="Cfg.AuditStoreRequestContent" />
                            <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        </label>
                    </div>
                    <div class="config-item @(IsDirty(nameof(ConfigForm.AuditRetentionHours)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">审计保留时长</span>
                            <span class="item-desc">审计记录保留小时数（默认 168 = 7 天），后台周期淘汰过期记录防止无界增长。0 = 永久保留。</span>
                        </div>
                        <div class="config-row">
                            <span class="config-row-label">保留 (小时):</span>
                            <input type="number" step="24" min="0" @bind="Cfg.AuditRetentionHours" class="form-control" style="width: 80px;" />
                        </div>
                    </div>
                </div>

                <div class="config-group-header">告警订阅</div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                    <div class="config-item @(IsDirty(nameof(ConfigForm.AlertWebhookUrl)) ? "dirty-field" : "") @(IsDirty(nameof(ConfigForm.AlertWebhookIntervalSeconds)) ? "dirty-field" : "")">
                        <div class="item-text">
                            <span class="item-title">告警 Webhook 推送</span>
                            <span class="item-desc">新告警推送 alert 事件、恢复推送 resolved 事件到任意 HTTP 端点（Slack/钉钉/飞书/自建）。URL 留空 = 仅 Dashboard 展示。保存后热生效，无需重启。</span>
                        </div>
                        <div class="config-row" style="flex-wrap: wrap;">
                            <input type="text" @bind="Cfg.AlertWebhookUrl" class="form-control" placeholder="https://hooks.example.com/..." style="width: 260px;" />
                            <span class="config-row-label">检查间隔 (秒):</span>
                            <input type="number" step="5" min="5" @bind="Cfg.AlertWebhookIntervalSeconds" class="form-control" style="width: 70px;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 配置变更审计历史：谁在何时改了哪项路由/预算配置（最近 200 次落库） -->
    <div class="glass-card">
        <div class="card-label" style="display: flex; justify-content: space-between; align-items: center;">
            <span>📝 配置变更历史 (Config Change Audit)</span>
            <button class="btn-ghost btn-sm" @onclick="LoadConfigChanges">↻ 刷新</button>
        </div>
        @if (ConfigChanges.Any())
        {
            <div class="table-wrap">
                <table class="config-table">
                    <thead>
                        <tr><th scope="col">时间</th><th scope="col">操作者</th><th scope="col">变更项</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in ConfigChanges)
                        {
                            <tr>
                                <td style="white-space: nowrap;">@FormatConfigChangeTime(c.Timestamp)</td>
                                <td>@c.Actor</td>
                                <td>
                                    @if (c.Changes.ValueKind == System.Text.Json.JsonValueKind.Array)
                                    {
                                        @foreach (var change in c.Changes.EnumerateArray())
                                        {
                                            <div style="font-size: 0.8rem;">
                                                <span class="table-mono" style="color: var(--primary);">@FormatConfigKey(change)</span>
                                                <span class="text-secondary">：</span>
                                                <span class="table-mono" style="color: var(--text-secondary); text-decoration: line-through;">@FormatConfigValue(change, "from")</span>
                                                <span class="text-secondary"> → </span>
                                                <span class="table-mono" style="color: var(--success); font-weight: 600;">@FormatConfigValue(change, "to")</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-secondary" style="font-size: 0.8rem;">@c.Changes.ToString()</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-secondary text-center" style="padding: 16px;">暂无配置变更记录（首次保存配置后在此留痕）。</div>
        }
    </div>

    <!-- Thompson 学习状态监控 -->
    <div class="glass-card">
        <div class="card-label">
            <span>🧠 强化学习状态监控 (Thompson Sampling Explorer)</span>
            <span style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                <span class="tag @(Metrics?.System.Routing.EnableLatencyAware == true ? "tag-success" : "tag-warning")">
                    延迟感知重排 @(Metrics?.System.Routing.EnableLatencyAware == true ? "已启用" : "未启用")
                </span>
                <button class="btn-ghost btn-sm" @onclick="ExportLearningCsv">⬇ 导出 CSV</button>
                <button class="btn-danger btn-sm" @onclick="ResetLearningState">↺ 重置学习状态</button>
            </span>
        </div>
        @if (!string.IsNullOrEmpty(LearningStatusMsg))
        {
            <div class="alert-banner @(LearningStatusOk ? "alert-success" : "alert-error")" style="margin: 8px 0; padding: 6px 12px; font-size: 0.82rem;">@LearningStatusMsg</div>
        }
        @if (LearningStates.Any())
        {
            <div class="table-wrap">
                <table class="config-table">
                    <thead>
                        <tr>
                            <th scope="col">模型</th>
                            <th scope="col">期望奖励均值 (α/(α+β))</th>
                            <th scope="col">α / β</th>
                            <th scope="col">样本数</th>
                            <th scope="col">最后更新</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in LearningStates)
                        {
                            string meanColor = s.Mean >= 0.6 ? "var(--success)" : s.Mean >= 0.35 ? "var(--warning)" : "var(--danger)";
                            <tr>
                                <td>
                                    <strong>@s.Model</strong>
                                    @if (s.Samples == 0)
                                    {
                                        <span class="tag tag-warning" style="margin-left: 6px; font-size: 0.7rem;">饥饿</span>
                                    }
                                </td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div style="flex: 1; min-width: 80px; background: var(--bg-input); border-radius: var(--radius-full); height: 10px; overflow: hidden;">
                                            <div style="background: @meanColor; width: @(Math.Clamp(s.Mean * 100, 2, 100).ToString("F0"))%; height: 100%; border-radius: var(--radius-full); transition: width 0.3s ease;"></div>
                                        </div>
                                        <span class="table-mono" style="width: 52px; color: @meanColor;">@s.Mean.ToString("F3")</span>
                                    </div>
                                </td>
                                <td class="table-mono">@s.Alpha.ToString("F2") / @s.Beta.ToString("F2")</td>
                                <td>@s.Samples.ToString("N0")</td>
                                <td class="text-secondary">@(s.LastUpdateUtc.Year > 1 ? s.LastUpdateUtc.ToLocalTime().ToString("MM-dd HH:mm:ss") : "--")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="meta-text">
                样本数为进程内计数（重启归零）；标"饥饿"的模型长期拿不到流量，学习重排对它无据可依，需配合 ExplorationEpsilon 探索或流量再分配。
            </div>
        }
        else
        {
            <div class="text-secondary text-center" style="padding: 16px;">暂无 Thompson 学习状态数据</div>
        }
    </div>

    <!-- 语义路由规则管理 -->
    <div class="glass-card">
        <div class="card-label">
            <span>🧭 语义路由规则工作室 (Semantic Routes Studio)</span>
            <span class="tag @(SemanticRouterEnabled ? "tag-success" : "tag-warning")">
                语义路由 @(SemanticRouterEnabled ? "已启用" : "未启用") · 阈值 @SemanticThreshold.ToString("F2")
            </span>
        </div>
        @if (!string.IsNullOrEmpty(SrStatusMsg))
        {
            <div class="alert-banner @(SrStatusOk ? "alert-success" : "alert-error")" style="margin: 8px 0; padding: 6px 12px; font-size: 0.82rem;">@SrStatusMsg</div>
        }

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 12px; margin-top: 10px;">
            <!-- 规则列表（本地暂存，保存才落盘） -->
            <div class="sub-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">
                    <span style="font-weight: 600; font-size: 0.9rem;">规则列表 (@SemanticRoutes.Count)</span>
                    <button class="btn-primary btn-sm" @onclick="SaveSemanticRoutes" disabled="@IsSrSaving">
                        @(IsSrSaving ? "保存中..." : "💾 保存全部并热生效")
                    </button>
                </div>
                @if (SemanticRoutes.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        @foreach (var route in SemanticRoutes)
                        {
                            <div class="sub-card" style="padding: 8px 12px; display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap;">
                                <div style="min-width: 0; flex: 1;">
                                    <div style="display: flex; gap: 8px; align-items: center;">
                                        <strong>@route.Name</strong>
                                        <span class="badge badge-info">@route.TargetTier</span>
                                    </div>
                                    <div class="meta-text" style="font-size: 0.72rem; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        @(string.Join(" | ", route.Phrases))
                                    </div>
                                </div>
                                <div style="display: flex; gap: 6px;">
                                    <button class="btn-ghost btn-sm" @onclick="() => EditSemanticRoute(route)">编辑</button>
                                    <button class="btn-danger btn-sm" @onclick="() => RemoveSemanticRoute(route)">删除</button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-secondary text-center" style="padding: 16px; font-size: 0.85rem;">暂无规则——规则表为空时语义路由自动跳过。</div>
                }
            </div>

            <!-- 新增 / 编辑表单 -->
            <div class="sub-card">
                <div style="font-weight: 600; font-size: 0.9rem; margin-bottom: 8px;">@(SrEditingName is null ? "➕ 添加规则" : $"✏️ 编辑规则: {SrEditingName}")</div>
                @if (SrEditingName is not null)
                {
                    <div class="meta-text" style="font-size: 0.72rem; margin-bottom: 8px;">修改名称等同删除旧规则并新建。</div>
                }
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <input type="text" class="form-control" placeholder="规则名称（如: code-generation）" @bind="SrName" />
                    <select class="form-control" @bind="SrTier">
                        <option value="Strong">Strong（强模型档）</option>
                        <option value="Medium">Medium（中档）</option>
                        <option value="Cheap">Cheap（廉价快速档）</option>
                    </select>
                    <textarea class="form-control" rows="4" placeholder="示例短语，每行一条（如：写一个实现快速排序的函数）" @bind="SrPhrases"></textarea>
                    <div style="display: flex; gap: 8px; justify-content: flex-end;">
                        @if (SrEditingName is not null)
                        {
                            <button class="btn-ghost btn-sm" @onclick="CancelSemanticRouteEdit">取消编辑</button>
                        }
                        <button class="btn-primary btn-sm" @onclick="ApplySemanticRouteForm">@(SrEditingName is null ? "加入列表" : "更新规则")</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="meta-text" style="margin-top: 8px;">
            增删改先暂存本地，「保存全部」才写入配置库并热生效（策略每请求读取路由表）；相似度阈值与开关在上方配置台调整。
        </div>
    </div>

    <!-- 分布式 DAG 链路拓扑与 Fusion MoA 瀑布流 -->
    <div class="glass-card">
        <div class="card-label">
            <span>分布式 DAG 链路拓扑与 Fusion MoA 甘特图 (DAG Trace Visualizer)</span>
            <span class="tag tag-info">W3C Traceparent 标准</span>
        </div>
        @if (Metrics?.System.DagTraces != null && Metrics.System.DagTraces.Any())
        {
            @foreach (var dag in Metrics.System.DagTraces)
            {
                <div class="sub-card" style="margin-top: 12px;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">
                        <span class="table-mono" style="color: var(--primary); font-weight: 600;">Group ID: @Truncate(dag.GroupId ?? "-", 16)</span>
                        <span style="color: var(--success); font-weight: 600;">DAG 总成本: $@dag.TotalCost.ToString("F6") | 最大延迟: @dag.MaxLatencyMs.ToString("F0") ms</span>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        @foreach (var span in dag.Spans)
                        {
                            double widthPct = dag.MaxLatencyMs > 0 ? Math.Min(100.0, Math.Max(10.0, (span.LatencyMs / dag.MaxLatencyMs) * 100.0)) : 100.0;
                            string roleBg = span.Role switch
                            {
                                "panel" => "var(--primary)",
                                "analyst" => "var(--purple)",
                                "outer" => "var(--success)",
                                "cascade" => "var(--warning)",
                                _ => "var(--text-muted)"
                            };
                            <div style="display: flex; align-items: center; gap: 10px; font-size: 0.82rem;">
                                <span style="width: 80px; text-transform: uppercase; font-weight: 600; color: @roleBg;">[@span.Role]</span>
                                <span style="width: 120px; font-weight: 500; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">@span.Model</span>
                                <div style="flex: 1; background: var(--bg-input); border-radius: var(--radius-full); height: 14px; overflow: hidden; position: relative;">
                                    <div style="background: @roleBg; width: @widthPct.ToString("F0")%; height: 100%; border-radius: var(--radius-full); transition: width 0.3s ease;"></div>
                                </div>
                                <span style="width: 90px; text-align: right; color: var(--text-secondary); font-family: 'JetBrains Mono', monospace;">@span.LatencyMs.ToString("F0") ms</span>
                                <span style="width: 80px; text-align: right; color: var(--success); font-family: 'JetBrains Mono', monospace; font-weight: 600;">$@span.Cost.ToString("F6")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-secondary text-center" style="padding: 16px;">暂无 Fusion / Cascade DAG Trace 采样数据</div>
        }
    </div>

    <!-- 交互式路由匹配沙盒 -->
    <div class="glass-card">
        <div class="card-label">
            <span>交互式路由决策沙盒 (Route Playground Sandbox)</span>
            <span class="tag tag-success">即时路由仿真</span>
        </div>
        <div style="margin-top: 10px; display: flex; gap: 12px; flex-direction: column;">
            <textarea class="form-control" rows="3" placeholder="在此输入测试 Prompt（如：写个快速排序、求微积分积分、翻译文本...）" @bind="SandboxInputPrompt"></textarea>
            <div style="display: flex; justify-content: flex-end;">
                <button class="btn-primary" @onclick="RunSandbox" disabled="@IsSandboxRunning">
                    @(IsSandboxRunning ? "路由仿真中..." : "🚀 运行路由匹配测试")
                </button>
            </div>
            @if (!string.IsNullOrEmpty(SandboxError))
            {
                <div class="alert-banner alert-error" style="margin: 8px 0; padding: 6px 12px; font-size: 0.82rem;">✗ 路由仿真失败：@SandboxError</div>
            }
        </div>
        @if (SandboxResultData != null)
        {
            <div class="sub-card" style="margin-top: 12px;">
                <div style="display: flex; gap: 14px; align-items: center; margin-bottom: 10px; flex-wrap: wrap;">
                    <span style="font-weight: 600;">命中 Target Tier:</span>
                    <span class="badge badge-info" style="font-size: 0.85rem;">@SandboxResultData.TargetTier</span>
                    <span class="text-secondary" style="font-size: 0.82rem;">估算 Prompt Tokens: @SandboxResultData.EstimatedTokens</span>
                </div>
                <div style="margin-bottom: 8px; font-size: 0.82rem; color: var(--text-secondary);">
                    <strong style="color: var(--text-primary);">匹配 Policy 逻辑链：</strong>
                    <ul style="margin: 4px 0 0 16px; padding: 0;">
                        @foreach (var reason in SandboxResultData.Reasons)
                        {
                            <li><span style="color: var(--primary);">[@reason.PolicyName]</span> @reason.Message</li>
                        }
                    </ul>
                </div>
                <div style="font-size: 0.82rem; color: var(--success); font-weight: 500;">
                    <strong style="color: var(--text-primary);">推荐模型候选链：</strong> @string.Join(" → ", SandboxResultData.CandidateModels)
                </div>
            </div>
        }
    </div>

    <!-- Golden Dataset 离线回归评测中心 -->
    <div class="glass-card">
        <div class="card-label">
            <span>Golden Dataset 离线回归评测工作室 (Eval Studio)</span>
            <button class="btn-primary btn-sm" @onclick="RunEval" disabled="@IsEvalRunning">
                @(IsEvalRunning ? "自动化评测中..." : "🧪 一键运行回归评测")
            </button>
        </div>
        <div class="meta-text" style="margin-top: 6px;">评测经真实路由管线执行（路由 → 上游 → 计费 → 审计），非桩仿真；运行消耗计入当日预算与审计日志。</div>
        @if (!string.IsNullOrEmpty(EvalStatusMsg))
        {
            <div class="alert-banner @(EvalStatusOk ? "alert-success" : "alert-error")" style="margin: 8px 0; padding: 6px 12px; font-size: 0.82rem;">@EvalStatusMsg</div>
        }

        <div style="display: flex; gap: 8px; margin-top: 10px; align-items: center; flex-wrap: wrap;">
            <button class="btn-ghost btn-sm" @onclick="ToggleCustomCases">@(ShowCustomCases ? "- 收起自定义题库" : "+ 自定义题库 (JSON)")</button>
            <span class="text-secondary" style="font-size: 0.78rem;">不填则使用内置 4 题黄金集；每条需含 question 与 expectedAnswer，上限 50 条</span>
        </div>
        @if (ShowCustomCases)
        {
            <textarea class="form-control" rows="6" style="margin-top: 8px; font-size: 0.78rem;" placeholder='[{"id":"q1","question":"你的问题","expectedAnswer":"期望答案要点","category":"math","maxLatencyThresholdMs":5000}]' @bind="CustomCasesJson"></textarea>
            <div style="display: flex; justify-content: flex-end; margin-top: 6px;">
                <button class="btn-ghost btn-sm" @onclick="FillSampleCases">填入示例</button>
            </div>
        }

        @if (EvalReportData != null)
        {
            <div class="sub-card" style="margin-top: 12px;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 12px; align-items: center; flex-wrap: wrap; gap: 8px;">
                    <span class="table-mono" style="color: var(--purple); font-weight: 600;">Batch ID: @EvalReportData.BatchId</span>
                    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                        <span class="tag tag-success">通过率: @((EvalReportData.AccuracyRate * 100).ToString("F1"))%</span>
                        <span class="tag tag-info">平均延迟: @EvalReportData.AvgLatencyMs.ToString("F0") ms</span>
                        <span class="tag tag-secondary">总 Tokens: @EvalReportData.TotalTokens.ToString("N0")</span>
                        <span class="tag tag-secondary">总成本: $@EvalReportData.TotalCost.ToString("F4")</span>
                    </div>
                </div>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    @foreach (var res in EvalReportData.Results)
                    {
                        <div class="sub-card" style="padding: 8px 12px; font-size: 0.82rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                            <div>
                                <span style="color: var(--text-primary); font-weight: 600;">[@res.TestCase.Category] @res.TestCase.Question</span>
                                <div style="color: var(--text-muted); font-size: 0.75rem; margin-top: 2px;">
                                    输出: @Truncate(res.ActualAnswer, 40)
                                    @if (!string.IsNullOrEmpty(res.SelectedModel))
                                    {
                                        <span style="margin-left: 6px; color: var(--primary);">↳ @res.SelectedModel ($@res.Cost.ToString("F6"))</span>
                                    }
                                </div>
                            </div>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <span style="color: var(--primary); font-size: 0.8rem;">Jaccard: @((res.SimilarityScore * 100).ToString("F0"))%</span>
                                <span class="@(res.Passed ? "text-success" : "text-danger")" style="font-weight: 600;">@(res.Passed ? "✓ 通过" : "✗ 未通过")</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (EvalBatches.Any())
        {
            <div class="sub-card" style="margin-top: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">
                    <span style="font-weight: 600; font-size: 0.9rem;">📚 历史批次（最近 @EvalBatches.Count 批，进程内保留、重启清空）</span>
                    <button class="btn-ghost btn-sm" @onclick="RunCompare" disabled="@(string.IsNullOrEmpty(CompareBaselineId) || string.IsNullOrEmpty(CompareCandidateId) || IsComparing)">
                        @(IsComparing ? "对比中..." : "🆚 对比选中批次")
                    </button>
                </div>
                <div class="table-wrap">
                    <table class="config-table">
                        <thead>
                            <tr>
                                <th scope="col">基线</th>
                                <th scope="col">候选</th>
                                <th scope="col">批次</th>
                                <th scope="col">用例</th>
                                <th scope="col">通过率</th>
                                <th scope="col">均延迟</th>
                                <th scope="col">Tokens</th>
                                <th scope="col">成本</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in EvalBatches)
                            {
                                <tr>
                                    @* @bind 与显式 value 在同一元素上触发 RZ10008；单选组用 checked+onchange 手工绑定。 *@
                                    <td><input type="radio" name="eval-baseline" value="@b.BatchId" checked="@(CompareBaselineId == b.BatchId)" @onchange="@(() => CompareBaselineId = b.BatchId)" /></td>
                                    <td><input type="radio" name="eval-candidate" value="@b.BatchId" checked="@(CompareCandidateId == b.BatchId)" @onchange="@(() => CompareCandidateId = b.BatchId)" /></td>
                                    <td class="table-mono" style="color: var(--purple);">@b.BatchId</td>
                                    <td>@b.TotalCases</td>
                                    <td>@((b.AccuracyRate * 100).ToString("F1"))%</td>
                                    <td>@b.AvgLatencyMs.ToString("F0") ms</td>
                                    <td>@b.TotalTokens.ToString("N0")</td>
                                    <td>$@b.TotalCost.ToString("F4")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (CompareResult != null)
        {
            <div class="sub-card" style="margin-top: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 8px;">
                    <span style="font-weight: 600; font-size: 0.9rem;">🆚 A/B 成对对比</span>
                    <span class="text-secondary" style="font-size: 0.78rem;">
                        @CompareResult.BaselineBatchId → @CompareResult.CandidateBatchId（按用例 ID 配对 @CompareResult.PairedCases 条）
                    </span>
                </div>
                <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px;">
                    <span class="tag tag-success">候选胜: @CompareResult.CandidateWins</span>
                    <span class="tag tag-danger">候选负: @CompareResult.CandidateLosses</span>
                    <span class="tag tag-secondary">平局: @CompareResult.Ties</span>
                    <span class="@(CompareResult.PassRateDelta >= 0 ? "tag tag-success" : "tag tag-danger")">通过率 Δ: @(CompareResult.PassRateDelta * 100 >= 0 ? "+" : "")@((CompareResult.PassRateDelta * 100).ToString("F1"))%</span>
                    <span class="tag tag-secondary">平均延迟 Δ: @(CompareResult.AvgLatencyDeltaMs >= 0 ? "+" : "")@CompareResult.AvgLatencyDeltaMs.ToString("F0") ms</span>
                    <span class="tag tag-secondary">Tokens Δ: @(CompareResult.TotalTokenDelta >= 0 ? "+" : "")@CompareResult.TotalTokenDelta.ToString("N0")</span>
                    <span class="tag tag-secondary">成本 Δ: @(CompareResult.TotalCostDelta >= 0 ? "+" : "")$@CompareResult.TotalCostDelta.ToString("F4")</span>
                </div>
                <div class="table-wrap">
                    <table class="config-table">
                        <thead>
                            <tr>
                                <th scope="col">用例</th>
                                <th scope="col">基线</th>
                                <th scope="col">候选</th>
                                <th scope="col">相似度 Δ</th>
                                <th scope="col">延迟 Δ</th>
                                <th scope="col">成本 Δ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in CompareResult.Cases)
                            {
                                <tr>
                                    <td class="table-mono">@c.TestCaseId</td>
                                    <td>@(c.BaselinePassed ? "✓" : "✗")</td>
                                    <td>@(c.CandidatePassed ? "✓" : "✗")</td>
                                    <td class="@(c.QualityScoreDelta >= 0 ? "text-success" : "text-danger")">@((c.QualityScoreDelta * 100).ToString("F0"))%</td>
                                    <td class="@(c.LatencyDeltaMs <= 0 ? "text-success" : "text-danger")">@c.LatencyDeltaMs.ToString("F0") ms</td>
                                    <td>@(c.CostDelta >= 0 ? "+" : "")$@c.CostDelta.ToString("F4")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private ApiService.DashboardMetrics? Metrics;
    private List<ApiService.LearningStateDto> LearningStates = new();
    private List<ApiService.ConfigChangeDto> ConfigChanges = new();
    private string? LearningStatusMsg;
    private bool LearningStatusOk;

    /// <summary>Fusion 编排模型下拉选项（当前已配置的模型名，含停用项——编排目标可能临时停用但保留配置）。</summary>
    private List<string> FusionModelOptions => Metrics?.Models?.Select(m => m.Name).ToList() ?? new List<string>();

    private async Task ResetLearningState()
    {
        LearningStatusMsg = "重置中...";
        try
        {
            bool confirmed = await JS.InvokeAsync<bool>("confirm", "确定重置全部 Thompson / Bandit 学习状态？\n所有模型将回到均匀先验（含持久化），路由学习从零开始，不可恢复。");
            if (!confirmed)
            {
                LearningStatusMsg = null;
                return;
            }
            var (ok, error) = await Api.ResetLearningAsync();
            LearningStatusOk = ok;
            LearningStatusMsg = ok ? "✓ 学习状态已重置为均匀先验。" : "✗ 重置失败：" + (error ?? "未知错误");
            if (ok)
            {
                await LoadLearning();
            }
        }
        catch (Exception ex)
        {
            LearningStatusOk = false;
            LearningStatusMsg = "✗ 重置异常：" + ex.Message;
        }
    }

    private async Task ExportLearningCsv()
    {
        await JS.InvokeVoidAsync("open", Api.BuildLearningExportUrl(), "_blank");
    }

    private async Task LoadConfigChanges()
    {
        ConfigChanges = await Api.GetConfigChangesAsync(50);
