@page "/requests"
@using OptiRouter.Components.Services
@inject ApiService Api
@inject IJSRuntime JS
@inject ToastService Toast
@inject Microsoft.Extensions.Logging.ILogger<Requests> Logger
@implements IDisposable

<PageTitle>OptiRouter - 请求追踪</PageTitle>

<div class="models-page">
    <!-- 实时请求流 -->
    <div class="glass-card">
        <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; font-size: 1rem;">
            <span style="display: inline-flex; align-items: center; gap: 8px;">
                <AppIcon Name="requests" Size="18" Class="text-primary" />
                <span>实时请求流 (Live Request Stream)</span>
            </span>
            @if (MetricsLoading)
            {
                <span class="tag tag-info" style="font-size: 0.75rem;">
                    <AppIcon Name="refresh" Size="12" />
                    <span>加载中...</span>
                </span>
            }
            else
            {
                <span class="tag tag-success" style="font-size: 0.75rem;">
                    <span class="user-status-dot" style="width: 6px; height: 6px;"></span>
                    <span>实时抓取</span>
                </span>
            }
        </div>
        @if (!string.IsNullOrEmpty(MetricsError))
        {
            <div class="alert-banner alert-error" style="margin: 8px 0; padding: 6px 12px; font-size: 0.82rem;">
                <AppIcon Name="alert" Size="14" />
                <span>@MetricsError</span>
            </div>
        }
        @if (Metrics?.System.RecentRequests != null && Metrics.System.RecentRequests.Any())
        {
            <div class="table-wrap">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th scope="col">时间</th><th scope="col">请求 ID</th><th scope="col">路由模型</th><th scope="col">分档 Tier</th><th scope="col">请求内容</th><th scope="col">Tokens (In/Out)</th><th scope="col">延迟 / TTFT</th><th scope="col">成本</th><th scope="col">类型</th><th scope="col">状态</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Metrics.System.RecentRequests)
                        {
                            <tr>
                                <td>@r.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                                <td><code style="font-size: 0.8rem; color: var(--ok-text-strong);">@(string.IsNullOrEmpty(r.RequestId) ? "-" : Truncate(r.RequestId, 10))</code></td>
                                <td><strong>@r.Model</strong></td>
                                <td><span class="tag tag-info">@r.RoutedTier</span></td>
                                <td><span style="font-size: 0.8rem; color: var(--text-secondary); max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block;">@(string.IsNullOrEmpty(r.RequestContent) ? "-" : Truncate(r.RequestContent, 30))</span></td>
                                <td class="table-mono">@UiFormatter.FormatNumber(r.PromptTokens) / @UiFormatter.FormatNumber(r.CompletionTokens)</td>
                                <td>@UiFormatter.FormatLatency(r.LatencyMs) / @(r.TimeToFirstTokenMs is { } reqTtft ? UiFormatter.FormatLatency(reqTtft) : "--")</td>
                                <td style="color: var(--ok-text); font-weight: bold;">@UiFormatter.FormatCost(r.Cost)</td>
                                <td>
                                    <span class="tag tag-secondary">@(r.IsStreaming ? "流式" : "JSON")</span>
                                    @if (!string.IsNullOrEmpty(r.FusionRole))
                                    {
                                        <span class="tag tag-info">@r.FusionRole</span>
                                    }
                                </td>
                                <td>
                                    @if (r.Success)
                                    {
                                        <span class="tag tag-success">
                                            <AppIcon Name="check" Size="12" />
                                            <span>成功</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="tag tag-danger">
                                            <AppIcon Name="alert" Size="12" />
                                            <span>失败</span>
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <EmptyState Icon="requests" Title="暂无实时请求流数据" Description="当客户端向 OptiRouter 发起 API 对话补全请求时，实时链路信息将在此即时更新呈现。" />
        }
    </div>

    <!-- 审计分析：时间窗全量聚合报告（策略调优闭环） -->
    <div class="glass-card">
        <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; font-size: 1rem; flex-wrap: wrap; gap: 8px;">
            <span style="display: inline-flex; align-items: center; gap: 8px;">
                <AppIcon Name="overview" Size="18" Class="text-info" />
                <span>审计分析 (Audit Analysis)</span>
            </span>
            <div class="trend-controls" style="margin-top: 0;">
                @foreach (var (key, text) in new[] { ("24h", "近24小时"), ("7d", "近7天"), ("30d", "近30天") })
                {
                    <button class="@(AnalysisWindowKey == key ? "active" : "")" @onclick="() => SetAnalysisWindowAsync(key)">@text</button>
                }
            </div>
        </div>
        @if (AnalysisLoading)
        {
            <div style="margin-top: 12px;">
                <SkeletonLoader Type="stat" Count="4" />
            </div>
        }
        else if (Analysis == null || Analysis.TotalRequests == 0)
        {
            <EmptyState Icon="overview" Title="该窗口内暂无聚合审计数据" Description="所选时间窗口内未检测到任何请求记录，请尝试切换至更长的时间窗口（如近7天或近30天）。" />
        }
        else
        {
            var s = Analysis.Summary;
            <div style="display: flex; gap: 8px; flex-wrap: wrap; margin: 10px 0;">
                <span class="tag tag-secondary">总请求 @UiFormatter.FormatNumber(Analysis.TotalRequests)</span>
                <span class="tag @(s.SuccessRatePct >= 95 ? "tag-success" : s.SuccessRatePct >= 80 ? "tag-info" : "tag-danger")">成功率 @UiFormatter.FormatPercent(s.SuccessRatePct)（失败 @UiFormatter.FormatNumber(s.Failures)）</span>
                <span class="tag tag-secondary">成本 @UiFormatter.FormatCost(s.TotalCostUsd)</span>
                <span class="tag tag-info">P50/P95/P99 @UiFormatter.FormatLatency(s.P50LatencyMs)/@UiFormatter.FormatLatency(s.P95LatencyMs)/@UiFormatter.FormatLatency(s.P99LatencyMs)</span>
                <span class="tag tag-secondary">Token 入/出 @UiFormatter.FormatNumber(s.PromptTokens)/@UiFormatter.FormatNumber(s.CompletionTokens)</span>
                <span class="tag @(Analysis.Cascade.TriggerRatePct > 20 ? "tag-warning" : "tag-secondary")">级联触发 @UiFormatter.FormatPercent(Analysis.Cascade.TriggerRatePct)</span>
                @if (Analysis.Fusion.FusionRequests > 0)
                {
                    <span class="tag tag-info">Fusion @UiFormatter.FormatNumber(Analysis.Fusion.FusionRequests) 次</span>
                }
            </div>

            <div class="chart-pair">
                <div class="glass-card chart-wide" style="background: transparent; box-shadow: none; padding: 8px 0 0 0;">
                    <div class="card-label">按日请求趋势</div>
                    <div class="chart-container">
                        <canvas id="analysis-trend-chart" @ref="AnalysisTrendCanvas" role="img" aria-label="按日请求趋势图"></canvas>
                    </div>
                </div>
                <div class="glass-card" style="background: transparent; box-shadow: none; padding: 8px 0 0 0;">
                    <div class="card-label">模型分布（请求量 · 成功率 · 成本）</div>
                    <div style="position: relative; width: 100%; height: @(Math.Max(120, Math.Min(8, Analysis.ByModel.Count) * 30 + 16))px;">
                        <canvas id="analysis-model-chart" @ref="AnalysisModelCanvas" role="img" aria-label="模型请求分布条形图"></canvas>
                    </div>
                </div>
            </div>

            <div class="chart-pair">
                <div class="glass-card chart-wide" style="background: transparent; box-shadow: none; padding: 0;">
                    <div class="card-label">分档 (Tier) 分布</div>
                    <div class="table-wrap">
                        <table class="log-table">
                            <thead>
                                <tr><th scope="col">Tier</th><th scope="col">请求</th><th scope="col">失败</th><th scope="col">成功率</th><th scope="col">成本</th><th scope="col">成本份额</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Analysis.ByTier)
                                {
                                    <tr>
                                        <td><span class="tag tag-info">@t.Tier</span></td>
                                        <td class="table-mono">@UiFormatter.FormatNumber(t.Requests)</td>
                                        <td class="@(t.Failures > 0 ? "text-danger" : "") table-mono">@t.Failures</td>
                                        <td>@UiFormatter.FormatPercent(t.SuccessRatePct)</td>
                                        <td style="color: var(--ok-text);">@UiFormatter.FormatCost(t.CostUsd)</td>
                                        <td>@UiFormatter.FormatPercent(t.CostSharePct)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="glass-card" style="background: transparent; box-shadow: none; padding: 0;">
                    <div class="card-label">路由原因 Top 5</div>
                    <div class="table-wrap">
                        <table class="log-table">
                            <thead>
                                <tr><th scope="col">原因</th><th scope="col">次数</th><th scope="col">成功率</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Analysis.ByReason.Take(5))
                                {
                                    <tr>
                                        <td title="@r.Reason" style="max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@Truncate(r.Reason, 40)</td>
                                        <td class="table-mono">@UiFormatter.FormatNumber(r.Requests)</td>
                                        <td class="@(r.SuccessRatePct >= 80 ? "text-success" : "text-danger")">@UiFormatter.FormatPercent(r.SuccessRatePct)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Analysis.Cascade.UpgradedFrom.Count > 0)
                    {
                        <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px;">
                            <span class="text-secondary" style="font-size: 0.78rem;">级联升级自：</span>
                            @foreach (var kv in Analysis.Cascade.UpgradedFrom.Take(6))
                            {
                                <span class="tag tag-secondary">@kv.Key ×@kv.Value</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- 审计日志 -->
    <div class="glass-card">
        <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <span style="display: inline-flex; align-items: center; gap: 8px;">
                <AppIcon Name="requests" Size="18" Class="text-primary" />
                <span>历史请求审计日志 (点击任意行查看 Debugger Trace 详情)</span>
            </span>
        </div>
        @if (!string.IsNullOrEmpty(AuditError))
        {
            <div class="alert-banner alert-error" style="margin: 8px 0; padding: 6px 12px; font-size: 0.82rem;">
                <AppIcon Name="alert" Size="14" />
                <span>@AuditError</span>
            </div>
        }
        <div class="log-controls">
            <input type="text" placeholder="按模型筛选..." @bind="LogFilterModel" style="width: 140px;" />
            <input type="text" placeholder="搜索 Request/Trace ID..." @bind="LogFilterQuery" style="width: 170px;" />
            <input type="datetime-local" title="起始时间（本地时区）" @bind="LogFilterFrom" style="width: 170px;" />
            <span class="text-secondary">→</span>
            <input type="datetime-local" title="结束时间（本地时区）" @bind="LogFilterTo" style="width: 170px;" />
            <select @bind="LogFilterTier">
                <option value="">全能力分档</option>
                <option value="Strong">Strong</option>
                <option value="Medium">Medium</option>
                <option value="Cheap">Cheap</option>
            </select>
            <select @bind="LogFilterStatus">
                <option value="">全请求状态</option>
                <option value="200">仅成功 (200 OK)</option>
                <option value="error">仅失败/异常</option>
            </select>
            <select @bind="LogFilterMinLatency">
                <option value="0">任意耗时</option>
                <option value="500">耗时 &gt; 500ms</option>
                <option value="1000">耗时 &gt; 1000ms</option>
                <option value="3000">耗时 &gt; 3000ms</option>
            </select>
            <select @bind="LogLimit">
                <option value="50">每页 50 条</option>
                <option value="100">每页 100 条</option>
            </select>
            <button class="btn-primary" @onclick="ApplyLogFilters">
                <AppIcon Name="search" Size="14" />
                <span>组合筛选</span>
            </button>
            <button class="btn-ghost" @onclick="ExportLogCsv">
                <AppIcon Name="download" Size="14" />
                <span>导出 CSV</span>
            </button>
        </div>
        @if (AuditItems.Any())
        {
            <div class="table-wrap">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th scope="col">时间</th><th scope="col">模型</th><th scope="col">Tier</th><th scope="col">请求内容</th><th scope="col">Token</th><th scope="col">缓存 hit/write</th><th scope="col">费用</th><th scope="col">延迟</th><th scope="col">TTFT</th><th scope="col">状态</th><th scope="col">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in AuditItems)
                        {
                            <tr @onclick="() => SelectLogItem(item)" style="cursor: pointer;" class="hover-row">
                                <td>@item.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                                <td><strong>@item.Model</strong></td>
                                <td><span class="badge badge-info">@item.RoutedTier</span></td>
                                <td><span style="font-size: 0.8rem; color: var(--text-secondary); max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block;">@(string.IsNullOrEmpty(item.RequestContent) ? "-" : Truncate(item.RequestContent, 30))</span></td>
                                <td class="table-mono">@UiFormatter.FormatNumber(item.PromptTokens + item.CompletionTokens)</td>
                                <td class="table-mono">@UiFormatter.FormatNumber(item.CachedInputTokens) / @UiFormatter.FormatNumber(item.CacheWriteInputTokens)</td>
                                <td style="color: var(--success); font-weight: 600;">
                                    @UiFormatter.FormatCost(item.Cost)
                                    @if (item.IsEstimated)
                                    {
                                        <span class="tag tag-warning">预估</span>
                                    }
                                </td>
                                <td>@UiFormatter.FormatLatency(item.LatencyMs)</td>
                                <td>@(item.TimeToFirstTokenMs is { } auditTtft ? UiFormatter.FormatLatency(auditTtft) : "--")</td>
                                <td>
                                    @if (item.Success)
                                    {
                                        <span class="tag tag-success">
                                            <AppIcon Name="check" Size="12" />
                                            <span>成功</span>
                                        </span>
                                    }
                                    else if (item.QuotaLimited)
                                    {
                                        <span class="tag tag-warning">
                                            <AppIcon Name="alert" Size="12" />
                                            <span>配额受限</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="tag tag-danger">
                                            <AppIcon Name="alert" Size="12" />
                                            <span>失败</span>
                                        </span>
                                    }
                                </td>
                                <td>
                                    <button class="btn-ghost btn-sm" @onclick:stopPropagation="true" @onclick="() => SelectLogItem(item)">详情</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <EmptyState Icon="search" Title="未检索到符合条件的请求日志" Description="当前筛选条件下没有匹配的记录，请尝试调整搜索词、时间窗口或分档筛选。" ActionText="清空筛选条件" OnAction="ResetFiltersAsync" />
        }
        <div class="pagination">
            <span class="text-secondary">显示 @AuditItems.Count 条，共 @AuditTotal 条@(AuditBufferLimited ? "（已达最近 500 条缓冲上限，仅统计其中匹配）" : "")</span>
            <div>
                <button disabled="@(LogOffset == 0)" @onclick="async () => { LogOffset = Math.Max(0, LogOffset - LogLimit); await LoadLogs(); }">上一页</button>
                <button disabled="@(LogOffset + LogLimit >= AuditTotal)" @onclick="async () => { LogOffset += LogLimit; await LoadLogs(); }">下一页</button>
            </div>
        </div>
    </div>
</div>

@if (SelectedLogItem != null)
{
    <div class="drawer-backdrop" @onclick="() => SelectedLogItem = null" style="justify-content: flex-end;">
        <div class="drawer-content" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="请求详情"
             style="width: 520px; max-width: 90vw; height: 100%; padding: 24px; overflow-y: auto;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 14px; margin-bottom: 16px;">
                <span style="font-weight: 600; font-size: 1.05rem; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
                    <AppIcon Name="requests" Size="18" Class="text-primary" />
                    <span>请求全链路 Debugger Trace</span>
                </span>
                <button class="btn-ghost btn-sm" @onclick="() => SelectedLogItem = null">&times;</button>
            </div>

            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div class="sub-card">
                    <div style="color: var(--text-muted); font-size: 0.75rem; letter-spacing: 0.05em; margin-bottom: 6px;">REQUEST & TRACE ID</div>
                    <div class="table-mono" style="font-size: 0.82rem; color: var(--danger); word-break: break-all;">ReqId: @(SelectedLogItem.RequestId ?? "-")</div>
                    <div class="table-mono" style="font-size: 0.82rem; color: var(--primary); word-break: break-all; margin-top: 2px;">TraceId: @(SelectedLogItem.TraceId ?? "-")</div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 0.82rem;">
                    <div class="sub-card" style="padding: 10px;">
                        <span class="text-muted">命中 Model:</span> <strong style="color: var(--primary); margin-left: 4px;">@SelectedLogItem.Model</strong>
                    </div>
                    <div class="sub-card" style="padding: 10px;">
                        <span class="text-muted">路由 Tier:</span> <span class="badge badge-info" style="margin-left: 4px;">@SelectedLogItem.RoutedTier</span>
                    </div>
                    <div class="sub-card" style="padding: 10px;">
                        <span class="text-muted">端到端耗时:</span> <span style="font-weight: 600; color: var(--success); margin-left: 4px;">@UiFormatter.FormatLatency(SelectedLogItem.LatencyMs)</span>
                    </div>
                    <div class="sub-card" style="padding: 10px;">
                        <span class="text-muted">流式 TTFT:</span> <span style="margin-left: 4px;">@(SelectedLogItem.TimeToFirstTokenMs is { } t ? UiFormatter.FormatLatency(t) : "--")</span>
                    </div>
                    <div class="sub-card" style="padding: 10px;">
                        <span class="text-muted">Tokens:</span> <span style="margin-left: 4px;">@UiFormatter.FormatNumber(SelectedLogItem.PromptTokens) / @UiFormatter.FormatNumber(SelectedLogItem.CompletionTokens)</span>
                    </div>
                    <div class="sub-card" style="padding: 10px;">
                        <span class="text-muted">费用:</span> <span style="color: var(--success); font-weight: 600; margin-left: 4px;">@UiFormatter.FormatCost(SelectedLogItem.Cost)</span>
                    </div>
                </div>

                <div class="sub-card" style="margin-top: 4px;">
                    <div style="color: var(--text-primary); font-size: 0.82rem; font-weight: 600; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                        <AppIcon Name="router" Size="14" Class="text-primary" />
                        <span>路由决策 Reasons 链</span>
                    </div>
                    <div class="table-mono" style="font-size: 0.78rem; color: var(--text-secondary); white-space: pre-wrap; word-break: break-all; background: var(--bg-input); padding: 10px; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle);">@SelectedLogItem.RoutingReason</div>
                </div>

                @if (SelectedLogItem.Reward is not null
                   || !string.IsNullOrEmpty(SelectedLogItem.EpsilonPromotedModel)
                   || !string.IsNullOrEmpty(SelectedLogItem.FusionRole)
                   || !string.IsNullOrEmpty(SelectedLogItem.ParallelGroupId)
                   || !string.IsNullOrEmpty(SelectedLogItem.UpgradedFrom)
                   || SelectedLogItem.CascadeTriggered)
                {
                    <div class="sub-card" style="margin-top: 4px;">
                        <div style="color: var(--text-primary); font-size: 0.82rem; font-weight: 600; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                            <AppIcon Name="benchmarks" Size="14" Class="text-warning" />
                            <span>学习反馈与融合调度</span>
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 0.78rem;">
                            @if (SelectedLogItem.Reward is { } reward)
                            {
                                <div><span class="text-muted">Reward (成本加权后):</span> <span class="table-mono" style="color: var(--purple); font-weight: 600;">@reward.ToString("F3")</span></div>
                            }
                            @if (!string.IsNullOrEmpty(SelectedLogItem.EpsilonPromotedModel))
                            {
                                <div><span class="text-muted">ε 探索提升:</span> <strong style="color: var(--warning); margin-left: 4px;">@SelectedLogItem.EpsilonPromotedModel</strong></div>
                            }
                            @if (!string.IsNullOrEmpty(SelectedLogItem.FusionRole))
                            {
                                <div><span class="text-muted">融合角色:</span> <span class="badge badge-info" style="margin-left: 4px;">@SelectedLogItem.FusionRole</span></div>
                            }
                            @if (!string.IsNullOrEmpty(SelectedLogItem.ParallelGroupId))
                            {
                                <div><span class="text-muted">并行组:</span> <span class="table-mono" style="margin-left: 4px;">@Truncate(SelectedLogItem.ParallelGroupId, 18)</span></div>
                            }
                            @if (!string.IsNullOrEmpty(SelectedLogItem.UpgradedFrom))
                            {
                                <div><span class="text-muted">级联升级自:</span> <strong style="margin-left: 4px;">@SelectedLogItem.UpgradedFrom</strong></div>
                            }
                            @if (SelectedLogItem.CascadeTriggered)
                            {
                                <div><span class="tag tag-warning">触发级联升级</span></div>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(SelectedLogItem.RequestContent))
                {
                    <div class="sub-card" style="margin-top: 4px;">
                        <div style="color: var(--text-primary); font-size: 0.82rem; font-weight: 600; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                            <AppIcon Name="overview" Size="14" Class="text-info" />
                            <span>请求内容（脱敏后）</span>
                        </div>
                        <div style="font-size: 0.8rem; color: var(--text-secondary); white-space: pre-wrap; word-break: break-word; max-height: 260px; overflow-y: auto; background: var(--bg-input); padding: 10px; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle);">@SelectedLogItem.RequestContent</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(SelectedLogItem.ErrorMessage))
                {
                    <div class="alert-banner alert-error" style="margin-top: 4px;">
                        <AppIcon Name="alert" Size="14" />
                        <div style="font-size: 0.8rem; font-family: 'JetBrains Mono', monospace;">@SelectedLogItem.ErrorMessage</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private ApiService.DashboardMetrics? Metrics;
    private bool MetricsLoading = true;
    private List<ApiService.AuditItem> AuditItems = new();
    private int AuditTotal = 0;
    private bool AuditBufferLimited = false;
    private string LogFilterModel = "";
    private int LogLimit = 50;
    private int LogOffset = 0;

    private string LogFilterTier = "";
    private string LogFilterStatus = "";
    private long LogFilterMinLatency = 0;
    private string LogFilterQuery = "";
    private DateTime? LogFilterFrom;
    private DateTime? LogFilterTo;
    private ApiService.AuditItem? SelectedLogItem;
    private int _selectLogVersion;

    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    // ── 审计分析 ──
    private ApiService.AuditAnalysisDto? Analysis;
    private string AnalysisWindowKey = "7d";
    private bool AnalysisLoading = true;
    private ElementReference AnalysisTrendCanvas;
    private ElementReference AnalysisModelCanvas;

    /// <summary>datetime-local 绑定值（Kind=Unspecified 的本地墙钟时间）转 UTC ISO 8601；空返回 null。</summary>
    private static string? ToUtcIso(DateTime? localDateTime)
        => localDateTime?.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ", System.Globalization.CultureInfo.InvariantCulture);

    private async Task SelectLogItem(ApiService.AuditItem item)
    {
        int version = ++_selectLogVersion;
        SelectedLogItem = item;
        if (!string.IsNullOrEmpty(item.RequestId))
        {
            var detail = await Api.GetAuditDetailAsync(item.RequestId);
            // 版本号检查：连点不同行时旧响应不覆盖新选中行
            if (detail != null && version == _selectLogVersion)
            {
                SelectedLogItem = detail;
            }
        }
    }

    private async Task LoadLogs()
    {
        try
        {
            var page = await Api.GetAuditLogAsync(
                LogLimit,
                LogOffset,
                LogFilterModel,
                LogFilterTier,
                LogFilterStatus,
                LogFilterMinLatency > 0 ? LogFilterMinLatency : null,
                string.IsNullOrWhiteSpace(LogFilterQuery) ? null : LogFilterQuery.Trim(),
                ToUtcIso(LogFilterFrom),
                ToUtcIso(LogFilterTo));
            AuditItems = page.Items;
            AuditTotal = page.TotalCount;
            AuditBufferLimited = page.BufferLimited;
            AuditError = null;
        }
        catch (Exception ex)
        {
            AuditError = "请求日志加载失败：" + ex.Message;
        }
    }

    private async Task ExportLogCsv()
    {
        var url = Api.BuildAuditExportUrl(
            LogFilterModel,
            LogFilterTier,
            LogFilterStatus,
            LogFilterMinLatency > 0 ? LogFilterMinLatency : null,
            string.IsNullOrWhiteSpace(LogFilterQuery) ? null : LogFilterQuery.Trim(),
            ToUtcIso(LogFilterFrom),
            ToUtcIso(LogFilterTo));
        await JS.InvokeVoidAsync("open", url, "_blank");
        Toast.ShowInfo("正在导出审计日志 CSV 数据...", "数据导出");
    }

    private string? AuditError;
    private string? MetricsError;

    private async Task ApplyLogFilters()
    {
        LogOffset = 0;
        await LoadLogs();
        Toast.ShowInfo($"筛选完成，共匹配到 {AuditTotal} 条日志", "筛选结果");
    }

    private async Task ResetFiltersAsync()
    {
        LogFilterModel = "";
        LogFilterQuery = "";
        LogFilterFrom = null;
        LogFilterTo = null;
        LogFilterTier = "";
        LogFilterStatus = "";
        LogFilterMinLatency = 0;
        LogOffset = 0;
        await LoadLogs();
        Toast.ShowSuccess("已重置所有筛选条件", "筛选重置");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadMetrics();
        await LoadLogs();

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        _ = PollMetricsLoopAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 首次渲染后 Canvas ref 才绑定，此时拉取并绘制分析图表。
        if (firstRender)
        {
            await LoadAnalysisAsync();
        }
    }

    private static (DateTime From, DateTime To) AnalysisWindow(string key)
        => key switch
        {
            "24h" => (DateTime.UtcNow.AddDays(-1), DateTime.UtcNow),
            "30d" => (DateTime.UtcNow.AddDays(-30), DateTime.UtcNow),
            _ => (DateTime.UtcNow.AddDays(-7), DateTime.UtcNow),
        };

    private async Task SetAnalysisWindowAsync(string key)
    {
        if (AnalysisWindowKey == key) return;
        AnalysisWindowKey = key;
        await LoadAnalysisAsync();
    }

    private async Task LoadAnalysisAsync()
    {
        AnalysisLoading = true;
        var (from, to) = AnalysisWindow(AnalysisWindowKey);
        Analysis = await Api.GetAuditAnalysisAsync(from, to);
        AnalysisLoading = false;
        await InvokeAsync(StateHasChanged);
        await RenderAnalysisChartsAsync();
    }

    private async Task RenderAnalysisChartsAsync()
    {
        if (Analysis is null || Analysis.TotalRequests == 0) return;
        try
        {
            var trend = Analysis.DailyTrend
                .Select(d => new { day = d.Day, requests = (double)d.Requests })
                .ToArray();
            if (trend.Length > 0)
                await JS.InvokeVoidAsync("drawAnalysisTrendChart", AnalysisTrendCanvas, trend);

            var bars = Analysis.ByModel.Take(8)
                .Select(m => new
                {
                    label = m.Model,
                    value = (double)m.Requests,
                    text = $"{m.SuccessRatePct:F1}% · ${m.CostUsd:F4} · P95 {m.P95LatencyMs:F0}ms",
                })
                .ToArray();
            if (bars.Length > 0)
                await JS.InvokeVoidAsync("drawAnalysisBarChart", AnalysisModelCanvas, bars);
        }
        catch (Exception ex)
        {
            // Canvas 未绑定/JS 未就绪是常见场景，降级为 Debug 便于排查图表不渲染。
            Logger.LogDebug(ex, "Requests RenderAnalysisCharts JS invoke failed");
        }
    }

    private async Task PollMetricsLoopAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                await LoadMetrics();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { } // circuit 拆除后 dispatcher 失效，轮询自行退出
    }

    private async Task LoadMetrics()
    {
        try
        {
            Metrics = await Api.GetMetricsAsync();
            MetricsError = null;
            MetricsLoading = false;
        }
        catch (Exception ex)
        {
            // 轮询失败保留上一次数据，仅更新指标错误提示。
            MetricsError = "实时指标刷新失败：" + ex.Message;
        }
    }

    private static string Truncate(string val, int maxLen)
    {
        if (string.IsNullOrEmpty(val)) return "-";
        return val.Length <= maxLen ? val : val[..maxLen] + "...";
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _timer?.Dispose();
    }
}
