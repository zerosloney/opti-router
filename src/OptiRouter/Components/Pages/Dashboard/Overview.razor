@page "/overview"
@page "/dashboard"
@inject ApiService Api
@inject IJSRuntime JS
@inject Microsoft.Extensions.Logging.ILogger<Overview> Logger
@implements IDisposable

<PageTitle>OptiRouter - 总览</PageTitle>

<div class="overview-page">
    <!-- 告警 -->
    @if (Alerts.Any())
    {
        <div class="alert-banner alert-@Alerts.First().Level">
            <span class="indicator pulse"></span>
            <span>@string.Join(" | ", Alerts.Select(a => a.Message))</span>
        </div>
    }

    <!-- 告警历史：出现/恢复事件留痕（进程内环形缓冲，重启清空） -->
    <div class="glass-card">
        <div class="card-label" style="display: flex; justify-content: space-between; align-items: center;">
            <span>🔔 告警历史 (Alert History)</span>
            <span class="text-secondary" style="font-size: 0.75rem;">@AlertHistory.Count 条最近事件</span>
        </div>
        @if (AlertHistory.Any())
        {
            <div class="table-wrap">
                <table class="log-table">
                    <thead>
                        <tr><th scope="col">时间</th><th scope="col">事件</th><th scope="col">级别</th><th scope="col">类别</th><th scope="col">详情</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var evt in AlertHistory.Take(15))
                        {
                            <tr>
                                <td>@evt.Timestamp.ToLocalTime().ToString("MM-dd HH:mm:ss")</td>
                                <td>
                                    @if (evt.EventType == "resolved")
                                    {
                                        <span class="tag tag-success">✓ 已恢复</span>
                                    }
                                    else
                                    {
                                        <span class="tag tag-danger">⚠ 告警</span>
                                    }
                                </td>
                                <td><span class="badge @(evt.Level == "critical" ? "badge-danger" : "badge-info")">@evt.Level</span></td>
                                <td>@evt.Category</td>
                                <td><span style="font-size: 0.82rem; color: var(--text-secondary);">@evt.Message</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-secondary text-center" style="padding: 16px;">暂无告警事件——服务启动以来未检测到预算/熔断/失败率异常，或历史已被重启清空。</div>
        }
    </div>

    <!-- 核心指标卡 -->
    @if (MetricsLoading)
    {
        <div style="padding: 2rem; text-align: center; color: var(--text-secondary);">
            <span class="tag tag-info">加载中...</span>
        </div>
    }
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-card-label">日预算消耗</div>
            <div class="stat-card-val">$@((Metrics?.System.Budget.DailySpend ?? 0).ToString("F6"))</div>
            <div class="budget-bar" style="margin-top: 8px;">
                <div class="budget-fill" style="width: @(BudgetPercent)%"></div>
            </div>
            <div style="font-size:0.7rem;color:var(--dim-text);margin-top:4px;">@BudgetPercent.ToString("F2")% / 上限 $@((Metrics?.System.Budget.DailyBudgetUsd ?? 0).ToString("F2"))</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-label">累计消费</div>
            <div class="stat-card-val" style="color:var(--info-text);">$@((Metrics?.System.Budget.TotalSpend ?? 0).ToString("F6"))</div>
            <div style="font-size:0.7rem;color:var(--dim-text);margin-top:4px;">服务启动以来合计</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-label">总请求数</div>
            <div class="stat-card-val">@((Metrics?.System.TotalRequests ?? 0).ToString("N0"))</div>
            <div style="font-size:0.7rem;color:var(--dim-text);margin-top:4px;">QPS: @((Metrics?.System.Qps ?? 0).ToString("F1"))</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-label">总 Token 数</div>
            <div class="stat-card-val">@((Metrics?.System.TotalTokens ?? 0).ToString("N0"))</div>
            <div style="font-size:0.7rem;color:var(--dim-text);margin-top:4px;">缓存命中 @((Metrics?.System.CachedInputTokens ?? 0).ToString("N0")) / 写入 @((Metrics?.System.CacheWriteInputTokens ?? 0).ToString("N0"))</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-label">平均延迟</div>
            <div class="stat-card-val">@((Metrics?.System.AvgLatencyMs ?? 0).ToString("F1")) ms</div>
            <div style="font-size:0.7rem;color:var(--dim-text);margin-top:4px;">平均 TTFT: @(Metrics?.System.AvgTtftMs is { } ttft ? $"{ttft:F1} ms" : "--")</div>
        </div>
    </div>

    <!-- 智能降本 ROI 归因卡片 -->
    <div class="glass-card roi-card">
        <div class="card-label" style="color: var(--success); font-weight: 600; font-size: 0.95rem;">智能降本 ROI 归因看板</div>
        <div style="display: flex; align-items: baseline; gap: 14px; margin: 8px 0;">
            <div class="stat-value" style="color: var(--success); font-size: 2rem; font-weight: 700;">$@((Metrics?.System.Roi?.SavedUsd ?? 0).ToString("F6"))</div>
            <div class="badge badge-success" style="font-size: 0.85rem; padding: 0.3rem 0.75rem;">
                智能路由降本 @((Metrics?.System.Roi?.SavingRatePercent ?? 0).ToString("F1"))%
            </div>
        </div>
        <div class="meta-text">
            基线预估成本（全使用强模型）：$@((Metrics?.System.Roi?.BaselineCostUsd ?? 0).ToString("F6")) | 实际优化处理成本：$@((Metrics?.System.Roi?.ActualCostUsd ?? 0).ToString("F6"))
        </div>
    </div>

    <div class="chart-pair">
        <!-- 费用趋势图 -->
        <div class="glass-card chart-wide">
            <div class="card-label">费用趋势</div>
            <div class="trend-controls">
                <button class="@(TrendDays == 7 ? "active" : "")" @onclick="() => SetTrendDays(7)">近7天</button>
                <button class="@(TrendDays == 30 ? "active" : "")" @onclick="() => SetTrendDays(30)">近30天</button>
            </div>
            <div class="chart-container">
                <canvas id="trend-chart" @ref="ChartCanvas" role="img" aria-label="每日费用趋势图"></canvas>
            </div>
        </div>

        <!-- 数据安全与 PII 脱敏防护看板 -->
        <div class="glass-card">
            <div class="card-label" style="display: flex; justify-content: space-between; align-items: center;">
                <span>数据合规与 PII 防护</span>
                <span class="tag tag-info">数据不出域: @(Metrics?.System.Security?.DataSovereigntyEnabled == true ? "已开启" : "未开启")</span>
            </div>
            <div style="display: flex; align-items: baseline; gap: 12px; margin: 8px 0;">
                <div class="stat-value" style="font-size: 2rem; font-weight: 700;">@((Metrics?.System.Security?.PiiProtectedTotal ?? 0).ToString("N0")) <span style="font-size: 0.9rem; font-weight: normal; color: var(--text-secondary);">次敏感项脱敏</span></div>
            </div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px;">
                <span class="tag tag-secondary">📱 手机号: @((Metrics?.System.Security?.PhoneProtected ?? 0).ToString("N0"))</span>
                <span class="tag tag-secondary">📧 邮箱: @((Metrics?.System.Security?.EmailProtected ?? 0).ToString("N0"))</span>
                <span class="tag tag-secondary">🆔 身份证: @((Metrics?.System.Security?.IdCardProtected ?? 0).ToString("N0"))</span>
                <span class="tag tag-secondary">💳 银行卡: @((Metrics?.System.Security?.CreditCardProtected ?? 0).ToString("N0"))</span>
                <span class="tag tag-secondary">🌐 IP 地址: @((Metrics?.System.Security?.IpProtected ?? 0).ToString("N0"))</span>
            </div>
        </div>
    </div>

    <!-- 多窗口统计 -->
    <div class="glass-card">
        <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <span>多窗口统计</span>
            <div class="trend-controls" style="margin-bottom: 0;">
                @foreach (var w in WindowOptions)
                {
                    var isActive = w == WindowKey;
                    <button class="@(isActive ? "active" : "")" @onclick="() => SetWindow(w)">
                        @WindowLabels[w]
                    </button>
                }
            </div>
        </div>
        @if (WindowData != null)
        {
            @if (WindowKey != "all" && WindowData.WindowHours > WindowData.RetentionHours && WindowData.RetentionHours > 0)
            {
                <div class="alert-banner alert-warning" style="margin: 10px 0; padding: 8px 12px; font-size: 0.85rem;">
                    ⚠ 当前窗口 (@WindowData.WindowHours h) 超出审计保留期 (@WindowData.RetentionHours h)，更早数据已被淘汰，仅显示保留期内数据。
                </div>
            }
            <div class="stats-row">
                <div class="stat-card">
                    <div class="stat-card-label">输入 Token</div>
                    <div class="stat-card-val">@WindowData.InputTokens.ToString("N0")</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-label">输出 Token</div>
                    <div class="stat-card-val">@WindowData.OutputTokens.ToString("N0")</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-label">缓存命中率</div>
                    <div class="stat-card-val" style="color:var(--ok-text);">@WindowData.CacheHitRatePercent.ToString("F1")%</div>
                    <div style="font-size:0.7rem;color:var(--dim-text);margin-top:4px;">命中 @WindowData.CachedInputTokens.ToString("N0") / 未缓存 @WindowData.UncachedInputTokens.ToString("N0")</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-label">错误率</div>
                    <div class="stat-card-val" style="color:@(WindowData.ErrorRatePercent > 0 ? "var(--warn-text)" : "var(--faint-text)");">@WindowData.ErrorRatePercent.ToString("F2")%</div>
                    <div style="font-size:0.7rem;color:var(--dim-text);margin-top:4px;">失败 @WindowData.Failures.ToString("N0") / 请求 @WindowData.TotalRequests.ToString("N0")</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-label">平均延迟</div>
                    <div class="stat-card-val">@WindowData.AvgLatencyMs.ToString("F1") ms</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-label">总成本</div>
                    <div class="stat-card-val" style="color:var(--ok-text);">$@WindowData.TotalCost.ToString("F4")</div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center text-secondary" style="padding: 20px;">加载中...</div>
        }
    </div>

    <!-- 路由内部状态 -->
    <div class="glass-card">
        <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <span>路由内部状态 (Internal Routing State)</span>
            <span class="tag tag-secondary">进程内状态 · 重启清空</span>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; margin-top: 10px;">
            <!-- 上游配额水位 -->
            <div class="sub-card">
                <div class="card-label" style="margin-bottom: 8px;">⚡ 上游配额水位</div>
                @if (QuotaStates.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: 6px; font-size: 0.78rem;">
                        @foreach (var q in QuotaStates)
                        {
                            <div style="display: flex; justify-content: space-between; gap: 8px; align-items: center;">
                                <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600;">@q.ModelName</span>
                                @if (q.IsExhausted)
                                {
                                    <span class="tag tag-danger" style="font-size: 0.7rem;">耗尽至 @(q.ExhaustedUntil is { } eu ? eu.ToLocalTime().ToString("HH:mm") : "--")</span>
                                }
                                else
                                {
                                    <span class="text-secondary">Req: @(q.RequestsRemaining?.ToString("N0") ?? "--") · Tok: @(q.TokensRemaining?.ToString("N0") ?? "--")</span>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-secondary text-center" style="padding: 12px; font-size: 0.8rem;">暂无上游配额观测数据</div>
                }
            </div>

            <!-- 提示词缓存亲和 -->
            <div class="sub-card">
                <div class="card-label" style="margin-bottom: 8px;">🔗 提示词缓存亲和</div>
                <div style="font-size: 0.85rem; margin-bottom: 6px;">
                    总条目: <strong>@AffinityState.TotalCount.ToString("N0")</strong>
                    <span class="text-secondary" style="font-size: 0.72rem;">（仅展示最近 5 条）</span>
                </div>
                @if (AffinityState.Items.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: 5px; font-size: 0.75rem;">
                        @foreach (var e in AffinityState.Items.Take(5))
                        {
                            <div style="display: flex; justify-content: space-between; gap: 8px; align-items: center;">
                                <span class="table-mono" style="color: var(--text-muted);">@(e.Fingerprint.Length > 12 ? e.Fingerprint[..12] : e.Fingerprint)…</span>
                                <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--primary);">→ @e.ModelName</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-secondary text-center" style="padding: 12px; font-size: 0.8rem;">暂无亲和映射（需开启 PromptCacheAffinity）</div>
                }
            </div>

            <!-- 响应缓存 -->
            <div class="sub-card">
                <div class="card-label" style="margin-bottom: 8px;">💾 响应缓存</div>
                @if (ResponseCacheStats != null)
                {
                    <div style="display: flex; flex-direction: column; gap: 6px; font-size: 0.8rem;">
                        <div>
                            命中率: <strong style="color: @(ResponseCacheStats.HitRatePercent >= 50 ? "var(--success)" : ResponseCacheStats.HitRatePercent > 0 ? "var(--warning)" : "var(--text-secondary)");">@ResponseCacheStats.HitRatePercent.ToString("F1")%</strong>
                        </div>
                        <div class="text-secondary">
                            命中 @ResponseCacheStats.Hits.ToString("N0") · 未命中 @ResponseCacheStats.Misses.ToString("N0") · 累计写入 @ResponseCacheStats.Sets.ToString("N0")
                        </div>
                        <div class="text-secondary">
                            当前条目 @ResponseCacheStats.CurrentEntries.ToString("N0") / 上限 @ResponseCacheStats.MaxEntries.ToString("N0")
                        </div>
                        <div class="meta-text" style="font-size: 0.72rem;">
                            @(ResponseCacheStats.Enabled
                                ? "已开启——仅非流式请求参与缓存；计数全为 0 表示暂无可缓存的非流式流量。"
                                : "未开启（路由页可热启用）。")
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-secondary text-center" style="padding: 12px; font-size: 0.8rem;">统计不可用</div>
                }
            </div>
        </div>
    </div>

    <!-- 实时请求流预览 -->
    <div class="glass-card">
        <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; font-size: 1rem;">
            <span>实时请求流 (Live Request Stream)</span>
            <NavLink href="/requests" class="nav-link" style="font-size: 0.85rem;">查看全部请求 →</NavLink>
        </div>
        <div class="table-wrap">
            <table class="log-table">
                <thead>
                    <tr>
                        <th scope="col">时间</th><th scope="col">请求 ID</th><th scope="col">路由模型</th><th scope="col">分档 Tier</th><th scope="col">请求内容</th><th scope="col">Tokens (In/Out)</th><th scope="col">延迟 / TTFT</th><th scope="col">成本</th><th scope="col">类型</th><th scope="col">状态</th>
                    </tr>
                </thead>
                <tbody>
                    @if (RecentRequests.Any())
                    {
                        @foreach (var r in RecentRequests)
                        {
                            <tr>
                                <td>@r.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                                <td><code style="font-size: 0.8rem; color: var(--ok-text-strong);">@(string.IsNullOrEmpty(r.RequestId) ? "-" : Truncate(r.RequestId, 10))</code></td>
                                <td><strong>@r.Model</strong></td>
                                <td><span class="tag tag-info">@r.RoutedTier</span></td>
                                <td><span style="font-size: 0.8rem; color: var(--text-secondary); max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block;">@(string.IsNullOrEmpty(r.RequestContent) ? "-" : Truncate(r.RequestContent, 30))</span></td>
                                <td>@r.PromptTokens / @r.CompletionTokens</td>
                                <td>@r.LatencyMs.ToString("F0") ms / @(r.TimeToFirstTokenMs is { } reqTtft ? $"{reqTtft:F0} ms" : "--")</td>
                                <td style="color: var(--ok-text); font-weight: bold;">$@r.Cost.ToString("F6")</td>
                                <td>
                                    <span class="tag tag-secondary">@(r.IsStreaming ? "流式" : "JSON")</span>
                                    @if (!string.IsNullOrEmpty(r.FusionRole))
                                    {
                                        <span class="tag tag-info">@r.FusionRole</span>
                                    }
                                </td>
                                <td class="@(r.Success ? "text-success" : "text-danger")">
                                    @(r.Success ? "✓ 成功" : "✗ 失败")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="10" class="text-center text-secondary">暂无实时请求流数据</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private ApiService.DashboardMetrics? Metrics;
    private bool MetricsLoading = true;
    private List<ApiService.DailySpend> Trends = new();
    private List<ApiService.AlertInfo> Alerts => Metrics?.System.Alerts ?? new();
    private List<ApiService.AlertEventDto> AlertHistory = new();

    // 路由内部状态：上游配额 / 缓存亲和 / 响应缓存。低频刷新（每 3 个轮询周期一次）。
    private List<ApiService.QuotaStateDto> QuotaStates = new();
    private ApiService.AffinityPageDto AffinityState = new(0, new List<ApiService.AffinityStateDto>());
    private ApiService.ResponseCacheStatsDto? ResponseCacheStats;
    private int _stateTick;

    // 多窗口统计：Tab 选项 + 当前选中窗口 + 数据。默认 24h。
    private static readonly string[] WindowOptions = { "1h", "7h", "24h", "7d", "15d", "30d", "all" };
    private static readonly Dictionary<string, string> WindowLabels = new()
    {
        ["1h"] = "1小时", ["7h"] = "7小时", ["24h"] = "24小时",
        ["7d"] = "7天", ["15d"] = "15天", ["30d"] = "30天", ["all"] = "全部"
    };
    private string WindowKey = "24h";
    private ApiService.WindowSummary? WindowData;
    private int TrendDays = 7;

    private IReadOnlyList<ApiService.RecentRequestItem> RecentRequests
        => Metrics?.System.RecentRequests?.Take(8).ToList() ?? new List<ApiService.RecentRequestItem>();

    private ElementReference ChartCanvas;
    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    private double BudgetPercent
    {
        get
        {
            if (Metrics?.System.Budget == null) return 0;
            var limit = (double)Metrics.System.Budget.DailyBudgetUsd;
            if (limit <= 0) return 0;
            var spend = (double)Metrics.System.Budget.DailySpend;
            return Math.Min(100.0, (spend / limit) * 100.0);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadMetrics();
        await LoadTrends();
        await LoadWindowSummary();
        await LoadInternalState();

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        _ = PollMetricsLoopAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 首次渲染后 ChartCanvas 才绑定；OnInitializedAsync 阶段 ref 仍为默认，无法绘制。
        if (firstRender)
        {
            await RenderChart();
        }
    }

    private async Task PollMetricsLoopAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                await LoadMetrics();
                await LoadWindowSummary();
                _stateTick++;
                if (_stateTick % 3 == 0)
                {
                    await LoadInternalState();
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { } // circuit 拆除后 dispatcher 失效，轮询自行退出
    }

    private async Task LoadInternalState()
    {
        try
        {
            var quotaTask = Api.GetQuotaStateAsync();
            var affinityTask = Api.GetCacheAffinityAsync();
            var cacheStatsTask = Api.GetResponseCacheStatsAsync();
            var alertHistoryTask = Api.GetAlertHistoryAsync();
            await Task.WhenAll(quotaTask, affinityTask, cacheStatsTask, alertHistoryTask);
            QuotaStates = quotaTask.Result;
            AffinityState = affinityTask.Result;
            ResponseCacheStats = cacheStatsTask.Result;
            AlertHistory = alertHistoryTask.Result;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Overview LoadInternalState failed");
        }
    }

    private async Task LoadMetrics()
    {
        try
        {
            Metrics = await Api.GetMetricsAsync();
            MetricsLoading = false;
        }
        catch (Exception ex)
        {
            // 静默降级保留诊断线索：仪表盘数据停止更新时可定位原因
            Logger.LogDebug(ex, "Overview LoadMetrics failed");
            MetricsLoading = false;
        }
    }

    private async Task LoadTrends()
    {
        try
        {
            Trends = await Api.GetTrendsAsync(TrendDays);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Overview LoadTrends failed");
        }
    }

    private async Task SetTrendDays(int days)
    {
        TrendDays = days;
        await LoadTrends();
        await RenderChart(); // 切换天数时 Canvas 已绑定，立即重绘
    }

    private async Task SetWindow(string key)
    {
        WindowKey = key;
        _windowVersion++;
        await LoadWindowSummary();
    }

    private int _windowVersion;

    private async Task LoadWindowSummary()
    {
        try
        {
            int version = _windowVersion;
            var data = await Api.GetWindowSummaryAsync(WindowKey);
            // 丢弃过期响应：切换窗口瞬间轮询在途请求后返回时，不得覆盖新窗口数据
            if (version != _windowVersion) return;
            WindowData = data;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Overview LoadWindowSummary failed");
        }
    }

    private async Task RenderChart()
    {
        if (Trends == null || !Trends.Any()) return;
        // drawTrendChart 期望 [{date, amount}]；显式 camelCase 匿名对象避免序列化策略差异。
        var payload = Trends.Select(t => new { date = t.Date, amount = (double)t.Amount }).ToArray();

        try
        {
            await JS.InvokeVoidAsync("drawTrendChart", ChartCanvas, payload);
        }
        catch (Exception ex)
        {
            // Canvas 未绑定/JS 未就绪是常见场景，降级为 Debug 便于排查图表不渲染
            Logger.LogDebug(ex, "Overview RenderChart JS invoke failed");
        }
    }

    private static string Truncate(string val, int maxLen)
    {
        if (string.IsNullOrEmpty(val)) return "-";
        return val.Length <= maxLen ? val : val[..maxLen] + "...";
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _timer?.Dispose();
    }
}
