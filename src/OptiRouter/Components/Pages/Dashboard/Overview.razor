@page "/overview"
@page "/dashboard"
@inject ApiService Api
@inject IJSRuntime JS
@inject Microsoft.Extensions.Logging.ILogger<Overview> Logger
@implements IDisposable

<PageTitle>OptiRouter - 总览</PageTitle>

<div class="overview-page">
    <!-- 告警 -->
    @if (Alerts.Any())
    {
        <div class="alert-banner alert-@Alerts.First().Level">
            <span class="indicator pulse"></span>
            <span>@string.Join(" | ", Alerts.Select(a => a.Message))</span>
        </div>
    }

    <!-- 告警历史：出现/恢复事件留痕（进程内环形缓冲，重启清空） -->
    <div class="glass-card">
        <div class="card-label" style="display: flex; justify-content: space-between; align-items: center;">
            <span style="display: inline-flex; align-items: center; gap: 8px;">
                <AppIcon Name="alert" Size="18" Class="text-warning" />
                <span>告警历史 (Alert History)</span>
            </span>
            <span class="text-secondary" style="font-size: 0.75rem;">@AlertHistory.Count 条最近事件</span>
        </div>
        @if (AlertHistory.Any())
        {
            <div class="table-wrap">
                <table class="log-table">
                    <thead>
                        <tr><th scope="col">时间</th><th scope="col">事件</th><th scope="col">级别</th><th scope="col">类别</th><th scope="col">详情</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var evt in AlertHistory.Take(15))
                        {
                            <tr>
                                <td>@evt.Timestamp.ToLocalTime().ToString("MM-dd HH:mm:ss")</td>
                                <td>
                                    @if (evt.EventType == "resolved")
                                    {
                                        <span class="tag tag-success">
                                            <AppIcon Name="check" Size="12" />
                                            <span>已恢复</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="tag tag-danger">
                                            <AppIcon Name="alert" Size="12" />
                                            <span>告警</span>
                                        </span>
                                    }
                                </td>
                                <td><span class="badge @(evt.Level == "critical" ? "badge-danger" : "badge-info")">@evt.Level</span></td>
                                <td>@evt.Category</td>
                                <td><span style="font-size: 0.82rem; color: var(--text-secondary);">@evt.Message</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <EmptyState Icon="shield" Title="系统运行健康稳定" Description="服务启动以来未检测到任何预算超支、上游模型熔断或高异常率告警事件。" />
        }
    </div>

    <!-- 核心指标卡 -->
    @if (MetricsLoading && Metrics == null)
    {
        <SkeletonLoader Type="stat" Count="5" />
    }
    else
    {
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-card-label">日预算消耗</div>
                <div class="stat-card-val">@UiFormatter.FormatCost(Metrics?.System.Budget.DailySpend ?? 0)</div>
                <div class="budget-bar" style="margin-top: 8px;">
                    <div class="budget-fill" style="width: @(BudgetPercent)%"></div>
                </div>
                <div style="font-size:0.7rem;color:var(--dim-text);margin-top:4px;">@UiFormatter.FormatPercent(BudgetPercent) / 上限 @UiFormatter.FormatCost(Metrics?.System.Budget.DailyBudgetUsd ?? 0)</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">累计消费</div>
                <div class="stat-card-val" style="color:var(--info-text);">@UiFormatter.FormatCost(Metrics?.System.Budget.TotalSpend ?? 0)</div>
                <div style="font-size:0.7rem;color:var(--dim-text);margin-top:4px;">服务启动以来合计</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">总请求数</div>
                <div class="stat-card-val">@UiFormatter.FormatNumber(Metrics?.System.TotalRequests ?? 0)</div>
                <div style="font-size:0.7rem;color:var(--dim-text);margin-top:4px;">QPS: @((Metrics?.System.Qps ?? 0).ToString("F1"))</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">总 Token 数</div>
                <div class="stat-card-val">@UiFormatter.FormatNumber(Metrics?.System.TotalTokens ?? 0)</div>
                <div style="font-size:0.7rem;color:var(--dim-text);margin-top:4px;">缓存命中 @UiFormatter.FormatNumber(Metrics?.System.CachedInputTokens ?? 0) / 写入 @UiFormatter.FormatNumber(Metrics?.System.CacheWriteInputTokens ?? 0)</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">平均延迟</div>
                <div class="stat-card-val">@UiFormatter.FormatLatency(Metrics?.System.AvgLatencyMs ?? 0)</div>
                <div style="font-size:0.7rem;color:var(--dim-text);margin-top:4px;">平均 TTFT: @(Metrics?.System.AvgTtftMs is { } ttft ? UiFormatter.FormatLatency(ttft) : "--")</div>
            </div>
        </div>
    }

    <!-- 智能降本 ROI 归因卡片 -->
    <div class="glass-card roi-card">
        <div class="card-label" style="margin-bottom: 1rem;">
            <span style="display: inline-flex; align-items: center; gap: 6px; color: var(--ok-text); font-weight: 600; font-size: 0.95rem;">
                <AppIcon Name="shield" Size="16" />
                <span>智能降本 ROI 归因看板</span>
            </span>
            <span class="tag tag-success" style="font-size: 0.72rem; font-weight: 500;">分级路由与缓存优化成效</span>
        </div>
        <div class="roi-grid">
            <div class="roi-metric-item">
                <div class="stat-row-label" style="font-size: 0.78rem;">已累计节约成本</div>
                <div class="stat-card-val table-mono" style="color: var(--ok-text); font-size: 1.85rem; font-weight: 700; margin: 4px 0 2px 0;">
                    @UiFormatter.FormatCost(Metrics?.System.Roi?.SavedUsd ?? 0)
                </div>
                <div style="font-size: 0.72rem; color: var(--dim-text);">智能路由节约总收益</div>
            </div>
            <div class="roi-metric-item">
                <div class="stat-row-label" style="font-size: 0.78rem;">综合降本比例</div>
                <div class="stat-card-val table-mono" style="color: var(--ok-text); font-size: 1.85rem; font-weight: 700; margin: 4px 0 2px 0;">
                    @UiFormatter.FormatPercent(Metrics?.System.Roi?.SavingRatePercent ?? 0)
                </div>
                <div style="font-size: 0.72rem; color: var(--dim-text);">相对全强模型基线降幅</div>
            </div>
            <div class="roi-metric-item">
                <div class="stat-row-label" style="font-size: 0.78rem;">基线预估成本</div>
                <div class="stat-card-val table-mono" style="font-size: 1.85rem; font-weight: 700; margin: 4px 0 2px 0; color: var(--text-primary);">
                    @UiFormatter.FormatCost(Metrics?.System.Roi?.BaselineCostUsd ?? 0)
                </div>
                <div style="font-size: 0.72rem; color: var(--dim-text);">全量使用强模型理论开销</div>
            </div>
            <div class="roi-metric-item">
                <div class="stat-row-label" style="font-size: 0.78rem;">实际优化处理成本</div>
                <div class="stat-card-val table-mono" style="font-size: 1.85rem; font-weight: 700; margin: 4px 0 2px 0; color: var(--text-primary);">
                    @UiFormatter.FormatCost(Metrics?.System.Roi?.ActualCostUsd ?? 0)
                </div>
                <div style="font-size: 0.72rem; color: var(--dim-text);">分级路由优化后实际花费</div>
            </div>
        </div>
    </div>

    <div class="chart-pair">
        <!-- 费用趋势图 -->
        <div class="glass-card chart-wide">
            <div class="card-label">费用趋势</div>
            <div class="trend-controls">
                <button class="@(TrendDays == 7 ? "active" : "")" @onclick="() => SetTrendDays(7)">近7天</button>
                <button class="@(TrendDays == 30 ? "active" : "")" @onclick="() => SetTrendDays(30)">近30天</button>
            </div>
            <div class="chart-container">
                <canvas id="trend-chart" @ref="ChartCanvas" role="img" aria-label="每日费用趋势图"></canvas>
            </div>
        </div>

        <!-- 数据安全与 PII 脱敏防护看板 -->
        <div class="glass-card">
            <div class="card-label" style="display: flex; justify-content: space-between; align-items: center;">
                <span style="display: inline-flex; align-items: center; gap: 6px;">
                    <AppIcon Name="shield" Size="16" Class="text-primary" />
                    <span>数据合规与 PII 防护</span>
                </span>
                <span class="tag tag-info">数据不出域: @(Metrics?.System.Security?.DataSovereigntyEnabled == true ? "已开启" : "未开启")</span>
            </div>
            <div style="display: flex; align-items: baseline; gap: 12px; margin: 8px 0;">
                <div class="stat-value" style="font-size: 2rem; font-weight: 700;">@UiFormatter.FormatNumber(Metrics?.System.Security?.PiiProtectedTotal ?? 0) <span style="font-size: 0.9rem; font-weight: normal; color: var(--text-secondary);">次敏感项脱敏</span></div>
            </div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px;">
                <span class="tag tag-secondary">手机号: @UiFormatter.FormatNumber(Metrics?.System.Security?.PhoneProtected ?? 0)</span>
                <span class="tag tag-secondary">邮箱: @UiFormatter.FormatNumber(Metrics?.System.Security?.EmailProtected ?? 0)</span>
                <span class="tag tag-secondary">身份证: @UiFormatter.FormatNumber(Metrics?.System.Security?.IdCardProtected ?? 0)</span>
                <span class="tag tag-secondary">银行卡: @UiFormatter.FormatNumber(Metrics?.System.Security?.CreditCardProtected ?? 0)</span>
                <span class="tag tag-secondary">IP 地址: @UiFormatter.FormatNumber(Metrics?.System.Security?.IpProtected ?? 0)</span>
            </div>
        </div>
    </div>

    <!-- 多窗口统计 -->
    <div class="glass-card">
        <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <span>多窗口统计</span>
            <div class="trend-controls" style="margin-bottom: 0;">
                @foreach (var w in WindowOptions)
                {
                    var isActive = w == WindowKey;
                    <button class="@(isActive ? "active" : "")" @onclick="() => SetWindow(w)">
                        @WindowLabels[w]
                    </button>
                }
            </div>
        </div>
        @if (WindowData != null)
        {
            @if (WindowKey != "all" && WindowData.WindowHours > WindowData.RetentionHours && WindowData.RetentionHours > 0)
            {
                <div class="alert-banner alert-warning" style="margin: 10px 0; padding: 8px 12px; font-size: 0.85rem;">
                    <AppIcon Name="alert" Size="14" />
                    <span>当前窗口 (@WindowData.WindowHours h) 超出审计保留期 (@WindowData.RetentionHours h)，更早数据已被淘汰，仅显示保留期内数据。</span>
                </div>
            }
            <div class="stats-row">
                <div class="stat-card">
                    <div class="stat-card-label">输入 Token</div>
                    <div class="stat-card-val">@UiFormatter.FormatNumber(WindowData.InputTokens)</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-label">输出 Token</div>
                    <div class="stat-card-val">@UiFormatter.FormatNumber(WindowData.OutputTokens)</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-label">缓存命中率</div>
                    <div class="stat-card-val" style="color:var(--ok-text);">@UiFormatter.FormatPercent(WindowData.CacheHitRatePercent)</div>
                    <div style="font-size:0.7rem;color:var(--dim-text);margin-top:4px;">命中 @UiFormatter.FormatNumber(WindowData.CachedInputTokens) / 未缓存 @UiFormatter.FormatNumber(WindowData.UncachedInputTokens)</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-label">错误率</div>
                    <div class="stat-card-val" style="color:@(WindowData.ErrorRatePercent > 0 ? "var(--warn-text)" : "var(--faint-text)");">@UiFormatter.FormatPercent(WindowData.ErrorRatePercent)</div>
                    <div style="font-size:0.7rem;color:var(--dim-text);margin-top:4px;">失败 @UiFormatter.FormatNumber(WindowData.Failures) / 请求 @UiFormatter.FormatNumber(WindowData.TotalRequests)</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-label">平均延迟</div>
                    <div class="stat-card-val">@UiFormatter.FormatLatency(WindowData.AvgLatencyMs)</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-label">总成本</div>
                    <div class="stat-card-val" style="color:var(--ok-text);">@UiFormatter.FormatCost(WindowData.TotalCost)</div>
                </div>
            </div>
        }
        else
        {
            <SkeletonLoader Type="stat" Count="5" />
        }
    </div>

    <!-- 路由内部状态 -->
    <div class="glass-card">
        <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <span style="display: inline-flex; align-items: center; gap: 6px;">
                <AppIcon Name="router" Size="16" Class="text-primary" />
                <span>路由内部状态 (Internal Routing State)</span>
            </span>
            <span class="tag tag-secondary">进程内状态 · 重启清空</span>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; margin-top: 10px;">
            <!-- 上游配额水位 -->
            <div class="sub-card">
                <div class="card-label" style="margin-bottom: 8px; display: flex; align-items: center; justify-content: space-between;">
                    <span style="display: inline-flex; align-items: center; gap: 6px;">
                        <AppIcon Name="benchmarks" Size="14" Class="text-warning" />
                        <span>上游配额水位</span>
                    </span>
                    <span class="tag @(QuotaStates.Any(q => q.IsExhausted) ? "tag-danger" : "tag-success")" style="font-size: 0.7rem;">
                        @(QuotaStates.Any(q => q.IsExhausted) ? "存在耗尽" : "水位充裕")
                    </span>
                </div>
                @if (QuotaStates.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: 6px; font-size: 0.78rem;">
                        @foreach (var q in QuotaStates)
                        {
                            <div style="display: flex; justify-content: space-between; gap: 8px; align-items: center;">
                                <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600;">@q.ModelName</span>
                                @if (q.IsExhausted)
                                {
                                    <span class="tag tag-danger" style="font-size: 0.7rem;">耗尽至 @(q.ExhaustedUntil is { } eu ? eu.ToLocalTime().ToString("HH:mm") : "--")</span>
                                }
                                else
                                {
                                    <span class="text-secondary">Req: @(q.RequestsRemaining is { } rrem ? UiFormatter.FormatNumber(rrem) : "--") · Tok: @(q.TokensRemaining is { } trem ? UiFormatter.FormatNumber(trem) : "--")</span>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 6px; font-size: 0.8rem;">
                        <div class="text-secondary">配额监控状态: <strong style="color: var(--success);">水位正常</strong></div>
                        <div class="text-secondary" style="font-size: 0.75rem;">上游模型未触发 RateLimit / 429 限制</div>
                    </div>
                }
                <div class="meta-text" style="font-size: 0.72rem; margin-top: 8px;">
                    实时捕获上游 OpenAI / Claude 等响应头中的动态配额。
                </div>
            </div>

            <!-- 提示词缓存亲和 -->
            <div class="sub-card">
                <div class="card-label" style="margin-bottom: 8px; display: flex; align-items: center; justify-content: space-between;">
                    <span style="display: inline-flex; align-items: center; gap: 6px;">
                        <AppIcon Name="models" Size="14" Class="text-primary" />
                        <span>提示词缓存亲和</span>
                    </span>
                    <span class="tag @(AffinityState.Enabled ? "tag-info" : "tag-secondary")" style="font-size: 0.7rem;">
                        @(AffinityState.Enabled ? (AffinityState.TotalCount > 0 ? $"{AffinityState.TotalCount} 条映射" : "已开启 · 0 条") : "未开启")
                    </span>
                </div>
                @if (AffinityState.Items.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: 5px; font-size: 0.75rem;">
                        @foreach (var e in AffinityState.Items.Take(5))
                        {
                            <div style="display: flex; justify-content: space-between; gap: 8px; align-items: center; padding: 2px 0;">
                                <span class="table-mono" style="color: var(--text-muted);">@(e.Fingerprint.Length > 12 ? e.Fingerprint[..12] : e.Fingerprint)…</span>
                                <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--primary);">→ @e.ModelName</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 6px; font-size: 0.8rem;">
                        <div class="text-secondary">
                            当前亲和映射: <strong class="table-mono" style="color: @(AffinityState.Enabled ? "var(--primary)" : "var(--text-muted)");">@UiFormatter.FormatNumber(AffinityState.TotalCount)</strong> 条
                        </div>
                        <div class="text-secondary" style="font-size: 0.75rem;">
                            @(AffinityState.Enabled
                                ? "已就绪：正在捕获 Prompt 公共前缀指纹哈希"
                                : "未启用：根据请求前缀哈希定向复用供应商 KV Cache")
                        </div>
                    </div>
                }
                <div class="meta-text" style="font-size: 0.72rem; margin-top: 8px;">
                    @(AffinityState.Enabled
                        ? "已开启——按请求 Prompt 前缀将同源会话分发至同一模型提高 KV Cache 命中。"
                        : "未开启（可在「路由控制台」开启 PromptCacheAffinity 提示词亲和）。")
                </div>
            </div>

            <!-- 响应缓存 -->
            <div class="sub-card">
                <div class="card-label" style="margin-bottom: 8px; display: flex; align-items: center; justify-content: space-between;">
                    <span style="display: inline-flex; align-items: center; gap: 6px;">
                        <AppIcon Name="router" Size="14" Class="text-info" />
                        <span>响应缓存</span>
                    </span>
                    <span class="tag @(ResponseCacheStats?.Enabled == true ? "tag-info" : "tag-secondary")" style="font-size: 0.7rem;">
                        @(ResponseCacheStats?.Enabled == true ? "已开启" : "未开启")
                    </span>
                </div>
                @if (ResponseCacheStats != null)
                {
                    <div style="display: flex; flex-direction: column; gap: 6px; font-size: 0.8rem;">
                        <div>
                            命中率: <strong style="color: @(ResponseCacheStats.HitRatePercent >= 50 ? "var(--success)" : ResponseCacheStats.HitRatePercent > 0 ? "var(--warning)" : "var(--text-secondary)");">@UiFormatter.FormatPercent(ResponseCacheStats.HitRatePercent)</strong>
                        </div>
                        <div class="text-secondary">
                            命中 @UiFormatter.FormatNumber(ResponseCacheStats.Hits) · 未命中 @UiFormatter.FormatNumber(ResponseCacheStats.Misses) · 写入 @UiFormatter.FormatNumber(ResponseCacheStats.Sets)
                        </div>
                        <div class="text-secondary">
                            当前条目 @UiFormatter.FormatNumber(ResponseCacheStats.CurrentEntries) / 上限 @UiFormatter.FormatNumber(ResponseCacheStats.MaxEntries)
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-secondary" style="padding: 6px 0; font-size: 0.8rem;">统计不可用</div>
                }
                <div class="meta-text" style="font-size: 0.72rem; margin-top: 8px;">
                    @(ResponseCacheStats?.Enabled == true
                        ? "已开启——仅非流式请求参与缓存；计数全为 0 表示暂无可缓存流量。"
                        : "未开启（可在「路由控制台」热启用）。")
                </div>
            </div>
        </div>
    </div>

    <!-- 实时请求流预览 -->
    <div class="glass-card">
        <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; font-size: 1rem;">
            <span>实时请求流 (Live Request Stream)</span>
            <NavLink href="/requests" class="nav-link" style="font-size: 0.85rem; display: inline-flex; align-items: center; gap: 4px;">
                <span>查看全部请求</span>
                <AppIcon Name="arrow-right" Size="14" />
            </NavLink>
        </div>
        @if (RecentRequests.Any())
        {
            <div class="table-wrap">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th scope="col">时间</th><th scope="col">请求 ID</th><th scope="col">路由模型</th><th scope="col">分档 Tier</th><th scope="col">请求内容</th><th scope="col">Tokens (In/Out)</th><th scope="col">延迟 / TTFT</th><th scope="col">成本</th><th scope="col">类型</th><th scope="col">状态</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in RecentRequests)
                        {
                            <tr>
                                <td>@r.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                                <td><code style="font-size: 0.8rem; color: var(--ok-text-strong);">@(string.IsNullOrEmpty(r.RequestId) ? "-" : Truncate(r.RequestId, 10))</code></td>
                                <td><strong>@r.Model</strong></td>
                                <td><span class="tag tag-info">@r.RoutedTier</span></td>
                                <td><span style="font-size: 0.8rem; color: var(--text-secondary); max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block;">@(string.IsNullOrEmpty(r.RequestContent) ? "-" : Truncate(r.RequestContent, 30))</span></td>
                                <td class="table-mono">@UiFormatter.FormatNumber(r.PromptTokens) / @UiFormatter.FormatNumber(r.CompletionTokens)</td>
                                <td>@UiFormatter.FormatLatency(r.LatencyMs) / @(r.TimeToFirstTokenMs is { } reqTtft ? UiFormatter.FormatLatency(reqTtft) : "--")</td>
                                <td style="color: var(--ok-text); font-weight: bold;">@UiFormatter.FormatCost(r.Cost)</td>
                                <td>
                                    <span class="tag tag-secondary">@(r.IsStreaming ? "流式" : "JSON")</span>
                                    @if (!string.IsNullOrEmpty(r.FusionRole))
                                    {
                                        <span class="tag tag-info">@r.FusionRole</span>
                                    }
                                </td>
                                <td>
                                    @if (r.Success)
                                    {
                                        <span class="tag tag-success">
                                            <AppIcon Name="check" Size="12" />
                                            <span>成功</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="tag tag-danger">
                                            <AppIcon Name="alert" Size="12" />
                                            <span>失败</span>
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <EmptyState Icon="requests" Title="暂无实时请求流数据" Description="当客户端向 OptiRouter 发起 API 代理请求时，实时链路、Token 与费用数据将在此自动呈现。" />
        }
    </div>
</div>

@code {
    private ApiService.DashboardMetrics? Metrics;
    private bool MetricsLoading = true;
    private List<ApiService.DailySpend> Trends = new();
    private List<ApiService.AlertInfo> Alerts => Metrics?.System.Alerts ?? new();
    private List<ApiService.AlertEventDto> AlertHistory = new();

    // 路由内部状态：上游配额 / 缓存亲和 / 响应缓存。低频刷新（每 3 个轮询周期一次）。
    private List<ApiService.QuotaStateDto> QuotaStates = new();
    private ApiService.AffinityPageDto AffinityState = new(0, new List<ApiService.AffinityStateDto>());
    private ApiService.ResponseCacheStatsDto? ResponseCacheStats;
    private int _stateTick;

    // 多窗口统计：Tab 选项 + 当前选中窗口 + 数据。默认 24h。
    private static readonly string[] WindowOptions = { "1h", "7h", "24h", "7d", "15d", "30d", "all" };
    private static readonly Dictionary<string, string> WindowLabels = new()
    {
        ["1h"] = "1小时", ["7h"] = "7小时", ["24h"] = "24小时",
        ["7d"] = "7天", ["15d"] = "15天", ["30d"] = "30天", ["all"] = "全部"
    };
    private string WindowKey = "24h";
    private ApiService.WindowSummary? WindowData;
    private int TrendDays = 7;

    private IReadOnlyList<ApiService.RecentRequestItem> RecentRequests
        => Metrics?.System.RecentRequests?.Take(8).ToList() ?? new List<ApiService.RecentRequestItem>();

    private ElementReference ChartCanvas;
    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    private double BudgetPercent
    {
        get
        {
            if (Metrics?.System.Budget == null) return 0;
            var limit = (double)Metrics.System.Budget.DailyBudgetUsd;
            if (limit <= 0) return 0;
            var spend = (double)Metrics.System.Budget.DailySpend;
            return Math.Min(100.0, (spend / limit) * 100.0);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadMetrics();
        await LoadTrends();
        await LoadWindowSummary();
        await LoadInternalState();

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        _ = PollMetricsLoopAsync();
    }

    private bool _chartDrawn;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 首次渲染时 Canvas 才绑定，但 OnInitializedAsync 的加载往往尚未完成（Trends 为空）。
        // 数据就绪后的重渲染必须补画，否则图表空白、只能靠点击天数按钮才显示；
        // 何时出现"数据先于首渲染就绪"是竞态（本地快加载画得出、慢加载画不出）。
        if (!_chartDrawn && Trends.Any())
        {
            _chartDrawn = true;
            await RenderChart();
        }
    }

    private async Task PollMetricsLoopAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                await LoadMetrics();
                await LoadWindowSummary();
                _stateTick++;
                if (_stateTick % 3 == 0)
                {
                    await LoadInternalState();
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { } // circuit 拆除后 dispatcher 失效，轮询自行退出
    }

    private async Task LoadInternalState()
    {
        try
        {
            var quotaTask = Api.GetQuotaStateAsync();
            var affinityTask = Api.GetCacheAffinityAsync();
            var cacheStatsTask = Api.GetResponseCacheStatsAsync();
            var alertHistoryTask = Api.GetAlertHistoryAsync();
            await Task.WhenAll(quotaTask, affinityTask, cacheStatsTask, alertHistoryTask);
            QuotaStates = quotaTask.Result;
            AffinityState = affinityTask.Result;
            ResponseCacheStats = cacheStatsTask.Result;
            AlertHistory = alertHistoryTask.Result;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Overview LoadInternalState failed");
        }
    }

    private async Task LoadMetrics()
    {
        try
        {
            Metrics = await Api.GetMetricsAsync();
            MetricsLoading = false;
        }
        catch (Exception ex)
        {
            // 静默降级保留诊断线索：仪表盘数据停止更新时可定位原因
            Logger.LogDebug(ex, "Overview LoadMetrics failed");
            MetricsLoading = false;
        }
    }

    private async Task LoadTrends()
    {
        try
        {
            Trends = await Api.GetTrendsAsync(TrendDays);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Overview LoadTrends failed");
        }
    }

    private async Task SetTrendDays(int days)
    {
        TrendDays = days;
        await LoadTrends();
        await RenderChart(); // 切换天数时 Canvas 已绑定，立即重绘
    }

    private async Task SetWindow(string key)
    {
        WindowKey = key;
        _windowVersion++;
        await LoadWindowSummary();
    }

    private int _windowVersion;

    private async Task LoadWindowSummary()
    {
        try
        {
            int version = _windowVersion;
            var data = await Api.GetWindowSummaryAsync(WindowKey);
            // 丢弃过期响应：切换窗口瞬间轮询在途请求后返回时，不得覆盖新窗口数据
            if (version != _windowVersion) return;
            WindowData = data;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Overview LoadWindowSummary failed");
        }
    }

    private async Task RenderChart()
    {
        if (Trends == null || !Trends.Any()) return;
        // drawTrendChart 期望 [{date, amount}]；显式 camelCase 匿名对象避免序列化策略差异。
        var payload = Trends.Select(t => new { date = t.Date, amount = (double)t.Amount }).ToArray();

        try
        {
            await JS.InvokeVoidAsync("drawTrendChart", ChartCanvas, payload);
        }
        catch (Exception ex)
        {
            // Canvas 未绑定/JS 未就绪是常见场景，降级为 Debug 便于排查图表不渲染
            Logger.LogDebug(ex, "Overview RenderChart JS invoke failed");
        }
    }

    private static string Truncate(string val, int maxLen)
    {
        if (string.IsNullOrEmpty(val)) return "-";
        return val.Length <= maxLen ? val : val[..maxLen] + "...";
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _timer?.Dispose();
    }
}
