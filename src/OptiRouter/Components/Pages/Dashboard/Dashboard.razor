@page "/dashboard"
@inject ApiService Api
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>OptiRouter - 监控面板</PageTitle>

<div class="page-grid">
    <!-- 侧边栏 -->
    <aside class="sidebar">
        <!-- 日预算 -->
        <div class="glass-card">
            <div class="card-label">日预算消耗</div>
            <div class="stat-value">$@((Metrics?.System.Budget.DailySpend ?? 0).ToString("F6"))</div>
            <div class="budget-bar">
                <div class="budget-fill" style="width: @(BudgetPercent)%"></div>
            </div>
            <div class="budget-text">
                <span>@BudgetPercent.ToString("F2")% 已用</span>
                <span>上限 $@((Metrics?.System.Budget.DailyBudgetUsd ?? 0).ToString("F2"))</span>
            </div>
        </div>

        <!-- 累计消费 -->
        <div class="glass-card">
            <div class="card-label">累计消费</div>
            <div class="stat-value" style="color:#38bdf8;">$@((Metrics?.System.Budget.TotalSpend ?? 0).ToString("F6"))</div>
            <div class="meta-text">服务启动以来的合计</div>
        </div>

        <!-- 请求统计 -->
        <div class="glass-card">
            <div class="card-label">请求统计</div>
            <div class="stat-row">
                <span class="stat-row-label">QPS（1分钟）</span>
                <span class="stat-row-val">@((Metrics?.System.Qps ?? 0).ToString("F1"))</span>
            </div>
            <div class="stat-row">
                <span class="stat-row-label">总请求数</span>
                <span class="stat-row-val">@((Metrics?.System.TotalRequests ?? 0).ToString("N0"))</span>
            </div>
            <div class="stat-row">
                <span class="stat-row-label">总 Token 数</span>
                <span class="stat-row-val">@((Metrics?.System.TotalTokens ?? 0).ToString("N0"))</span>
            </div>
            <div class="stat-row">
                <span class="stat-row-label">平均延迟</span>
                <span class="stat-row-val">@((Metrics?.System.AvgLatencyMs ?? 0).ToString("F1")) ms</span>
            </div>
            <div class="stat-row">
                <span class="stat-row-label">平均 TTFT</span>
                <span class="stat-row-val">@(Metrics?.System.AvgTtftMs is { } ttft ? $"{ttft:F1} ms" : "--")</span>
            </div>
            <div class="stat-row">
                <span class="stat-row-label">缓存命中/写入</span>
                <span class="stat-row-val">@((Metrics?.System.CachedInputTokens ?? 0).ToString("N0")) / @((Metrics?.System.CacheWriteInputTokens ?? 0).ToString("N0"))</span>
            </div>
        </div>

        <!-- 路由引擎 -->
        <div class="glass-card">
            <div class="card-label">路由引擎</div>
            <div class="stat-row">
                <span class="stat-row-label">故障转移</span>
                <span class="@(IsEnabled(Metrics?.System.Routing.EnableFailover))">@(Metrics?.System.Routing.EnableFailover == true ? "启用" : "禁用")</span>
            </div>
            <div class="stat-row">
                <span class="stat-row-label">预算防护</span>
                <span class="@(IsEnabled(Metrics?.System.Routing.EnableBudgetGuard))">@(Metrics?.System.Routing.EnableBudgetGuard == true ? "启用" : "禁用")</span>
            </div>
            <div class="stat-row">
                <span class="stat-row-label">分类器</span>
                <span class="@(IsEnabled(Metrics?.System.Routing.EnableRuleClassifier))">@(Metrics?.System.Routing.EnableRuleClassifier == true ? "启用" : "禁用")</span>
            </div>
            <div class="stat-row">
                <span class="stat-row-label">延迟感知</span>
                <span class="@(IsEnabled(Metrics?.System.Routing.EnableLatencyAware))">@(Metrics?.System.Routing.EnableLatencyAware == true ? "启用" : "禁用")</span>
            </div>
            <div class="stat-row">
                <span class="stat-row-label">语义路由</span>
                <span class="@(IsEnabled(Metrics?.System.Routing.EnableSemanticRouter))">@(Metrics?.System.Routing.EnableSemanticRouter == true ? "启用" : "禁用")</span>
            </div>
        </div>
    </aside>

    <!-- 主内容 -->
    <div class="content-area">
        <!-- 告警 -->
        @if (Alerts.Any())
        {
            <div class="alert-banner alert-@Alerts.First().Level">
                <span class="indicator pulse"></span>
                <span>@string.Join(" | ", Alerts.Select(a => a.Message))</span>
            </div>
        }

        <!-- 系统策略与预算动态控制面板 -->
        <div class="glass-card" style="margin-bottom: 20px; background: linear-gradient(135deg, rgba(30,41,59,0.9), rgba(15,23,42,0.9)); border: 1px solid rgba(56,189,248,0.3); padding: 18px 20px;">
            <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; font-size: 1rem; color: #38bdf8;">
                <span>⚙️ 系统路由策略与预算配置控制台 (UI Config Studio)</span>
                <button class="btn-primary" @onclick="SaveSystemConfig" disabled="@IsConfigSaving" style="padding: 4px 16px; font-size: 0.85rem;">
                    @(IsConfigSaving ? "热更新保存中..." : "💾 保存并热生效")
                </button>
            </div>
            
            @if (!string.IsNullOrEmpty(ConfigStatusMsg))
            {
                <div class="tag tag-success" style="margin: 8px 0; padding: 6px 12px; font-size: 0.85rem;">@ConfigStatusMsg</div>
            }

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-top: 14px;">
                <label style="display: flex; align-items: center; gap: 8px; color: #cbd5e1; font-size: 0.85rem; cursor: pointer;">
                    <input type="checkbox" @bind="CfgFailover" /> 故障转移策略
                </label>
                <label style="display: flex; align-items: center; gap: 8px; color: #cbd5e1; font-size: 0.85rem; cursor: pointer;">
                    <input type="checkbox" @bind="CfgBudgetGuard" /> 预算防护策略
                </label>
                <label style="display: flex; align-items: center; gap: 8px; color: #cbd5e1; font-size: 0.85rem; cursor: pointer;">
                    <input type="checkbox" @bind="CfgRuleClassifier" /> 规则分类器
                </label>
                <label style="display: flex; align-items: center; gap: 8px; color: #cbd5e1; font-size: 0.85rem; cursor: pointer;">
                    <input type="checkbox" @bind="CfgLatencyAware" /> 历史延迟感知重排
                </label>
                <label style="display: flex; align-items: center; gap: 8px; color: #cbd5e1; font-size: 0.85rem; cursor: pointer;">
                    <input type="checkbox" @bind="CfgSemanticRouter" /> 语义向量路由
                </label>
                <label style="display: flex; align-items: center; gap: 8px; color: #cbd5e1; font-size: 0.85rem; cursor: pointer;">
                    <input type="checkbox" @bind="CfgPiiAnonymization" /> PII 隐私脱敏
                </label>
                <label style="display: flex; align-items: center; gap: 8px; color: #cbd5e1; font-size: 0.85rem; cursor: pointer;">
                    <input type="checkbox" @bind="CfgDataSovereignty" /> 数据不出域隔离
                </label>
                <label style="display: flex; align-items: center; gap: 8px; color: #cbd5e1; font-size: 0.85rem; cursor: pointer;">
                    <input type="checkbox" @bind="CfgJsonAstAutoRepair" /> JSON AST 自动修复
                </label>
                <label style="display: flex; align-items: center; gap: 8px; color: #cbd5e1; font-size: 0.85rem; cursor: pointer;">
                    <input type="checkbox" @bind="CfgFusionRouter" /> Fusion MoA 融合路由
                </label>
            </div>

            <div style="display: flex; gap: 20px; align-items: center; margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.08);">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="color: #9ca3af; font-size: 0.85rem;">日预算 (USD):</span>
                    <input type="number" step="1.0" min="0" @bind="CfgDailyBudgetUsd" style="width: 100px; background: rgba(15,23,42,0.8); color: #34d399; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 4px 8px; font-weight: bold;" />
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="color: #9ca3af; font-size: 0.85rem;">预算耗尽行为:</span>
                    <select @bind="CfgEnforceBehavior" style="background: rgba(15,23,42,0.8); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 4px 8px;">
                        <option value="Degrade">Degrade (降级至 Cheap)</option>
                        <option value="Reject">Reject (直接拒绝 429)</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- 智能降本 ROI 归因卡片 -->
        <div class="glass-card roi-card" style="background: linear-gradient(135deg, rgba(16,185,129,0.12), rgba(59,130,246,0.12)); border: 1px solid rgba(16,185,129,0.3); padding: 18px 20px; margin-bottom: 20px;">
            <div class="card-label" style="color: #34d399; font-weight: 600; font-size: 1rem;">智能降本 ROI 归因看板</div>
            <div style="display: flex; align-items: baseline; gap: 16px; margin: 10px 0;">
                <div class="stat-value" style="color: #10b981; font-size: 2.2rem; font-weight: 700;">$@((Metrics?.System.Roi?.SavedUsd ?? 0).ToString("F6"))</div>
                <div style="background: rgba(16,185,129,0.2); color: #34d399; padding: 4px 12px; border-radius: 12px; font-weight: bold; font-size: 1rem;">
                    智能路由降本 @((Metrics?.System.Roi?.SavingRatePercent ?? 0).ToString("F1"))%
                </div>
            </div>
            <div class="meta-text" style="color: #9ca3af; font-size: 0.85rem;">
                基线预估成本（全使用强模型）：$@((Metrics?.System.Roi?.BaselineCostUsd ?? 0).ToString("F6")) | 实际优化处理成本：$@((Metrics?.System.Roi?.ActualCostUsd ?? 0).ToString("F6"))
            </div>
        </div>

        <!-- 数据安全与 PII 脱敏防护看板 -->
        <div class="glass-card" style="background: linear-gradient(135deg, rgba(99,102,241,0.12), rgba(168,85,247,0.12)); border: 1px solid rgba(168,85,247,0.3); padding: 18px 20px; margin-bottom: 20px;">
            <div class="card-label" style="color: #c084fc; font-weight: 600; font-size: 1rem; display: flex; justify-content: space-between;">
                <span>数据合规与 PII 敏感隐私防护看板</span>
                <span class="tag tag-info">数据不出域: @(Metrics?.System.Security?.DataSovereigntyEnabled == true ? "已开启" : "未开启")</span>
            </div>
            <div style="display: flex; align-items: baseline; gap: 16px; margin: 10px 0;">
                <div class="stat-value" style="color: #a855f7; font-size: 2.2rem; font-weight: 700;">@((Metrics?.System.Security?.PiiProtectedTotal ?? 0).ToString("N0")) <span style="font-size: 1rem; font-weight: normal; color: #d8b4fe;">次敏感项自动脱敏保护</span></div>
            </div>
            <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px;">
                <span class="tag tag-secondary">📱 手机号: @((Metrics?.System.Security?.PhoneProtected ?? 0).ToString("N0"))</span>
                <span class="tag tag-secondary">📧 邮箱: @((Metrics?.System.Security?.EmailProtected ?? 0).ToString("N0"))</span>
                <span class="tag tag-secondary">🆔 身份证: @((Metrics?.System.Security?.IdCardProtected ?? 0).ToString("N0"))</span>
                <span class="tag tag-secondary">💳 银行卡: @((Metrics?.System.Security?.CreditCardProtected ?? 0).ToString("N0"))</span>
                <span class="tag tag-secondary">🌐 IP 地址: @((Metrics?.System.Security?.IpProtected ?? 0).ToString("N0"))</span>
            </div>
        </div>

        <!-- 费用趋势图 -->
        <div class="glass-card">
            <div class="card-label">费用趋势</div>
            <div class="trend-controls">
                <button class="@(TrendDays == 7 ? "active" : "")" @onclick="() => SetTrendDays(7)">近7天</button>
                <button class="@(TrendDays == 30 ? "active" : "")" @onclick="() => SetTrendDays(30)">近30天</button>
            </div>
            <div class="chart-container">
                <canvas id="trend-chart" @ref="ChartCanvas"></canvas>
            </div>
        </div>

        <!-- 快速统计 -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-card-label">QPS（1分钟）</div>
                <div class="stat-card-val">@((Metrics?.System.Qps ?? 0).ToString("F1"))</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">总请求数</div>
                <div class="stat-card-val">@((Metrics?.System.TotalRequests ?? 0).ToString("N0"))</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">总 Token 数</div>
                <div class="stat-card-val">@((Metrics?.System.TotalTokens ?? 0).ToString("N0"))</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">平均延迟</div>
                <div class="stat-card-val">@((Metrics?.System.AvgLatencyMs ?? 0).ToString("F1")) ms</div>
            </div>
        </div>

        <!-- 实时请求流瀑布流 (Live Stream) -->
        <div class="glass-card" style="margin-bottom: 20px;">
            <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; font-size: 1rem;">
                <span>实时请求流 (Live Request Stream)</span>
                <span class="tag tag-success" style="font-size: 0.75rem;">● 实时抓取</span>
            </div>
            <div class="table-wrap">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>时间</th><th>请求 ID</th><th>路由模型</th><th>分档 Tier</th><th>Tokens (In/Out)</th><th>延迟 / TTFT</th><th>成本</th><th>类型</th><th>状态</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Metrics?.System.RecentRequests != null && Metrics.System.RecentRequests.Any())
                        {
                            @foreach (var r in Metrics.System.RecentRequests)
                            {
                                <tr>
                                    <td>@r.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                                    <td><code style="font-size: 0.8rem; color: #a7f3d0;">@(string.IsNullOrEmpty(r.RequestId) ? "-" : Truncate(r.RequestId, 10))</code></td>
                                    <td><strong>@r.Model</strong></td>
                                    <td><span class="tag tag-info">@r.RoutedTier</span></td>
                                    <td>@r.PromptTokens / @r.CompletionTokens</td>
                                    <td>@r.LatencyMs.ToString("F0") ms / @(r.TimeToFirstTokenMs is { } reqTtft ? $"{reqTtft:F0} ms" : "--")</td>
                                    <td style="color: #34d399; font-weight: bold;">$@r.Cost.ToString("F6")</td>
                                    <td>
                                        <span class="tag tag-secondary">@(r.IsStreaming ? "流式" : "JSON")</span>
                                        @if (!string.IsNullOrEmpty(r.FusionRole))
                                        {
                                            <span class="tag tag-info">@r.FusionRole</span>
                                        }
                                    </td>
                                    <td class="@(r.Success ? "text-success" : "text-danger")">
                                        @(r.Success ? "✓ 成功" : "✗ 失败")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="9" class="text-center text-secondary">暂无实时请求流数据</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 分布式 DAG 链路拓扑与 Fusion MoA 瀑布流 -->
        <div class="glass-card" style="margin-bottom: 20px;">
            <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; font-size: 1rem;">
                <span>分布式 DAG 链路拓扑与 Fusion MoA 甘特图 (DAG Trace Visualizer)</span>
                <span class="tag tag-info">W3C Traceparent 标准</span>
            </div>
            @if (Metrics?.System.DagTraces != null && Metrics.System.DagTraces.Any())
            {
                @foreach (var dag in Metrics.System.DagTraces)
                {
                    <div style="background: rgba(15,23,42,0.6); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 12px; margin-top: 12px;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                            <span style="font-family: monospace; color: #38bdf8; font-weight: 600;">Group ID: @Truncate(dag.GroupId ?? "-", 16)</span>
                            <span style="color: #34d399; font-weight: bold;">DAG 总成本: $@dag.TotalCost.ToString("F6") | 最大延迟: @dag.MaxLatencyMs.ToString("F0") ms</span>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            @foreach (var span in dag.Spans)
                            {
                                double widthPct = dag.MaxLatencyMs > 0 ? Math.Min(100.0, Math.Max(10.0, (span.LatencyMs / dag.MaxLatencyMs) * 100.0)) : 100.0;
                                string roleBg = span.Role switch
                                {
                                    "panel" => "#3b82f6",
                                    "analyst" => "#8b5cf6",
                                    "outer" => "#10b981",
                                    "cascade" => "#f59e0b",
                                    _ => "#64748b"
                                };
                                <div style="display: flex; align-items: center; gap: 10px; font-size: 0.85rem;">
                                    <span style="width: 80px; text-transform: uppercase; font-weight: bold; color: @roleBg;">[@span.Role]</span>
                                    <span style="width: 120px; font-weight: 600; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">@span.Model</span>
                                    <div style="flex: 1; background: rgba(255,255,255,0.05); border-radius: 4px; height: 18px; overflow: hidden; position: relative;">
                                        <div style="background: @roleBg; width: @widthPct.ToString("F0")%; height: 100%; border-radius: 4px; transition: width 0.3s ease;"></div>
                                    </div>
                                    <span style="width: 90px; text-align: right; color: #cbd5e1;">@span.LatencyMs.ToString("F0") ms</span>
                                    <span style="width: 80px; text-align: right; color: #34d399;">$@span.Cost.ToString("F6")</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-secondary text-center" style="padding: 16px;">暂无 Fusion / Cascade DAG Trace 采样数据</div>
            }
        </div>

        <!-- 交互式路由匹配沙盒 (Router Sandbox) -->
        <div class="glass-card" style="margin-bottom: 20px;">
            <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; font-size: 1rem;">
                <span>交互式路由决策沙盒 (Route Playground Sandbox)</span>
                <span class="tag tag-success">即时路由仿真</span>
            </div>
            <div style="margin-top: 10px; display: flex; gap: 12px; flex-direction: column;">
                <textarea class="form-control" rows="3" placeholder="在此输入测试 Prompt（如：写个快速排序、求微积分积分、翻译文本...）" @bind="SandboxInputPrompt" style="background: rgba(15,23,42,0.8); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 10px; font-family: inherit; width: 100%;"></textarea>
                <div style="display: flex; justify-content: flex-end;">
                    <button class="btn-primary" @onclick="RunSandbox" disabled="@IsSandboxRunning" style="padding: 6px 18px;">
                        @(IsSandboxRunning ? "路由仿真中..." : "🚀 运行路由匹配测试")
                    </button>
                </div>
            </div>
            @if (SandboxResultData != null)
            {
                <div style="background: rgba(15,23,42,0.7); border: 1px solid rgba(56,189,248,0.3); border-radius: 8px; padding: 14px; margin-top: 12px;">
                    <div style="display: flex; gap: 16px; align-items: center; margin-bottom: 10px;">
                        <span style="font-weight: bold;">命中 Target Tier:</span>
                        <span class="badge badge-info" style="font-size: 0.9rem;">@SandboxResultData.TargetTier</span>
                        <span style="color: #9ca3af; font-size: 0.85rem;">估算 Prompt Tokens: @SandboxResultData.EstimatedTokens</span>
                    </div>
                    <div style="margin-bottom: 8px; font-size: 0.85rem; color: #cbd5e1;">
                        <strong>匹配 Policy 逻辑链：</strong>
                        <ul style="margin: 4px 0 0 16px; padding: 0;">
                            @foreach (var reason in SandboxResultData.Reasons)
                            {
                                <li><span style="color: #38bdf8;">[@reason.PolicyName]</span> @reason.Message</li>
                            }
                        </ul>
                    </div>
                    <div style="font-size: 0.85rem; color: #34d399;">
                        <strong>推荐模型候选链：</strong> @string.Join(" → ", SandboxResultData.CandidateModels)
                    </div>
                </div>
            }
        </div>

        <!-- Golden Dataset 离线回归评测中心 (Eval Studio) -->
        <div class="glass-card" style="margin-bottom: 20px;">
            <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; font-size: 1rem;">
                <span>Golden Dataset 离线回归评测工作室 (Eval Studio)</span>
                <button class="btn-primary" @onclick="RunEval" disabled="@IsEvalRunning" style="padding: 4px 12px; font-size: 0.85rem;">
                    @(IsEvalRunning ? "自动化评测中..." : "🧪 一键运行 Golden 题库回归评测")
                </button>
            </div>
            @if (EvalReportData != null)
            {
                <div style="background: rgba(15,23,42,0.7); border: 1px solid rgba(168,85,247,0.3); border-radius: 8px; padding: 14px; margin-top: 12px;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 12px; align-items: center;">
                        <span style="font-family: monospace; color: #c084fc; font-weight: bold;">Batch ID: @EvalReportData.BatchId</span>
                        <div style="display: flex; gap: 12px;">
                            <span class="tag tag-success">准确率: @((EvalReportData.AccuracyRate * 100).ToString("F1"))%</span>
                            <span class="tag tag-info">平均延迟: @EvalReportData.AvgLatencyMs.ToString("F0") ms</span>
                            <span class="tag tag-secondary">总 Tokens: @EvalReportData.TotalTokens.ToString("N0")</span>
                        </div>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        @foreach (var res in EvalReportData.Results)
                        {
                            <div style="background: rgba(255,255,255,0.03); border-radius: 6px; padding: 8px 12px; font-size: 0.85rem; display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <span style="color: #e2e8f0; font-weight: 600;">[@res.TestCase.Category] @res.TestCase.Question</span>
                                    <div style="color: #9ca3af; font-size: 0.75rem; margin-top: 2px;">输出: @Truncate(res.ActualAnswer, 40)</div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <span style="color: #38bdf8; font-size: 0.8rem;">Jaccard 相似度: @((res.SimilarityScore * 100).ToString("F0"))%</span>
                                    <span class="@(res.Passed ? "text-success" : "text-danger")" style="font-weight: bold;">@(res.Passed ? "✓ 通过" : "✗ 未通过")</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- 模型卡片 -->
        <div class="models-grid">
            @if (Metrics?.Models != null)
            {
                @foreach (var m in Metrics.Models)
                {
                    <div class="model-card state-@m.CircuitState.ToLower()">
                        <div class="card-header-row">
                            <div>
                                <div class="model-name">@m.Name</div>
                                <div class="model-tier">@m.Tier Tier</div>
                            </div>
                            <span class="badge badge-@CircuitBadge(m.CircuitState)">@CircuitText(m.CircuitState)</span>
                        </div>

                        <div class="info-grid">
                            <span class="info-label">BaseUrl</span>
                            <span class="info-val" title="@m.BaseUrl">@Truncate(m.BaseUrl, 25)</span>
                            <span class="info-label">Provider / Family</span>
                            <span class="info-val">@(string.IsNullOrWhiteSpace(m.Provider) ? "-" : m.Provider) / @(string.IsNullOrWhiteSpace(m.Family) ? "-" : m.Family)</span>
                            <span class="info-label">输入 $/M</span>
                            <span class="info-val">$@m.InputPricePerMillion.ToString("F2")</span>
                            <span class="info-label">缓存命中 / 写入 $/M</span>
                            <span class="info-val">@(m.CachedInputPricePerMillion?.ToString("F2") ?? "回退") / @(m.CacheWriteInputPricePerMillion?.ToString("F2") ?? "回退")</span>
                            <span class="info-label">输出 $/M</span>
                            <span class="info-val">$@m.OutputPricePerMillion.ToString("F2")</span>
                            <span class="info-label">最大上下文</span>
                            <span class="info-val">@m.MaxContextTokens.ToString("N0")</span>
                            <span class="info-label">Tags</span>
                            <span class="info-val" title="@string.Join(", ", m.Tags ?? new())">@(m.Tags?.Any() == true ? string.Join(", ", m.Tags) : "-")</span>
                        </div>

                        <div class="metrics-row">
                            <div class="metric-item">
                                <span class="metric-label">失败次数</span>
                                <span class="metric-val @(m.FailureCount > 0 ? "text-danger" : "")">@m.FailureCount</span>
                            </div>
                            <div class="metric-item" style="text-align:center;">
                                <span class="metric-label">平均延迟</span>
                                <span class="metric-val @(m.LatencySamples > 0 ? "text-primary" : "")">@(m.LatencySamples > 0 ? $"{m.AvgLatencyMs:F0} ms" : "--")</span>
                            </div>
                            <div class="metric-item" style="text-align:center;">
                                <span class="metric-label">延迟样本</span>
                                <span class="metric-val">@m.LatencySamples</span>
                            </div>
                            <div class="metric-item" style="text-align:right;">
                                <span class="metric-label">活跃探测</span>
                                <span class="metric-val @(m.ActiveProbes > 0 ? "text-warning" : "")">@m.ActiveProbes</span>
                            </div>
                        </div>

                        <div style="display: flex; gap: 8px; justify-content: flex-end; margin-top: 10px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.06);">
                            <button class="btn-ghost btn-sm" @onclick='() => OverrideCircuit(m.Name, "Closed")' style="color: #34d399; font-size: 0.75rem;" title="重置断路器为闭合正常状态">⚡ 恢复正常</button>
                            <button class="btn-ghost btn-sm" @onclick='() => OverrideCircuit(m.Name, "Open")' style="color: #f43f5e; font-size: 0.75rem;" title="强制下线该端点进行运维隔离">🚫 强行隔离</button>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- 🔑 客户端 API Key 与租户配额控制台 (Client Quota Studio) -->
        <div class="glass-card" style="margin-bottom: 20px;">
            <div class="card-label" style="display: flex; justify-content: space-between; align-items: center; font-size: 1rem; color: #c084fc;">
                <span>🔑 客户端 API Key 与租户配额控制台 (Client Quota Studio)</span>
                <button class="btn-primary" @onclick="ToggleAddKeyForm" style="padding: 4px 12px; font-size: 0.85rem;">
                    @(ShowAddKeyForm ? "- 取消签发" : "+ 签发租户 API Key")
                </button>
            </div>

            @if (ShowAddKeyForm)
            {
                <div style="background: rgba(15,23,42,0.7); border: 1px solid rgba(168,85,247,0.3); border-radius: 8px; padding: 14px; margin-top: 12px; margin-bottom: 12px;">
                    <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
                        <input type="text" placeholder="租户/部门名称 (如: 财务部 App)" @bind="NewTenantName" style="background: rgba(15,23,42,0.8); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 6px 10px; width: 220px;" />
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <span style="color: #9ca3af; font-size: 0.85rem;">日预算 ($):</span>
                            <input type="number" step="10" min="0" @bind="NewTenantBudget" style="width: 100px; background: rgba(15,23,42,0.8); color: #34d399; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 6px 10px;" />
                        </div>
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <span style="color: #9ca3af; font-size: 0.85rem;">QPS 上限:</span>
                            <input type="number" step="5" min="1" @bind="NewTenantQps" style="width: 80px; background: rgba(15,23,42,0.8); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 6px 10px;" />
                        </div>
                        <button class="btn-primary" @onclick="CreateClientKey" style="padding: 6px 16px;">确认签发</button>
                    </div>
                </div>
            }

            <div class="table-wrap" style="margin-top: 12px;">
                <table class="config-table">
                    <thead>
                        <tr>
                            <th>租户/部门</th><th>API Key</th><th>日预算 ($)</th><th>QPS 限制</th><th>状态</th><th>签发时间</th><th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ClientKeys.Any())
                        {
                            @foreach (var k in ClientKeys)
                            {
                                <tr>
                                    <td><strong>@k.TenantName</strong></td>
                                    <td style="font-family: monospace; color: #c084fc;">@k.KeyPrefix</td>
                                    <td>$@k.DailyBudgetUsd.ToString("N0")</td>
                                    <td>@k.MaxQps QPS</td>
                                    <td>
                                        <span class="@(k.Enabled ? "text-success" : "text-secondary")" style="font-weight: bold;">@(k.Enabled ? "正常" : "已禁用")</span>
                                    </td>
                                    <td>@k.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    <td style="display: flex; gap: 6px;">
                                        <button class="btn-ghost btn-sm" @onclick="() => ToggleKeyEnabled(k)">@(k.Enabled ? "禁用" : "启用")</button>
                                        <button class="btn-danger btn-sm" @onclick="() => DeleteKey(k.KeyId)">删除</button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center text-secondary">暂无签发的客户端 API Key，点击上方 "+ 签发租户 API Key" 开始分配。</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 审计日志 -->
        <div class="glass-card">
            <div class="card-label">历史请求审计日志 (点击任意行查看 Debugger Trace 详情)</div>
            <div class="log-controls" style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; align-items: center;">
                <input type="text" placeholder="按模型筛选..." @bind="LogFilterModel" style="width: 140px; background: rgba(15,23,42,0.8); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 4px 8px;" />
                <select @bind="LogFilterTier" style="background: rgba(15,23,42,0.8); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 4px 8px;">
                    <option value="">全能力分档</option>
                    <option value="Strong">Strong</option>
                    <option value="Medium">Medium</option>
                    <option value="Cheap">Cheap</option>
                </select>
                <select @bind="LogFilterStatus" style="background: rgba(15,23,42,0.8); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 4px 8px;">
                    <option value="">全请求状态</option>
                    <option value="200">仅成功 (200 OK)</option>
                    <option value="error">仅失败/异常</option>
                </select>
                <select @bind="LogFilterMinLatency" style="background: rgba(15,23,42,0.8); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 4px 8px;">
                    <option value="0">任意耗时</option>
                    <option value="500">耗时 &gt; 500ms</option>
                    <option value="1000">耗时 &gt; 1000ms</option>
                    <option value="3000">耗时 &gt; 3000ms</option>
                </select>
                <select @bind="LogLimit" style="background: rgba(15,23,42,0.8); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 4px 8px;">
                    <option value="50">每页 50 条</option>
                    <option value="100">每页 100 条</option>
                </select>
                <button class="btn-primary" @onclick="LoadLogs" style="padding: 4px 16px;">🔍 组合筛选</button>
            </div>
            <div class="table-wrap">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>时间</th><th>模型</th><th>Tier</th><th>Token</th><th>缓存 hit/write</th><th>费用</th><th>延迟</th><th>TTFT</th><th>状态</th><th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (AuditItems.Any())
                        {
                            @foreach (var item in AuditItems)
                            {
                                <tr @onclick="() => SelectLogItem(item)" style="cursor: pointer; transition: background 0.2s;" class="hover-row">
                                    <td>@item.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                                    <td><strong>@item.Model</strong></td>
                                    <td><span class="badge badge-info" style="font-size: 0.75rem;">@item.RoutedTier</span></td>
                                    <td>@(item.PromptTokens + item.CompletionTokens)</td>
                                    <td>@item.CachedInputTokens / @item.CacheWriteInputTokens</td>
                                    <td>
                                        $@item.Cost.ToString("F6")
                                        @if (item.IsEstimated)
                                        {
                                            <span class="tag tag-warning">预估</span>
                                        }
                                    </td>
                                    <td>@item.LatencyMs.ToString("F0") ms</td>
                                    <td>@(item.TimeToFirstTokenMs is { } auditTtft ? $"{auditTtft:F0} ms" : "--")</td>
                                    <td class="@(item.Success ? "text-success" : "text-danger")">
                                        @(item.Success ? "成功" : item.QuotaLimited ? "配额受限" : "失败")
                                    </td>
                                    <td>
                                        <button class="btn-ghost btn-sm" @onclick:stopPropagation="true" @onclick="() => SelectLogItem(item)">🔍 详情</button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="10" class="text-center text-secondary">暂无符合条件的日志数据</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination">
                <span class="text-secondary">显示 @AuditItems.Count 条，共 @AuditTotal 条</span>
                <div>
                    <button disabled="@(LogOffset == 0)" @onclick="async () => { LogOffset = Math.Max(0, LogOffset - LogLimit); await LoadLogs(); }">上一页</button>
                    <button disabled="@(LogOffset + LogLimit >= AuditTotal)" @onclick="async () => { LogOffset += LogLimit; await LoadLogs(); }">下一页</button>
                </div>
            </div>
        </div>
    </div>
</div>

@if (SelectedLogItem != null)
{
    <div class="drawer-backdrop" @onclick="() => SelectedLogItem = null" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); z-index: 9999; display: flex; justify-content: flex-end;">
        <div class="drawer-content" @onclick:stopPropagation="true" style="width: 520px; max-width: 90vw; height: 100%; background: #0f172a; border-left: 1px solid rgba(56,189,248,0.3); padding: 20px; overflow-y: auto; color: #e2e8f0; box-shadow: -10px 0 25px rgba(0,0,0,0.5);">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px; margin-bottom: 16px;">
                <span style="font-weight: bold; font-size: 1.1rem; color: #38bdf8;">📌 请求全链路 Debugger Trace</span>
                <button class="btn-ghost" @onclick="() => SelectedLogItem = null" style="font-size: 1.2rem; cursor: pointer;">&times;</button>
            </div>

            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="background: rgba(255,255,255,0.03); border-radius: 6px; padding: 12px;">
                    <div style="color: #9ca3af; font-size: 0.8rem; margin-bottom: 4px;">REQUEST & TRACE ID</div>
                    <div style="font-family: monospace; font-size: 0.85rem; color: #f43f5e; word-break: break-all;">ReqId: @(SelectedLogItem.RequestId ?? "-")</div>
                    <div style="font-family: monospace; font-size: 0.85rem; color: #38bdf8; word-break: break-all; margin-top: 2px;">TraceId: @(SelectedLogItem.TraceId ?? "-")</div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 0.85rem;">
                    <div style="background: rgba(255,255,255,0.03); padding: 8px 10px; border-radius: 6px;">
                        <span style="color: #9ca3af;">命中 Model:</span> <span style="font-weight: bold; color: #38bdf8;">@SelectedLogItem.Model</span>
                    </div>
                    <div style="background: rgba(255,255,255,0.03); padding: 8px 10px; border-radius: 6px;">
                        <span style="color: #9ca3af;">路由 Target Tier:</span> <span class="badge badge-info">@SelectedLogItem.RoutedTier</span>
                    </div>
                    <div style="background: rgba(255,255,255,0.03); padding: 8px 10px; border-radius: 6px;">
                        <span style="color: #9ca3af;">端到端耗时:</span> <span style="font-weight: bold; color: #34d399;">@SelectedLogItem.LatencyMs ms</span>
                    </div>
                    <div style="background: rgba(255,255,255,0.03); padding: 8px 10px; border-radius: 6px;">
                        <span style="color: #9ca3af;">流式 TTFT:</span> <span>@(SelectedLogItem.TimeToFirstTokenMs is { } t ? $"{t} ms" : "--")</span>
                    </div>
                    <div style="background: rgba(255,255,255,0.03); padding: 8px 10px; border-radius: 6px;">
                        <span style="color: #9ca3af;">Token 计费:</span> <span>Prompt: @SelectedLogItem.PromptTokens / Comp: @SelectedLogItem.CompletionTokens</span>
                    </div>
                    <div style="background: rgba(255,255,255,0.03); padding: 8px 10px; border-radius: 6px;">
                        <span style="color: #9ca3af;">计算费用:</span> <span style="color: #34d399; font-weight: bold;">$@SelectedLogItem.Cost.ToString("F6")</span>
                    </div>
                </div>

                <div style="background: rgba(255,255,255,0.03); border-radius: 6px; padding: 12px; margin-top: 4px;">
                    <div style="color: #38bdf8; font-size: 0.85rem; font-weight: bold; margin-bottom: 6px;">🧠 路由决策 Reasons 链</div>
                    <div style="font-size: 0.8rem; color: #cbd5e1; font-family: monospace; white-space: pre-wrap; word-break: break-all; background: rgba(0,0,0,0.3); padding: 8px; border-radius: 4px;">@SelectedLogItem.RoutingReason</div>
                </div>

                @if (!string.IsNullOrEmpty(SelectedLogItem.ErrorMessage))
                {
                    <div style="background: rgba(244,63,94,0.1); border: 1px solid rgba(244,63,94,0.3); border-radius: 6px; padding: 12px;">
                        <div style="color: #f43f5e; font-size: 0.85rem; font-weight: bold;">❌ 异常日志信息</div>
                        <div style="font-size: 0.8rem; color: #fca5a5; font-family: monospace; margin-top: 4px;">@SelectedLogItem.ErrorMessage</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private ApiService.DashboardMetrics? Metrics;
    private List<ApiService.DailySpend> Trends = new();
    private List<ApiService.AlertInfo> Alerts => Metrics?.System.Alerts ?? new();
    private int TrendDays = 7;

    private List<ApiService.AuditItem> AuditItems = new();
    private int AuditTotal = 0;
    private string LogFilterModel = "";
    private int LogLimit = 50;
    private int LogOffset = 0;

    private string LogFilterTier = "";
    private string LogFilterStatus = "";
    private long LogFilterMinLatency = 0;
    private ApiService.AuditItem? SelectedLogItem;

    private async Task SelectLogItem(ApiService.AuditItem item)
    {
        SelectedLogItem = item;
        if (!string.IsNullOrEmpty(item.RequestId))
        {
            var detail = await Api.GetAuditDetailAsync(item.RequestId);
            if (detail != null) SelectedLogItem = detail;
        }
    }

    private async Task LoadLogs()
    {
        try
        {
            var page = await Api.GetAuditLogAsync(LogLimit, LogOffset, LogFilterModel, LogFilterTier, LogFilterStatus, LogFilterMinLatency > 0 ? LogFilterMinLatency : null);
            AuditItems = page.Items;
            AuditTotal = page.TotalCount;
        }
        catch { }
    }

    private string SandboxInputPrompt = "写一个 C# 快速排序算法，并说明空间复杂度";
    private bool IsSandboxRunning = false;
    private ApiService.SandboxResult? SandboxResultData;

    private bool IsEvalRunning = false;
    private ApiService.EvalReportDto? EvalReportData;

    private async Task RunSandbox()
    {
        if (string.IsNullOrWhiteSpace(SandboxInputPrompt)) return;
        IsSandboxRunning = true;
        try
        {
            SandboxResultData = await Api.RunSandboxRouteAsync(SandboxInputPrompt);
        }
        catch { }
        finally
        {
            IsSandboxRunning = false;
        }
    }

    private async Task RunEval()
    {
        IsEvalRunning = true;
        try
        {
            EvalReportData = await Api.RunEvalBenchmarkAsync();
        }
        catch { }
        finally
        {
            IsEvalRunning = false;
        }
    }

    private ElementReference ChartCanvas;
    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    private double BudgetPercent
    {
        get
        {
            if (Metrics?.System.Budget == null) return 0;
            var limit = (double)Metrics.System.Budget.DailyBudgetUsd;
            if (limit <= 0) return 0;
            var spend = (double)Metrics.System.Budget.DailySpend;
            return Math.Min(100.0, (spend / limit) * 100.0);
        }
    }

    private bool CfgFailover = true;
    private bool CfgBudgetGuard = true;
    private bool CfgRuleClassifier = true;
    private bool CfgLatencyAware = false;
    private bool CfgSemanticRouter = true;
    private bool CfgPiiAnonymization = false;
    private bool CfgDataSovereignty = false;
    private bool CfgJsonAstAutoRepair = true;
    private bool CfgFusionRouter = false;
    private decimal CfgDailyBudgetUsd = 10.0m;
    private string CfgEnforceBehavior = "Degrade";
    private bool IsConfigSaving = false;
    private string ConfigStatusMsg = "";

    private async Task LoadSystemConfig()
    {
        try
        {
            var cfg = await Api.GetSystemConfigAsync();
            if (cfg != null)
            {
                CfgFailover = cfg.Routing.EnableFailover;
                CfgBudgetGuard = cfg.Routing.EnableBudgetGuard;
                CfgRuleClassifier = cfg.Routing.EnableRuleClassifier;
                CfgLatencyAware = cfg.Routing.EnableLatencyAware;
                CfgSemanticRouter = cfg.Routing.EnableSemanticRouter;
                CfgPiiAnonymization = cfg.Routing.EnablePiiAnonymization;
                CfgDataSovereignty = cfg.Routing.EnableDataSovereignty;
                CfgJsonAstAutoRepair = cfg.Routing.EnableJsonAstAutoRepair;
                CfgFusionRouter = cfg.Routing.EnableFusionRouter;
                CfgDailyBudgetUsd = cfg.Budget.DailyBudgetUsd;
                CfgEnforceBehavior = cfg.Budget.EnforceOnExhausted;
            }
        }
        catch { }
    }

    private async Task SaveSystemConfig()
    {
        IsConfigSaving = true;
        ConfigStatusMsg = "";
        try
        {
            var req = new ApiService.UpdateSystemConfigRequest(
                CfgFailover, CfgBudgetGuard, CfgRuleClassifier, CfgLatencyAware,
                CfgSemanticRouter, CfgPiiAnonymization, CfgDataSovereignty,
                CfgJsonAstAutoRepair, CfgFusionRouter, CfgDailyBudgetUsd, CfgEnforceBehavior);

            bool ok = await Api.UpdateSystemConfigAsync(req);
            if (ok)
            {
                ConfigStatusMsg = "✓ 配置已热更新并在数据平面实时生效！";
                await LoadMetrics();
            }
            else
            {
                ConfigStatusMsg = "✗ 保存失败，请检查 API Key。";
            }
        }
        catch (Exception ex)
        {
            ConfigStatusMsg = "✗ 错误: " + ex.Message;
        }
        finally
        {
            IsConfigSaving = false;
        }
    }

    private List<ApiService.ClientKeyDto> ClientKeys = new();
    private bool ShowAddKeyForm = false;
    private string NewTenantName = "";
    private decimal NewTenantBudget = 100.0m;
    private int NewTenantQps = 50;

    private async Task LoadClientKeys()
    {
        try
        {
            ClientKeys = await Api.GetClientKeysAsync();
        }
        catch { }
    }

    private void ToggleAddKeyForm()
    {
        ShowAddKeyForm = !ShowAddKeyForm;
        if (ShowAddKeyForm)
        {
            NewTenantName = "";
            NewTenantBudget = 100.0m;
            NewTenantQps = 50;
        }
    }

    private async Task CreateClientKey()
    {
        if (string.IsNullOrWhiteSpace(NewTenantName)) return;
        var created = await Api.CreateClientKeyAsync(NewTenantName, NewTenantBudget, NewTenantQps);
        if (created != null)
        {
            // 明文仅此一次返回：弹窗提示运维立即保存，关闭后服务端只留哈希、不可重取。
            await JS.InvokeVoidAsync("alert",
                $"租户「{created.TenantName}」的新密钥（仅显示一次，请立即保存）：\n\n{created.PlaintextKey}\n\n关闭后将无法再次获取。");
            ShowAddKeyForm = false;
            NewTenantName = "";
            await LoadClientKeys();
        }
    }

    private async Task ToggleKeyEnabled(ApiService.ClientKeyDto k)
    {
        await Api.UpdateClientKeyAsync(k.KeyId, !k.Enabled, k.DailyBudgetUsd, k.MaxQps);
        await LoadClientKeys();
    }

    private async Task DeleteKey(string key)
    {
        await Api.DeleteClientKeyAsync(key);
        await LoadClientKeys();
    }

    private async Task OverrideCircuit(string modelName, string targetState)
    {
        bool ok = await Api.OverrideCircuitStateAsync(modelName, targetState);
        if (ok)
        {
            await LoadMetrics();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadSystemConfig();
        await LoadClientKeys();
        await LoadMetrics();
        await LoadTrends();
        await LoadLogs();

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = PollMetricsLoopAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 首次渲染后 ChartCanvas 才绑定；OnInitializedAsync 阶段 ref 仍为默认，无法绘制。
        if (firstRender)
        {
            await RenderChart();
        }
    }

    private async Task PollMetricsLoopAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                await LoadMetrics();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { } // circuit 拆除后 dispatcher 失效，轮询自行退出
    }

    private async Task LoadMetrics()
    {
        try
        {
            Metrics = await Api.GetMetricsAsync();
        }
        catch { }
    }

    private async Task LoadTrends()
    {
        try
        {
            Trends = await Api.GetTrendsAsync(TrendDays);
        }
        catch { }
    }

    private async Task SetTrendDays(int days)
    {
        TrendDays = days;
        await LoadTrends();
        await RenderChart(); // 切换天数时 Canvas 已绑定，立即重绘
    }

    private async Task RenderChart()
    {
        if (Trends == null || !Trends.Any()) return;
        // drawTrendChart 期望 [{date, amount}]；显式 camelCase 匿名对象避免序列化策略差异。
        var payload = Trends.Select(t => new { date = t.Date, amount = (double)t.Amount }).ToArray();

        try
        {
            await JS.InvokeVoidAsync("drawTrendChart", ChartCanvas, payload);
        }
        catch { }
    }



    private string IsEnabled(bool? val) => val == true ? "tag tag-success" : "tag tag-secondary";

    private string CircuitBadge(string state) => state.ToLower() switch
    {
        "closed" => "success",
        "open" => "danger",
        "halfopen" => "warning",
        _ => "secondary"
    };

    private string CircuitText(string state) => state.ToLower() switch
    {
        "closed" => "正常 (Closed)",
        "open" => "熔断 (Open)",
        "halfopen" => "探测 (HalfOpen)",
        _ => state
    };

    private static string Truncate(string val, int maxLen)
    {
        if (string.IsNullOrEmpty(val)) return "-";
        return val.Length <= maxLen ? val : val[..maxLen] + "...";
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _timer?.Dispose();
    }
}
