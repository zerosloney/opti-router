@namespace OptiRouter.Components.Shared

<svg class="app-icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="@Style">
    @switch (Name.ToLowerInvariant())
    {
        case "overview":
            <!-- 仪表盘 / 大屏 (Dashboard) -->
            <rect width="7" height="9" x="3" y="3" rx="1" />
            <rect width="7" height="5" x="14" y="3" rx="1" />
            <rect width="7" height="9" x="14" y="12" rx="1" />
            <rect width="7" height="5" x="3" y="16" rx="1" />
            break;

        case "requests":
            <!-- 请求链路 / 脉冲 (Activity) -->
            <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
            break;

        case "models":
            <!-- AI 模型 / 芯片 (Cpu) -->
            <rect width="16" height="16" x="4" y="4" rx="2" />
            <rect width="6" height="6" x="9" y="9" rx="1" />
            <path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3" />
            break;

        case "router":
            <!-- 智能路由 / 分支 (Route / GitFork) -->
            <circle cx="12" cy="18" r="3" />
            <circle cx="6" cy="6" r="3" />
            <circle cx="18" cy="6" r="3" />
            <path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9M12 12v3" />
            break;

        case "keys":
            <!-- 客户端密钥 (Key) -->
            <circle cx="7.5" cy="15.5" r="5.5" />
            <path d="m21 2-9.6 9.6M15.5 7.5l3 3M18.5 4.5l3 3" />
            break;

        case "benchmarks":
            <!-- 性能基准 / 闪电 (Zap) -->
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
            break;

        case "sun":
            <!-- 亮色主题 (Sun) -->
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            break;

        case "moon":
            <!-- 深色主题 (Moon) -->
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            break;

        case "logout":
            <!-- 退出登录 (LogOut) -->
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" x2="9" y1="12" y2="12" />
            break;

        case "user":
            <!-- 用户头像 (User) -->
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
            break;

        case "shield":
            <!-- 安全合规 (ShieldCheck) -->
            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
            <path d="m9 12 2 2 4-4" />
            break;

        case "copy":
            <!-- 复制 (Copy) -->
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
            break;

        case "check":
            <!-- 勾选 (Check) -->
            <polyline points="20 6 9 17 4 12" />
            break;

        case "alert":
            <!-- 警告 (AlertTriangle) -->
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
            <line x1="12" x2="12" y1="9" y2="13" />
            <line x1="12" x2="12.01" y1="17" y2="17" />
            break;

        case "search":
            <!-- 搜索 (Search) -->
            <circle cx="11" cy="11" r="8" />
            <line x1="21" x2="16.65" y1="21" y2="16.65" />
            break;

        case "download":
            <!-- 下载导出 (Download) -->
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" x2="12" y1="15" y2="3" />
            break;

        case "refresh":
            <!-- 刷新 (RotateCw) -->
            <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
            <path d="M3 3v5h5" />
            <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
            <path d="M16 21h5v-5" />
            break;

        case "plus":
            <!-- 添加 (Plus) -->
            <line x1="12" x2="12" y1="5" y2="19" />
            <line x1="5" x2="19" y1="12" y2="12" />
            break;

        case "trash":
            <!-- 删除 (Trash2) -->
            <path d="M3 6h18" />
            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
            <line x1="10" x2="10" y1="11" y2="17" />
            <line x1="14" x2="14" y1="11" y2="17" />
            break;

        case "edit":
            <!-- 编辑 (Pencil) -->
            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
            <path d="m15 5 4 4" />
            break;

        case "lock":
            <!-- 锁定 (Lock) -->
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            break;

        case "arrow-right":
            <!-- 箭头向右 (ArrowRight) -->
            <line x1="5" x2="19" y1="12" y2="12" />
            <polyline points="12 5 19 12 12 19" />
            break;

        default:
            <!-- 默认微型圆点 -->
            <circle cx="12" cy="12" r="4" />
            break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
    [Parameter] public double StrokeWidth { get; set; } = 1.75;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
}
