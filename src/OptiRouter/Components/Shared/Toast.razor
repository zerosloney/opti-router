@inject IJSRuntime JS

@if (Visible)
{
    <div class="toast-overlay" @onclick="Dismiss">
        <div class="toast-content @CssClass">
            <span>@Message</span>
            <button class="toast-close" @onclick="Dismiss">&times;</button>
        </div>
    </div>
}

@code {
    private bool Visible = false;
    private string? CssClass;
    private string? Message;
    private Timer? _timer;

    public void Show(string message, bool isError = false)
    {
        Message = message;
        CssClass = isError ? "toast-error" : "toast-success";
        Visible = true;
        StateHasChanged();

        _timer?.Dispose();
        _timer = new Timer(_ =>
        {
            InvokeAsync(() => { Visible = false; StateHasChanged(); });
        }, null, 3000, Timeout.Infinite);
    }

    private void Dismiss()
    {
        Visible = false;
        _timer?.Dispose();
    }
}
