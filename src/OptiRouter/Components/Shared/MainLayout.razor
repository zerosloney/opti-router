@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="app-shell">
    <aside class="side-nav">
        <div class="logo-area">
            <div class="logo-icon">&#931;</div>
            <div class="logo-title">OptiRouter</div>
            <div class="logo-sub">OBSERVABILITY</div>
        </div>
        <nav class="side-nav-links">
            <NavLink href="/overview" class="side-nav-link" ActiveClass="side-nav-link-active" Match="NavLinkMatch.Prefix">
                <span class="nav-icon">◎</span> 总览 <span class="nav-en">Overview</span>
            </NavLink>
            <NavLink href="/requests" class="side-nav-link" ActiveClass="side-nav-link-active" Match="NavLinkMatch.Prefix">
                <span class="nav-icon">⇄</span> 请求 <span class="nav-en">Requests</span>
            </NavLink>
            <NavLink href="/models" class="side-nav-link" ActiveClass="side-nav-link-active" Match="NavLinkMatch.Prefix">
                <span class="nav-icon">▤</span> 模型 <span class="nav-en">Models</span>
            </NavLink>
            <NavLink href="/router" class="side-nav-link" ActiveClass="side-nav-link-active" Match="NavLinkMatch.Prefix">
                <span class="nav-icon">⛭</span> 路由 <span class="nav-en">Router</span>
            </NavLink>
            <NavLink href="/keys" class="side-nav-link" ActiveClass="side-nav-link-active" Match="NavLinkMatch.Prefix">
                <span class="nav-icon">🔑</span> 客户端 <span class="nav-en">Keys</span>
            </NavLink>
            <NavLink href="/benchmarks" class="side-nav-link" ActiveClass="side-nav-link-active" Match="NavLinkMatch.Prefix">
                <span class="nav-icon">⚡</span> 压测 &amp; 生态 <span class="nav-en">Benchmark &amp; Mesh</span>
            </NavLink>
        </nav>
        <div class="side-nav-footer">
            <button class="theme-toggle" @onclick="ToggleTheme" title="@(IsLightTheme ? "切换到深色主题" : "切换到浅色主题")">
                <span class="theme-toggle-icon">@(IsLightTheme ? "🌙" : "☀")</span>
                <span>@(IsLightTheme ? "切换深色" : "切换浅色")</span>
            </button>
            <div class="side-nav-user">管理员</div>
            <a href="/logout" class="side-nav-logout">退出登录</a>
        </div>
    </aside>

    <main class="app-main">
        @Body
    </main>
</div>

@code {
    private bool IsLightTheme;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            IsLightTheme = await JS.InvokeAsync<string>("getTheme") == "light";
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        var theme = await JS.InvokeAsync<string>("toggleTheme");
        IsLightTheme = theme == "light";
    }
}
