{
  // 部署环境（Windows 服务，默认 Production）：配置 OptiRouter:ConfigDbConnectionString 一处，
  // 全部存储（配置库 + 租户 Key + 成本账本/审计/学习状态）即走 MariaDB——StoreProvider 默认 Auto，
  // 无需再配置开关；urls 仅在此钉死（5080），本地开发端口由 launchSettings.json 提供（5157）——
  // 基础 appsettings.json 里的 urls 键优先级高于 ASPNETCORE_URLS，放基础文件会与开发端口冲突。
  // 本地开发（dotnet run / F5）经 launchSettings.json 的同键环境变量注入，同样走 MariaDB；
  // 均未配置连接时回退 SQLite 文件。集成测试宿主不读 launchSettings，天然隔离。
  "urls": "http://localhost:5080",
  "OptiRouter": {
    "ConfigDbConnectionString": "Server=127.0.0.1;Port=3306;Database=test;User ID=root;Password=dc123456;Connection Timeout=15;Default Command Timeout=30"
  }
}
