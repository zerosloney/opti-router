@page "/login"
@model OptiRouter.Pages.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="zh">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OptiRouter - 管理员登录</title>
    <link rel="stylesheet" href="~/css/blazor.css" asp-append-version="true">
    <script>
        (function () { var s = null; try { s = localStorage.getItem('optirouter-theme'); } catch (e) { } document.documentElement.setAttribute('data-theme', s === 'dark' ? 'dark' : 'light'); })();
    </script>
</head>
<body>
    <div class="login-page">
        <div class="login-glow login-glow-a"></div>
        <div class="login-glow login-glow-b"></div>

        <div class="login-card">
            <div class="login-brand">
                <div class="logo-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="4 4 20 4 12 12 20 20 4 20 10 12 4 4" />
                    </svg>
                </div>
                <div class="login-title">OptiRouter</div>
                <div class="login-sub">管理控制台 · 管理员登录</div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="login-error">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
                        <line x1="12" y1="9" x2="12" y2="13" />
                        <line x1="12" y1="17" x2="12.01" y2="17" />
                    </svg>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <div class="login-secure">
                <span class="login-secure-dot"></span> 安全受信访问通道
            </div>

            <form method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="login-field">
                    <label for="AdminKey">管理密钥</label>
                    <div class="login-input-wrap">
                        <span class="login-input-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            </svg>
                        </span>
                        <input id="AdminKey" type="password" asp-for="AdminKey" placeholder="请输入管理员密钥 (Admin Key)" autofocus autocomplete="current-password" />
                    </div>
                </div>
                <button type="submit" class="login-submit">
                    <span class="login-submit-text">登 录</span>
                    <span class="login-submit-arrow">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12" />
                            <polyline points="12 5 19 12 12 19" />
                        </svg>
                    </span>
                </button>
            </form>

            <div class="login-foot">仅系统管理员授权访问 · 会话有效期 8 小时</div>
        </div>
    </div>
</body>
</html>
