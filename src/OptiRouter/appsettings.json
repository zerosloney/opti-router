{
  "OptiRouter": {
    // 管理密钥已迁移配置库（security scope，SHA256 哈希）：首次启动时本文件/环境变量的
    // OptiRouter:AdminApiKey 作为种子哈希入库后即被忽略；两者皆缺则生成随机密钥并打印启动日志一次。
    // 全局 ProxyApiKey 已移除：所有 /v1 客户端改用租户 key（管理台 Keys 页创建）。
    "AdminCookieRequireHttps": false,
    "RequestsPerMinute": 60,
    "TrustProxyHeaders": false
    // 存储后端：配置 OptiRouter:ConfigDbConnectionString 一处连接，全部存储
    // （配置库/租户 Key + Budget 账本/审计/学习状态，StoreProvider 默认 Auto）即走 MariaDB；
    // 未配置连接时回退 SQLite 文件。生产环境配置在 appsettings.Production.json，
    // 本地开发（dotnet run/F5）由 launchSettings.json 注入同键环境变量。
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },  },
  "AllowedHosts": "*"
}
