<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="WireMock.Net" Version="2.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OptiRouter\OptiRouter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试需要读取仓库源文件（README/RouterStudio/appsettings 一致性断言与 legacy 播种）。
         统一复制到输出目录后从 BaseDirectory 读取，不向上遍历目录树（发布/CI 布局下会脆断）。 -->
    <None Include="..\..\README.md" Link="RepositoryFiles\README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\OptiRouter\Components\Pages\Router\RouterStudio.razor" Link="RepositoryFiles\RouterStudio.razor" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\OptiRouter\appsettings.json" Link="RepositoryFiles\appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
